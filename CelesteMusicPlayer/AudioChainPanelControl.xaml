<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CelesteMusicPlayer.AudioChainPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 音频链路面板（B 组 B3，2026-10-16）。
         形态：从窗口右缘滑出的抽屉，风格对齐左侧分类栏卡片（同一批令牌：
         CardBackgroundFillColorDefaultBrush / CardStrokeColorDefaultBrush / 圆角 / ThemeShadow）。
         内容自下而上分五段：标题行 / 摘要行 / 实时电平 / 纵向链路图 / 可折叠分组。

         ⚠️「显示不出来就不显示」铁律（2026-10-16 用户明确修订）：
         拿不到的数据**整行不出** —— 不写"未知"、不写"—"、不留空占位、不做灰显。
         落地方式：每个可缺数据的行都带独立 Visibility，由 code-behind 按模型算好
         （见 ChainNodeVm 的 FormatVisibility / NoteVisibility / LatencyVisibility）。 -->
    <UserControl.Resources>
        <!-- 链路节点小卡：一张卡 = 链路一个环节（解码 / 缓存 / 无缝 / 降混 / 变速 / DSP×N / 输出） -->
        <DataTemplate x:Key="ChainNodeTemplate" x:DataType="local:ChainNodeVm">
            <Border
                CornerRadius="8"
                Padding="10,8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="3">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind Title}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Grid.Column="1"
                            Visibility="{x:Bind StateVisibility}"
                            CornerRadius="8"
                            Padding="6,1"
                            Background="{x:Bind StateBrush}">
                            <TextBlock Text="{x:Bind StateText}" FontSize="10" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Text="{x:Bind FormatText}"
                        Visibility="{x:Bind FormatVisibility}"
                        FontFamily="Consolas"
                        FontSize="11"
                        Opacity="0.85"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind NoteText}"
                        Visibility="{x:Bind NoteVisibility}"
                        FontSize="11"
                        Opacity="0.8"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind LatencyText}"
                        Visibility="{x:Bind LatencyVisibility}"
                        FontSize="11"
                        Opacity="0.7"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 输出事件时间线一行 -->
        <DataTemplate x:Key="ChainEventTemplate" x:DataType="local:ChainEventVm">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{x:Bind TimeText}"
                    FontFamily="Consolas"
                    FontSize="11"
                    Opacity="0.6"
                    VerticalAlignment="Top" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Text}"
                    FontSize="11"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border
        x:Name="PanelCard"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,1"
        CornerRadius="8,0,0,8"
        Margin="0,4,0,4">
        <Grid Padding="16,14,12,14" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ① 标题行：「音频链路」+ bit-perfect 徽标 + 关闭 -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="音频链路"
                    FontSize="15"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <Border
                    x:Name="VerdictBadge"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    CornerRadius="9"
                    Padding="8,2"
                    Margin="2,0,0,0">
                    <TextBlock x:Name="VerdictBadgeText" FontSize="11" />
                </Border>
                <Button
                    x:Name="CloseButton"
                    Grid.Column="2"
                    Width="30"
                    Height="30"
                    Padding="0"
                    CornerRadius="15"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="关闭"
                    Click="CloseButton_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <!-- ② 摘要行：源格式 → 输出格式 + 结论 -->
            <TextBlock
                x:Name="SummaryText"
                Grid.Row="1"
                FontSize="12"
                Opacity="0.85"
                TextWrapping="Wrap" />

            <!-- ③ 实时电平（post-DSP）。无信号可测时整块收起，不摆空条 -->
            <StackPanel x:Name="LevelsRoot" Grid.Row="2" Spacing="3" />

            <!-- ④ 纵向链路图（核心，可滚动） -->
            <ScrollViewer
                Grid.Row="3"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="ChainList" ItemTemplate="{StaticResource ChainNodeTemplate}" />
                    <TextBlock
                        x:Name="ChainEmptyHint"
                        Visibility="Collapsed"
                        FontSize="12"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Text="还没开始播放，链路节点待建立。" />
                </StackPanel>
            </ScrollViewer>

            <!-- ⑤ 可折叠分组：链路诊断 / 输出事件时间线（默认收起，状态不持久化） -->
            <StackPanel Grid.Row="4" Spacing="4">
                <StackPanel x:Name="DiagGroup">
                    <Button
                        x:Name="DiagToggle"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="0,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="DiagToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="DiagChevron" Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="链路诊断" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="DiagText"
                        Visibility="Collapsed"
                        Margin="16,2,0,4"
                        FontSize="11"
                        Opacity="0.85"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="EventsGroup">
                    <Button
                        x:Name="EventsToggle"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="0,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="EventsToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="EventsChevron" Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="输出事件时间线" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ScrollViewer
                        x:Name="EventsScroll"
                        Visibility="Collapsed"
                        MaxHeight="180"
                        Margin="16,2,0,4"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="EventsList" ItemTemplate="{StaticResource ChainEventTemplate}" />
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
