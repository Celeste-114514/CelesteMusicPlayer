<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="迷你播放器">

    <!-- 背景透明，让 Window.SystemBackdrop（Desktop Acrylic）透出壁纸毛玻璃 -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerPressed="RootGrid_PointerPressed"
        PointerMoved="RootGrid_PointerMoved"
        PointerReleased="RootGrid_PointerReleased"
        PointerCaptureLost="RootGrid_PointerCaptureLost">
        <Border
            x:Name="ChromeBorder"
            Margin="0"
            CornerRadius="16"
            BorderThickness="0"
            Padding="14,10,14,8"
            Background="Transparent">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="68"
                        Height="68"
                        CornerRadius="6"
                        Background="#28FFFFFF">
                        <Grid>
                            <FontIcon
                                Glyph="&#xE93C;"
                                FontSize="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.4" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="TitleText"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="White"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Text="未在播放" />
                        <TextBlock
                            x:Name="ArtistText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Text="" />
                        <Canvas x:Name="LyricCanvas" Height="18">
                            <TextBlock
                                x:Name="LyricText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="" />
                        </Canvas>
                        <TextBlock
                            x:Name="StatusText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="已暂停" />
                    </StackPanel>

                    <Button
                        x:Name="SettingsButton"
                        Grid.Column="2"
                        Width="34"
                        Height="34"
                        Padding="0"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="White" />
                    </Button>
                    <Button
                        x:Name="CloseMiniButton"
                        Grid.Column="2"
                        Width="34"
                        Height="34"
                        Margin="0,38,0,0"
                        Padding="0"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseMiniButton_Click"
                        ToolTipService.ToolTip="关闭迷你播放器">
                        <FontIcon Glyph="&#xE8BB;" FontSize="15" Foreground="White" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8" MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CurrentTimeText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="00:00" />
                    <Slider
                        x:Name="ProgressSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        VerticalAlignment="Center"
                        ValueChanged="ProgressSlider_ValueChanged" />
                    <TextBlock
                        x:Name="TotalTimeText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="00:00" />
                </Grid>

                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="4">
                    <Button
                        x:Name="PlaybackOrderButton"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PlaybackOrderButton_Click"
                        ToolTipService.ToolTip="播放模式">
                        <FontIcon x:Name="PlaybackOrderIcon" Glyph="&#xE8EE;" FontSize="15" Foreground="White" />
                    </Button>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PreviousButton_Click"
                        ToolTipService.ToolTip="上一首">
                        <FontIcon Glyph="&#xE892;" FontSize="16" Foreground="White" />
                    </Button>
                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PlayPauseButton_Click"
                        ToolTipService.ToolTip="播放 / 暂停">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18" Foreground="White" />
                    </Button>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NextButton_Click"
                        ToolTipService.ToolTip="下一首">
                        <FontIcon Glyph="&#xE893;" FontSize="16" Foreground="White" />
                    </Button>
                    <Button
                        Width="36"
                        Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="VolumeButton_Click"
                        ToolTipService.ToolTip="音量">
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="15" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 盖住系统丙烯酸最外圈细白线 -->
        <Border
            x:Name="EdgeMaskBorder"
            IsHitTestVisible="False"
            CornerRadius="16"
            BorderThickness="1.5"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="Transparent" />
    </Grid>
</Window>
