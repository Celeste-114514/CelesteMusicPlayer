<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.MiniPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="迷你播放器">

    <!--
        设计参照 deskbox / Spotify mini-card：厚实一点的浮空卡片，圆角大、阴影明显。

        高度算法（新版，更厚实）：
          上内边距 12 + 主体 92 + 下内边距 11 ≈ 115 ≈ 实际 120（含 Slider 占位）
        主体 92 = 封面 80 (居左) + 右侧两行：
          标题行 56（歌名 16 + 副标题 13 + 传输按钮：上/下 32、播放圆 44、音/队列/关 30）
          进度行 36（CurrentTime 12 / 进度条 / TotalTime 12）

        宽度 560 = 封面 80 + 间隔 14 + 右侧弹性 + padding 14*2 = 余 ~448 给"歌名+按钮"
    -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerPressed="RootGrid_PointerPressed"
        PointerMoved="RootGrid_PointerMoved"
        PointerReleased="RootGrid_PointerReleased"
        PointerCaptureLost="RootGrid_PointerCaptureLost">

        <Border
            x:Name="ChromeBorder"
            CornerRadius="20"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Padding="14,12,14,11"
            Background="Transparent">
            <!-- RowSpacing 必须留 0：Grid 的行间距在"第二行高度=0"时照样占 6px，
                 会把收起态从 120 撑到 126。队列和上方的间隔改用 QueuePanel 自己的上内边距。 -->
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============ 主体行：封面 + （标题行 / 进度行） ============ -->
                <Grid ColumnSpacing="14" Height="92">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 封面 -->
                    <Border
                        x:Name="CoverBorder"
                        Width="80"
                        Height="80"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <FontIcon
                                x:Name="CoverPlaceholder"
                                Glyph="&#xE93C;"
                                FontSize="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.45" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- 右侧两行 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>

                        <!-- 标题行 -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="TitleText"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    Text="未在播放" />
                                <TextBlock
                                    x:Name="ArtistText"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis"
                                    Text="" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">

                                <Button
                                    x:Name="PreviousButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="PreviousButton_Click"
                                    ToolTipService.ToolTip="上一首">
                                    <FontIcon Glyph="&#xE892;" FontSize="15" />
                                </Button>

                                <!-- 播放/暂停：强调色实心圆，整条里视觉最重的元素 -->
                                <Button
                                    x:Name="PlayPauseButton"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    CornerRadius="22"
                                    BorderThickness="0"
                                    Click="PlayPauseButton_Click"
                                    ToolTipService.ToolTip="播放 / 暂停">
                                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="19" />
                                </Button>

                                <Button
                                    x:Name="NextButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="16"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="NextButton_Click"
                                    ToolTipService.ToolTip="下一首">
                                    <FontIcon Glyph="&#xE893;" FontSize="15" />
                                </Button>

                                <!-- 音量：Flyout 里放滑条 -->
                                <Button
                                    x:Name="VolumeButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="15"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="音量">
                                    <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="15" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Width="210" Spacing="6">
                                                <TextBlock
                                                    Text="音量"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        x:Name="VolumeFlyoutIcon"
                                                        Glyph="&#xE767;"
                                                        FontSize="15"
                                                        VerticalAlignment="Center" />
                                                    <Slider
                                                        x:Name="VolumeSlider"
                                                        Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        StepFrequency="1"
                                                        ValueChanged="VolumeSlider_ValueChanged" />
                                                </Grid>
                                                <TextBlock
                                                    x:Name="VolumeValueText"
                                                    Text="100%"
                                                    FontSize="12"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- 播放队列 -->
                                <Button
                                    x:Name="QueueButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="15"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="QueueButton_Click"
                                    ToolTipService.ToolTip="播放队列">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="15" />
                                </Button>

                                <Button
                                    x:Name="CloseMiniButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="15"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="CloseMiniButton_Click"
                                    ToolTipService.ToolTip="关闭迷你播放器">
                                    <FontIcon Glyph="&#xE8BB;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 进度行 -->
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="CurrentTimeText"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="00:00" />
                            <Slider
                                x:Name="ProgressSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                VerticalAlignment="Center"
                                ValueChanged="ProgressSlider_ValueChanged" />
                            <TextBlock
                                x:Name="TotalTimeText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="00:00" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ============ 播放队列（点队列按钮展开，不额外占收起态高度） ============ -->
                <Border
                    x:Name="QueuePanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Padding="0,10,0,0"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView
                        x:Name="QueueList"
                        SelectionMode="Single"
                        SelectionChanged="QueueList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="MinHeight" Value="34" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <!-- 当前曲目不用额外图标标记（DataTemplate 内的元素在后台代码里拿不到名字，
                                 要靠 VisualTreeHelper 找，脆弱又啰嗦），直接靠 ListView 的
                                 选中高亮 = 正在播那首，简单可靠。 -->
                            <DataTemplate>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding Title}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Border>

        <!-- 整条的最外圈描边（盖住亚克力外溢） -->
        <Border
            x:Name="EdgeMaskBorder"
            IsHitTestVisible="False"
            CornerRadius="20"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="Transparent" />
    </Grid>
</Window>
