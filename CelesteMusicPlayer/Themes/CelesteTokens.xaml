<!--
  主题令牌 · 基线字典（第 2 步 · 令牌化）

  为什么需要这份"写死在 XAML 里"的字典，而不是全靠运行时挂：
    运行时挂令牌发生在 MainWindow_Loaded，而 XAML 在那之前就已渲染。
    那一两帧里 {ThemeResource Celeste.*} 查不到键 → 控件没背景 → 会闪一下。
    所以这里先铺一份基线值，运行时再把真主题字典 MergedDictionaries 到后面（后者优先，覆盖前者）。

  ⚠ 三条硬约束（都是踩出来的）：
   1. 本文件必须声明为 <ResourceDictionary> 项、且从 Page 里 Remove 掉。
      SDK 默认 glob 会把 *.xaml 当 XamlPage 收进去，Page 要求有 x:Class，
      XamlCompiler 读它时抛 AccessViolationException —— 构建只报「XamlCompiler 退出码 1」、
      零错误信息、output.json 都不生成。已在 csproj 里显式声明。
   2. 数值令牌只能用 x:Double，**不能用 x:String**（XAML 编译器不认，会同样静默崩）。
   3. 字符串类令牌（字体名等）不要放进这份基线字典，交给运行时 C# 侧建。

  ⚠ 本文件绝不能合并进 Application.Resources：窗口渲染后改全局资源键会触发
     WinUI 原生崩溃 0xc000027b，托管 try-catch 拦不住。只挂元素级。

  值来自 CelesteTokenCatalog 的 DefaultLight / DefaultDark。改颜色要改两处：
  这里 + CelesteMusicPlayer/CelesteTheme.cs 的令牌目录。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============ 浅色（对应系统浅色） ============ -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="Celeste.App.Background" Color="#f3f3f3" />
            <SolidColorBrush x:Key="Celeste.Panel.Background" Color="#fcfcfc" />
            <SolidColorBrush x:Key="Celeste.Card.Background" Color="#ffffff" />
            <SolidColorBrush x:Key="Celeste.Card.BackgroundHover" Color="#f6f6f6" />
            <SolidColorBrush x:Key="Celeste.Card.Stroke" Color="#e5e5e5" />
            <SolidColorBrush x:Key="Celeste.Divider" Color="#e0e0e0" />
            <SolidColorBrush x:Key="Celeste.Text.Primary" Color="#1a1a1a" />
            <SolidColorBrush x:Key="Celeste.Text.Secondary" Color="#5c5c5c" />
            <SolidColorBrush x:Key="Celeste.Text.Disabled" Color="#a0a0a0" />
            <SolidColorBrush x:Key="Celeste.Accent.Solid" Color="#0067c0" />
            <SolidColorBrush x:Key="Celeste.Accent.Text" Color="#ffffff" />
            <SolidColorBrush x:Key="Celeste.Input.Background" Color="#ffffff" />
            <SolidColorBrush x:Key="Celeste.Input.Stroke" Color="#d0d0d0" />
            <SolidColorBrush x:Key="Celeste.Overlay.Background" Color="#ffffff" />
            <SolidColorBrush x:Key="Celeste.Selection.Background" Color="#e5f1fb" />

            <!-- 圆角 / 间距：必须是数值类型，赋给 CornerRadius/Margin 时 XAML 直接转 double -->
            <x:Double x:Key="Celeste.Radius.Small">4</x:Double>
            <x:Double x:Key="Celeste.Radius.Medium">8</x:Double>
            <x:Double x:Key="Celeste.Radius.Large">12</x:Double>
            <x:Double x:Key="Celeste.Radius.Control">4</x:Double>
            <x:Double x:Key="Celeste.Radius.Cover">14</x:Double>
            <x:Double x:Key="Celeste.Space.Tight">4</x:Double>
            <x:Double x:Key="Celeste.Space.Normal">12</x:Double>
            <x:Double x:Key="Celeste.Space.Loose">24</x:Double>

            <!-- 材质 -->
            <x:Double x:Key="Celeste.Blur.Panel">0</x:Double>
            <x:Double x:Key="Celeste.Cover.Shadow">0</x:Double>
        </ResourceDictionary>

        <!-- ============ 深色（对应系统深色） ============ -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="Celeste.App.Background" Color="#101216" />
            <SolidColorBrush x:Key="Celeste.Panel.Background" Color="#181b22" />
            <SolidColorBrush x:Key="Celeste.Card.Background" Color="#1e222b" />
            <SolidColorBrush x:Key="Celeste.Card.BackgroundHover" Color="#262b36" />
            <SolidColorBrush x:Key="Celeste.Card.Stroke" Color="#2b303b" />
            <SolidColorBrush x:Key="Celeste.Divider" Color="#2b303b" />
            <SolidColorBrush x:Key="Celeste.Text.Primary" Color="#e7e9ef" />
            <SolidColorBrush x:Key="Celeste.Text.Secondary" Color="#a8b0c0" />
            <SolidColorBrush x:Key="Celeste.Text.Disabled" Color="#6b7280" />
            <SolidColorBrush x:Key="Celeste.Accent.Solid" Color="#f0b429" />
            <SolidColorBrush x:Key="Celeste.Accent.Text" Color="#101216" />
            <SolidColorBrush x:Key="Celeste.Input.Background" Color="#151920" />
            <SolidColorBrush x:Key="Celeste.Input.Stroke" Color="#333a46" />
            <SolidColorBrush x:Key="Celeste.Overlay.Background" Color="#1a1e26" />
            <SolidColorBrush x:Key="Celeste.Selection.Background" Color="#2a3648" />

            <x:Double x:Key="Celeste.Radius.Small">4</x:Double>
            <x:Double x:Key="Celeste.Radius.Medium">8</x:Double>
            <x:Double x:Key="Celeste.Radius.Large">12</x:Double>
            <x:Double x:Key="Celeste.Radius.Control">4</x:Double>
            <x:Double x:Key="Celeste.Radius.Cover">14</x:Double>
            <x:Double x:Key="Celeste.Space.Tight">4</x:Double>
            <x:Double x:Key="Celeste.Space.Normal">12</x:Double>
            <x:Double x:Key="Celeste.Space.Loose">24</x:Double>

            <x:Double x:Key="Celeste.Blur.Panel">0</x:Double>
            <x:Double x:Key="Celeste.Cover.Shadow">12</x:Double>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
