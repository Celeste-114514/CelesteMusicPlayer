<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.TagSortFieldConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="分类字段配置">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏（与设置面板一致：左侧图标+标题，右侧留给窗口控制按钮） -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                <TextBlock Text="分类字段配置" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 内容：说明 + 左右两栏卡片（并排，缩短纵向、加宽横向） -->
        <Grid Grid.Row="1" Margin="16,10,16,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="勾选要出现在顶部「分类」按钮组的字段（按勾选顺序排列）。取消勾选即从按钮组移除，不影响曲库数据。"
                TextWrapping="WrapWholeWords"
                Opacity="0.7"
                FontSize="13"
                Margin="0,0,0,10" />

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：可用字段勾选 -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Text="可用字段"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8" />
                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <StackPanel x:Name="MetaChecks" Spacing="4" />
                                <StackPanel x:Name="TechChecks" Spacing="4" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 右：按钮顺序 -->
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Text="按钮顺序（上移 / 下移）"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8" />
                        <ScrollViewer
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="OrderPanel" Spacing="6" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部操作（主按钮用强调色，与设置面板一致） -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="10"
            HorizontalAlignment="Right"
            Padding="16,10">
            <Button Content="恢复默认" Padding="14,6" Click="ResetButton_Click" />
            <Button x:Name="CancelButton" Content="取消" Padding="18,6" Click="CancelButton_Click" />
            <Button x:Name="ApplyButton" Content="应用" Padding="18,6" Click="ApplyButton_Click" Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
