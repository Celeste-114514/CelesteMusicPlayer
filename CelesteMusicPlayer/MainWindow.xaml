<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CelesteMusicPlayer">
    <!-- SystemBackdrop 改到首次 Activated 后代码设置，避免解压/非 VS 启动时 Mica 过早初始化导致 0xC000027B -->

    <Grid x:Name="RootShell">
        <Grid.Resources>
            <Style x:Key="CompactListItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="ComfortableListItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>
        <!-- MusicPlayer2 风格：专辑封面放大 + 强模糊作为整窗背景 -->
        <Image
            x:Name="AlbumArtBackgroundImage"
            Stretch="UniformToFill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False" />
        <Border
            x:Name="AlbumArtBackgroundScrim"
            Background="#88101820"
            IsHitTestVisible="False"
            Opacity="0" />
        <!-- 自定义背景图片(设置里选择,优先于封面背景)：放在封面背景之上，
             两者互斥显示（见 ApplyCustomBackground / ApplyAlbumArtBackgroundAsync） -->
        <Image
            x:Name="CustomBackgroundImage"
            Stretch="UniformToFill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
        <!-- 自定义背景视频(设置里选,与图片互斥)：循环、静音、无控制条铺满 -->
        <MediaPlayerElement
            x:Name="CustomBackgroundVideo"
            Stretch="UniformToFill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutoPlay="False"
            IsHitTestVisible="False"
            AreTransportControlsEnabled="False"
            Visibility="Collapsed" />

        <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <!-- 与系统标题栏（最小化/最大化/关闭）合并的自定义栏 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaPlayerElement
            x:Name="PlayerElement"
            Grid.Row="0"
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Opacity="0"
            IsHitTestVisible="False"
            AreTransportControlsEnabled="False" />

        <!-- 整条标题栏可拖动；右侧留白给系统最小化/最大化/关闭 -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="12,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Padding="4,0,8,0">
                <!-- 左上角应用图标：简笔「圆圈 + 音符」。
                     原来是蓝色的 AppIcon.png，和界面色调不搭；改成矢量线稿并跟随主题前景色，
                     深色/浅色都会自动反色。只改主程序左上角这一处，不动任务栏/托盘图标。 -->
                <Viewbox
                    x:Name="AppTitleBarIcon"
                    Width="20"
                    Height="20"
                    Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <!-- 外圈 -->
                        <Ellipse
                            Canvas.Left="1"
                            Canvas.Top="1"
                            Width="22"
                            Height="22"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1.5" />
                        <!-- 符头（微倾的实心椭圆） -->
                        <Path Fill="{ThemeResource TextFillColorPrimaryBrush}">
                            <Path.Data>
                                <EllipseGeometry Center="9,16" RadiusX="3.2" RadiusY="2.4">
                                    <EllipseGeometry.Transform>
                                        <RotateTransform Angle="-20" CenterX="9" CenterY="16" />
                                    </EllipseGeometry.Transform>
                                </EllipseGeometry>
                            </Path.Data>
                        </Path>
                        <!-- 符干 -->
                        <Line
                            X1="12.1"
                            Y1="15.8"
                            X2="12.1"
                            Y2="6.6"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1.5" />
                        <!-- 符尾 -->
                        <Path
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1.5"
                            StrokeLineJoin="Round">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="12.1,6.6">
                                        <BezierSegment Point1="14.8,7.2" Point2="16.1,8.9" Point3="15.2,11" />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Canvas>
                </Viewbox>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Opacity="0.9"
                    Text="CelesteMusicPlayer" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Margin="4,0,12,0">
                <TextBlock
                    x:Name="NowPlayingText"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="尚未选择音频" />
                <TextBlock
                    x:Name="GeekOutputReadout"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="11"
                    Opacity="0.8"
                    Visibility="Collapsed"
                    Text="" />
            </StackPanel>

            <!-- 标题栏右上角：功能按钮（选择/刷新/全屏）+ 自绘系统按钮（靠紧）-->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
                <Button
                    x:Name="AudioSettingsButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="AudioSettingsButton_Click"
                    ToolTipService.ToolTip="音频设置">
                    <FontIcon Glyph="&#xE91F;" FontSize="15" />
                </Button>
                <Button
                    x:Name="SelectLocalAudioButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SelectLocalAudioButton_Click"
                    ToolTipService.ToolTip="选项">
                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                </Button>
                <Button
                    x:Name="RefreshCurrentPageButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="RefreshCurrentPageButton_Click"
                    ToolTipService.ToolTip="刷新当前页面">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>
                <Button
                    x:Name="FullScreenButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="FullScreenButton_Click"
                    ToolTipService.ToolTip="全屏">
                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="15" />
                </Button>
                <Border
                    Width="1"
                    Height="20"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <!-- 自绘系统按钮（无边框窗口） -->
                <Button
                    x:Name="WindowMinButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="WindowMinButton_Click"
                    ToolTipService.ToolTip="最小化">
                    <FontIcon Glyph="&#xE921;" FontSize="15" />
                </Button>
                <Button
                    x:Name="WindowMaxRestoreButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="WindowMaxRestoreButton_Click"
                    ToolTipService.ToolTip="最大化 / 还原">
                    <FontIcon x:Name="WindowMaxRestoreIcon" Glyph="&#xE922;" FontSize="13" />
                </Button>
                <Button
                    x:Name="WindowCloseButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="WindowCloseButton_Click"
                    ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                </Button>
            </StackPanel>

        </Grid>

        <!-- 中部：分类 | 播放列表（右侧信息面板已停用，播放列表区扩张到底） -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="16,8,16,0" Tapped="MainContentGrid_Tapped">
            <Grid.Resources>
                <!-- 主内容区景深退后：切出播放信息面板时缩小变暗 -->
                <Storyboard x:Name="MainContentDepthBackStoryboard">
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryGrid" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryTransform" Storyboard.TargetProperty="ScaleX"
                                     To="0.9" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryTransform" Storyboard.TargetProperty="ScaleY"
                                     To="0.9" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneRoot" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneTransform" Storyboard.TargetProperty="ScaleX"
                                     To="0.9" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneTransform" Storyboard.TargetProperty="ScaleY"
                                     To="0.9" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <!-- 主内容区景深恢复 -->
                <Storyboard x:Name="MainContentDepthRestoreStoryboard">
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryGrid" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryTransform" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryTransform" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneRoot" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneTransform" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneTransform" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <!-- 音乐库 -->
                <ColumnDefinition x:Name="CategoryColumn" Width="156" MinWidth="148" MaxWidth="220" />
                <!-- 播放列表占剩余全部 -->
                <ColumnDefinition x:Name="PlaylistColumn" Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左：音乐库 + 播放列表入口（统一 Button 选中样式） -->
            <Grid
                x:Name="LeftCategoryGrid"
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="4"
                RowSpacing="4"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="LeftCategoryTransform" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Margin="8,6,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="LibraryNavTitleText"
                        Grid.Column="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.7"
                        VerticalAlignment="Center"
                        Text="音乐库" />
                    <!-- 音乐库面板的收起/展开按钮已按用户要求移除：面板固定展开，不再有窄栏图标模式。 -->
                </Grid>
                <!-- 音乐库导航：分类条目集中在一个可滚动面板里，音效 / 标签排序 / 播放列表固定在面板底部
                     （经典界面下与 Windows 设置同款：圆角灰底 + 左侧一根直竖条主题色指示条，切换带淡入动画）
                     ⚠️ 每个条目都是「Grid 包一层」：指示条必须画在按钮外面，画在按钮的左边框上会被
                     圆角裁成一段弧（用户反馈过"竖条是弧形"），别再改回 BorderThickness 方案。 -->
                <ScrollViewer
                    x:Name="CategoryNavScroll"
                    Grid.Row="1"
                    Padding="0"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Auto"
                    VerticalScrollBarVisibility="Hidden">
                    <StackPanel
                        x:Name="CategoryNavPanel"
                        Spacing="0">
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavSongsButton"
                                Tag="Songs"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="🎵" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="歌曲" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavSongsIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavAlbumsButton"
                                Tag="Albums"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE93C;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="💿" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="专辑" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavAlbumsIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavArtistsButton"
                                Tag="Artists"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="🎤" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="艺术家" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavArtistsIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavAlbumArtistsButton"
                                Tag="AlbumArtists"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE716;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="🎙️" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="专辑艺术家" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavAlbumArtistsIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavFavoritesButton"
                                Tag="Favorites"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEB51;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="❤️" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="我喜欢的音乐" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavFavoritesIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavRatingsButton"
                                Tag="Ratings"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8BF;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="⭐" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="评分" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavRatingsIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavRecentButton"
                                Tag="Recent"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE81C;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="🕒" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="最近播放" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavRecentIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavPlaylistWallButton"
                                Tag="UserPlaylist"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="NavPlaylistWallButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="📋" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="播放队列" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavPlaylistWallIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavGenreButton"
                                Tag="Genres"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="🎼" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="流派" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavGenreIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavYearButton"
                                Tag="Years"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE787;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="📅" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="年份" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavYearIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavMostPlayedButton"
                                Tag="MostPlayed"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="🔥" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="播放最多" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavMostPlayedIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Button
                                x:Name="NavFoldersButton"
                                Tag="Folders"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="📁" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="媒体库" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavFoldersIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <!-- 网络音乐库（WebDAV）：在「选项设置 → WebDAV」里配好之后才显示，
                             文字用设置里填的显示名（没填就用网址主机名）；在那里删掉配置后整个条目隐藏。
                             ⚠️ 隐藏必须连外层 Grid 一起（见 SetNavEntryVisibility 的注释），只藏 Button 会留 16px 空白。 -->
                        <Grid x:Name="NavWebDavEntry" Margin="0,0,0,3" Visibility="Collapsed">
                            <Button
                                x:Name="NavWebDavButton"
                                Tag="WebDav"
                                Padding="8,6"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CategoryNavButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Tag="NavEmoji" Text="☁️" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock Tag="NavLabel" Text="网络音乐库" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="NavWebDavIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部工具组：吸在左侧面板下方（用户要求），仅在经典界面显示上方那条分组线 -->
                <StackPanel
                    x:Name="NavToolPanel"
                    Grid.Row="2"
                    Margin="0,2,0,0">
                    <Border
                        x:Name="LibraryNavInnerDivider"
                        Height="1"
                        Margin="10,0,10,3"
                        Visibility="Collapsed"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Margin="0,0,0,3">
                        <Button
                            x:Name="NavAudioFxButton"
                            Tag="AudioFX"
                            Padding="8,6"
                            FontSize="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Click="NavAudioFxButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE91F;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Tag="NavEmoji" Text="🎚️" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock Tag="NavLabel" Text="音效处理" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="NavAudioFxIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Button
                            x:Name="NavTagSortButton"
                            Tag="TagSort"
                            Padding="8,6"
                            FontSize="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Click="NavTagSortButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="NavTagSortIcon"
                                    Glyph="&#xE8CB;"
                                    FontSize="16"
                                    VerticalAlignment="Center" />
                                <TextBlock Tag="NavEmoji" Text="🏷️" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock Tag="NavLabel" Text="标签排序" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="NavTagSortIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <Button
                            x:Name="UserPlaylistNavButton"
                            Tag="PlaylistWall"
                            Padding="8,6"
                            FontSize="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Click="UserPlaylistNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path
                                    x:Name="UserPlaylistNavIcon"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    Fill="Transparent"
                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                    StrokeThickness="1.4"
                                    Data="M3,3 L7,3 L7,7 L3,7 Z M9,3 L13,3 L13,7 L9,7 Z M3,9 L7,9 L7,13 L3,13 Z M9,9 L13,9 L13,13 L9,13 Z" />
                                <TextBlock Tag="NavEmoji" Text="📃" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock Tag="NavLabel" Text="播放列表" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="UserPlaylistNavIndicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="Transparent" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 音乐库面板与右侧内容区之间的分隔线已按用户要求移除 -->

        <!-- 中：歌曲列表 / 专辑浏览（侧键前进/后退） -->
            <Grid
                x:Name="LibraryPaneRoot"
                Grid.Column="1"
                RowSpacing="8"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="LibraryPaneTransform" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12" Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="LibraryPaneTitle"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="歌曲"
                            Visibility="Collapsed" />

                        <!-- 多选模式标题：返回 + 选择 + 全选 -->
                        <StackPanel
                            x:Name="MultiSelectTitlePanel"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Button
                                x:Name="ExitMultiSelectButton"
                                Width="36"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ExitMultiSelectButton_Click"
                                ToolTipService.ToolTip="退出多选">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            </Button>
                            <TextBlock
                                x:Name="MultiSelectTitleText"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="选择歌曲" />
                            <Button
                                x:Name="SelectAllMultiSelectButton"
                                Height="32"
                                Padding="10,0"
                                CornerRadius="8"
                                BorderThickness="0"
                                Click="SelectAllMultiSelectButton_Click"
                                ToolTipService.ToolTip="全选 / 取消全选">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="SelectAllMultiSelectIcon" Glyph="&#xE739;" FontSize="14" />
                                    <TextBlock Text="全选" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 歌曲 / 专辑 / 文件夹 搜索 -->
                    <Grid
                        x:Name="LibrarySearchPanel"
                        Grid.Column="1"
                        ColumnSpacing="8"
                        VerticalAlignment="Center"
                        Margin="24,0,0,0"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:StableIBeamTextBox
                            x:Name="LibrarySearchBox"
                            Grid.Column="0"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            PlaceholderText="搜索"
                            TextChanged="LibrarySearchBox_TextChanged" />
                        <StackPanel
                            x:Name="FolderSearchNavPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="FolderSearchCountText"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.85"
                                Text="0/0"
                                MinWidth="36"
                                TextAlignment="Center" />
                            <Button
                                x:Name="FolderSearchPrevButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="FolderSearchPrevButton_Click"
                                ToolTipService.ToolTip="上一个结果">
                                <FontIcon Glyph="&#xE70E;" FontSize="12" />
                            </Button>
                            <Button
                                x:Name="FolderSearchNextButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="FolderSearchNextButton_Click"
                                ToolTipService.ToolTip="下一个结果">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 歌曲库：字段+升/降序；播放列表：更改排序 -->
                    <StackPanel
                        x:Name="SongSortPanel"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="PlayAllLibrarySongsButton"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Click="PlayAllLibrarySongsButton_Click"
                            ToolTipService.ToolTip="把当前歌曲列表全部加入队列并按当前排序播放">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="PlayAllLibrarySongsText" Text="播放所有歌曲" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <DropDownButton
                            x:Name="SortFieldButton"
                            Height="32"
                            Padding="14,0"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="SortFieldText" Text="排序：标题" VerticalAlignment="Center" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="标题" Tag="Title" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="艺术家" Tag="Artist" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="专辑" Tag="Album" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="年份" Tag="Year" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="时长" Tag="Duration" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="流派" Tag="Genre" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="音轨号" Tag="Track" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="文件路径" Tag="FilePath" Click="SortFieldMenu_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            x:Name="SortOrderButton"
                            Height="32"
                            MinWidth="72"
                            Padding="14,0"
                            BorderThickness="0"
                            Click="SortOrderButton_Click"
                            ToolTipService.ToolTip="切换升序 / 降序">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="SortOrderText" Text="升序" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ChangeSortButton"
                            Height="32"
                            Padding="14,0"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="ChangeSortButton_Click"
                            ToolTipService.ToolTip="按字段重新排序当前列表（会打乱原有顺序）">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="更改排序"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 评分分类：6 类胶囊（未评分 + 1..5 星） -->
                    <StackPanel
                        x:Name="RatingFilterPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Button x:Name="RatingFilter0Button" Tag="0" Content="未评分" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter1Button" Tag="1" Content="★1" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter2Button" Tag="2" Content="★2" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter3Button" Tag="3" Content="★3" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter4Button" Tag="4" Content="★4" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter5Button" Tag="5" Content="★5" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                    </StackPanel>

                    <!-- 专辑墙排序：类别下拉 + 升序/降序（两个胶囊并列） -->
                    <StackPanel
                        x:Name="AlbumSortPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <DropDownButton
                            x:Name="AlbumSortButton"
                            Height="32"
                            Padding="14,0"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="按专辑名称"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,8" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="按专辑名称" Tag="Title" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按艺术家" Tag="Artist" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按发行年份" Tag="Year" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按添加时间" Tag="Added" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="随机" Tag="Random" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按专辑曲目数" Tag="TrackCount" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按专辑总时长" Tag="TotalDuration" Click="AlbumSortMenu_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            x:Name="AlbumSortOrderButton"
                            Height="32"
                            MinWidth="64"
                            Padding="14,0"
                            BorderThickness="0"
                            Click="AlbumSortOrderButton_Click"
                            ToolTipService.ToolTip="切换升序 / 降序">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="升序"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,8" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 播放列表墙（Poweramp 式）：命名单封面墙 -->
                <Border
                    x:Name="PlaylistWallBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            Grid.Row="0"
                            Padding="4,0,4,8"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="播放列表墙" />
                            <Button
                                x:Name="CreatePlaylistWallButton"
                                Grid.Column="1"
                                Height="32"
                                Padding="12,0"
                                CornerRadius="8"
                                Content="新建播放列表"
                                Click="CreatePlaylistWallButton_Click" />
                            <Button
                                x:Name="ExportPlaylistsButton"
                                Grid.Column="2"
                                Height="32"
                                Padding="12,0"
                                CornerRadius="8"
                                Content="导出为 m3u8"
                                Click="ExportPlaylistsButton_Click" />
                        </Grid>
                        <GridView
                        x:Name="PlaylistWallGridView"
                        Grid.Row="1"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="PlaylistWallGridView_ItemClick"
                        RightTapped="PlaylistWallGridView_RightTapped">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistCardViewModel">
                                <StackPanel Width="160" Spacing="8">
                                    <Border
                                        Width="160"
                                        Height="160"
                                        CornerRadius="8"
                                        Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Grid>
                                            <FontIcon
                                                Glyph="&#xE8B7;"
                                                FontSize="52"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="0.9" />
                                            <Image
                                                Stretch="Uniform"
                                                Source="{x:Bind Cover, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        TextWrapping="WrapWholeWords"
                                        TextAlignment="Center"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind SongCountText}"
                                        FontSize="11"
                                        Opacity="0.7"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <!-- 播放列表墙：无任何命中单时的空状态提示 -->
                    <StackPanel
                        x:Name="PlaylistWallEmptyHint"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                        <FontIcon
                            Glyph="&#xE8B7;"
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            Opacity="0.7" />
                        <TextBlock
                            Text="当前没有已创建的列表"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Opacity="0.85"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border
                        x:Name="PlaylistWallMultiBar"
                        Grid.Row="2"
                        Padding="0,8,0,0"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button
                                x:Name="PlaylistWallMultiExitButton"
                                Height="30"
                                Padding="10,0"
                                CornerRadius="15"
                                BorderThickness="0"
                                Content="退出"
                                Click="PlaylistWallMultiExitButton_Click" />
                            <Button
                                x:Name="PlaylistWallMultiAddQueueButton"
                                Height="30"
                                Padding="10,0"
                                CornerRadius="15"
                                BorderThickness="0"
                                Content="添加到播放队列"
                                Click="PlaylistWallMultiAddToQueue_Click" />
                            <Button
                                x:Name="PlaylistWallMultiDeleteButton"
                                Height="30"
                                Padding="10,0"
                                CornerRadius="15"
                                BorderThickness="0"
                                Content="删除所选播放列表"
                                Click="PlaylistWallMultiDelete_Click" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>

                <!-- 命中单详情页（主程序内，仿专辑详情：上封面/头像、下歌曲列表） -->
                <Border
                    x:Name="PlaylistDetailBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="10">
                            <Button
                                x:Name="PlaylistDetailBackButton"
                                Content="← 返回播放列表墙"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                CornerRadius="8"
                                BorderThickness="0"
                                Click="PlaylistDetailBackButton_Click" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border
                                    x:Name="PlaylistDetailCover"
                                    Width="168"
                                    Height="168"
                                    CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid>
                                        <FontIcon
                                            Glyph="&#xE8B7;"
                                            FontSize="56"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Opacity="0.5" />
                                        <Image
                                            x:Name="PlaylistDetailCoverImage"
                                            Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="8">
                                    <TextBlock
                                        x:Name="PlaylistDetailNameText"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    <TextBlock
                                        x:Name="PlaylistDetailCountText"
                                        FontSize="12"
                                        Opacity="0.7" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="PlaylistDetailPlayButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            BorderThickness="0"
                                            Content="播放该列表"
                                            Click="PlaylistDetailPlayButton_Click" />
                                        <Button
                                            x:Name="PlaylistDetailAddQueueButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            BorderThickness="0"
                                            Content="添加至播放队列"
                                            Click="PlaylistDetailAddQueueButton_Click" />
                                        <Button
                                            x:Name="PlaylistDetailAddWallButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            BorderThickness="0"
                                            Content="添加到播放列表"
                                            Click="PlaylistDetailAddWallButton_Click" />
                                        <Button
                                            x:Name="PlaylistDetailSortButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            BorderThickness="0"
                                            Content="排序">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="按标题排序" Tag="Title" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按艺术家排序" Tag="Artist" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按专辑排序" Tag="Album" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按音轨号排序" Tag="Track" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按年份排序" Tag="Year" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按时长排序" Tag="Duration" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按文件路径排序" Tag="FilePath" Click="PlaylistDetailSortMenu_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Height="36" Margin="4,0" Padding="12,6,12,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Text="#" />
                                <TextBlock Grid.Column="1" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Text="标题" />
                                <TextBlock Grid.Column="2" FontSize="12" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Right" Text="时长" />
                            </Grid>
                            <ListView
                                x:Name="PlaylistDetailListView"
                                Grid.Row="1"
                                Background="Transparent"
                                SelectionMode="Extended"
                                HorizontalContentAlignment="Stretch"
                                CanDragItems="True"
                                CanReorderItems="True"
                                AllowDrop="True"
                                DoubleTapped="PlaylistDetailListView_DoubleTapped"
                                RightTapped="PlaylistDetailListView_RightTapped"
                                DragItemsCompleted="PlaylistDetailListView_DragItemsCompleted">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PlaylistItem">
                                        <Border Tag="SongRowChrome" MinHeight="64" CornerRadius="8" Padding="10,8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinWidth="{Binding ElementName=PlaylistDetailListView, Path=ActualWidth}" Background="Transparent" PointerEntered="PlaylistDetailRow_PointerEntered" PointerExited="PlaylistDetailRow_PointerExited">
                                            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind IndexLabel}" />
                                                <Border
                                                    x:Name="RowCoverBorder"
                                                    Tag="RowCover"
                                                    Grid.Column="1"
                                                    Width="52"
                                                    Height="52"
                                                    CornerRadius="6"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE958;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                                                        <Image x:Name="RowCoverImage" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind DisplayTitle}" />
                                                    <TextBlock FontSize="11" FontWeight="Normal" Opacity="0.75" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind ArtistAlbumText}" />
                                                    <ItemsControl ItemsSource="{x:Bind FormatChips}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="5" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Tag="FmtChip" Padding="9,2" CornerRadius="9" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                    <TextBlock FontSize="10" Opacity="0.85" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Opacity="0.8" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0" Text="{x:Bind DurationText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 歌曲列表（无外框）；表头固定，仅列表滚动 -->
                <Border
                    x:Name="PlaylistListBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    SizeChanged="PlaylistListBorder_SizeChanged">
                    <Grid RowSpacing="0" PointerPressed="PlaylistList_PointerPressed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 固定信息栏：标题 / 艺术家 / 专辑 / 年份 / 时长（胶囊底，列间可拖无竖线） -->
                        <Grid
                            x:Name="PlaylistHeaderGrid"
                            Grid.Row="0"
                            Height="40"
                            Margin="4,4,4,4"
                            ColumnSpacing="0"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HeaderTitleCol" Width="168" MinWidth="48" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition x:Name="HeaderArtistCol" Width="120" MinWidth="48" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition x:Name="HeaderAlbumCol" Width="120" MinWidth="48" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition x:Name="HeaderYearCol" Width="56" MinWidth="40" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition x:Name="HeaderDurationCol" Width="64" MinWidth="40" />
                                <!-- 右侧留白，避免「时长」胶囊右圆角被裁切 -->
                                <ColumnDefinition x:Name="HeaderEndPadCol" Width="12" MinWidth="12" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="HeaderTitleChip"
                                Grid.Column="0"
                                Height="32"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="标题" />
                            </Border>
                            <local:HorizontalResizeSplitter
                                x:Name="SplitTitleArtist"
                                Grid.Column="1"
                                Tag="Title|Artist"
                                ShowVisualLine="False"
                                PointerPressed="ColumnSplitter_PointerPressed"
                                PointerMoved="ColumnSplitter_PointerMoved"
                                PointerReleased="ColumnSplitter_PointerReleased"
                                PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />

                            <Border
                                x:Name="HeaderArtistChip"
                                Grid.Column="2"
                                Height="32"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="艺术家" />
                            </Border>
                            <local:HorizontalResizeSplitter
                                x:Name="SplitArtistAlbum"
                                Grid.Column="3"
                                Tag="Artist|Album"
                                ShowVisualLine="False"
                                PointerPressed="ColumnSplitter_PointerPressed"
                                PointerMoved="ColumnSplitter_PointerMoved"
                                PointerReleased="ColumnSplitter_PointerReleased"
                                PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />

                            <Border
                                x:Name="HeaderAlbumChip"
                                Grid.Column="4"
                                Height="32"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="专辑" />
                            </Border>
                            <local:HorizontalResizeSplitter
                                x:Name="SplitAlbumYear"
                                Grid.Column="5"
                                Tag="Album|Year"
                                ShowVisualLine="False"
                                PointerPressed="ColumnSplitter_PointerPressed"
                                PointerMoved="ColumnSplitter_PointerMoved"
                                PointerReleased="ColumnSplitter_PointerReleased"
                                PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />

                            <Border
                                x:Name="HeaderYearChip"
                                Grid.Column="6"
                                Height="32"
                                Padding="10,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="年份" />
                            </Border>
                            <local:HorizontalResizeSplitter
                                x:Name="SplitYearDuration"
                                Grid.Column="7"
                                Tag="Year|Duration"
                                ShowVisualLine="False"
                                PointerPressed="ColumnSplitter_PointerPressed"
                                PointerMoved="ColumnSplitter_PointerMoved"
                                PointerReleased="ColumnSplitter_PointerReleased"
                                PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />

                            <Border
                                x:Name="HeaderDurationChip"
                                Grid.Column="8"
                                Height="32"
                                Padding="10,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="时长" />
                            </Border>
                        </Grid>

                        <ListView
                            x:Name="PlaylistView"
                            Grid.Row="1"
                            DoubleTapped="PlaylistView_DoubleTapped"
                            RightTapped="PlaylistView_RightTapped"
                            SelectionMode="Single"
                            CanDragItems="True"
                            AllowDrop="True"
                            CanReorderItems="True"
                            DragItemsCompleted="PlaylistView_DragItemsCompleted"
                            HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="66" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistItem">
                                <!-- 歌曲面板行：序号 | 小封面 | 三行信息 | 时长 -->
                                <Border
                                    Tag="SongRowChrome"
                                    MinHeight="64"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    MinWidth="{Binding ElementName=PlaylistView, Path=ActualWidth}"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent" PointerEntered="SongRow_PointerEntered" PointerExited="SongRow_PointerExited">
                                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 序号 -->
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Opacity="0.7"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Text="{x:Bind IndexLabel}" />

                                        <!-- 小封面 -->
                                        <Border
                                            x:Name="RowCoverBorder"
                                            Tag="RowCover"
                                            Grid.Column="1"
                                            Width="60"
                                            Height="60"
                                            VerticalAlignment="Center"
                                            CornerRadius="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid>
                                                <FontIcon
                                                    Glyph="&#xE958;"
                                                    FontSize="26"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.5" />
                                                <Image
                                                    x:Name="RowCoverImage"
                                                    Stretch="Uniform" />
                                            </Grid>
                                        </Border>

                                        <!-- 三行信息 -->
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                            <!-- 第一行：标题（内嵌标签，较大加粗） -->
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Tag="Title"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                PointerEntered="PlaylistCell_PointerEntered"
                                                PointerExited="PlaylistCell_PointerExited"
                                                PointerMoved="PlaylistCell_PointerMoved"
                                                Text="{x:Bind DisplayTitle}" />
                                            <!-- 第二行：艺术家 - 专辑（比标题更小、更细） -->
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Normal"
                                                Opacity="0.75"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Tag="Album"
                                                PointerEntered="PlaylistCell_PointerEntered"
                                                PointerExited="PlaylistCell_PointerExited"
                                                PointerMoved="PlaylistCell_PointerMoved"
                                                Text="{x:Bind ArtistAlbumText}" />
                                            <!-- 第三行：格式胶囊（格式 / 位深·采样率 / 比特率） -->
                                            <ItemsControl ItemsSource="{x:Bind FormatChips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="5" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Tag="FmtChip"
                                                            Padding="9,2"
                                                            CornerRadius="9"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Opacity="0.85"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 时长（贴右边界但避开滚动条） -->
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Opacity="0.8"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Margin="0,0,16,0"
                                            Text="{x:Bind DurationText, Mode=OneWay, FallbackValue='--:--'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="PlaylistEmptyHint"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Opacity="0.6"
                        Text="暂无内容"
                        Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- 专辑：浏览墙 + 详情页（无外框） -->
                <Border
                    x:Name="AlbumListBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    Visibility="Collapsed">
                    <Grid>
                        <!-- 专辑墙 -->
                        <GridView
                            x:Name="AlbumGridView"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="AlbumGridView_ItemClick"
                            RightTapped="AlbumGridView_RightTapped"
                            SelectionChanged="AlbumGridView_SelectionChromeChanged">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:AlbumEntry">
                                    <Border
                                        Tag="AlbumRowChrome"
                                        CornerRadius="8"
                                        Padding="6"
                                        Background="Transparent">
                                        <StackPanel Width="156" Spacing="6">
                                            <Border
                                                Width="146"
                                                Height="146"
                                                HorizontalAlignment="Center"
                                                Background="{x:Bind CoverFrameBackground, Mode=OneWay}"
                                                CornerRadius="10"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="{x:Bind CoverFrameThickness, Mode=OneWay}">
                                                <Grid>
                                                    <FontIcon
                                                        Glyph="&#xE958;"
                                                        FontSize="40"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.35" />
                                                    <Image
                                                        Stretch="Uniform"
                                                        Source="{x:Bind CoverImage, Mode=OneWay}" />
                                                    <!-- DSD 专辑角标：左上角小三角 + 容器文字 -->
                                                    <Border
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Padding="7,2"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="0,0,8,0"
                                                        Visibility="{x:Bind DsdTagVisibility, Mode=OneWay}">
                                                        <TextBlock
                                                            Text="{x:Bind DsdTagText}"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                FontWeight="SemiBold"
                                                TextWrapping="NoWrap"
                                                TextAlignment="Left"
                                                MaxLines="1"
                                                Height="20"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Name}" />
                                            <!-- 小字行：左=专辑艺术家（省略号收尾），右=歌曲数 -->
                                            <Grid ColumnSpacing="6" Height="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="10"
                                                    Opacity="0.7"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Artist}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="10"
                                                    Opacity="0.7"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind TrackCountText}" />
                                            </Grid>
                                            <!-- 第三行：总时长 -->
                                            <TextBlock
                                                FontSize="10"
                                                Opacity="0.7"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                HorizontalAlignment="Left"
                                                Text="{x:Bind TotalDurationText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 专辑详情：返回栏常驻；下方整页滚动（曲目无独立滚动条） -->
                        <Grid
                            x:Name="AlbumDetailPanel"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="0,4,0,12"
                                Margin="0,0,0,4"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Button
                                    x:Name="AlbumDetailBackButton"
                                    Content="← 返回专辑"
                                    HorizontalAlignment="Left"
                                    Click="AlbumDetailBackButton_Click" />
                            </Border>

                            <Grid
                                Grid.Row="1"
                                ColumnSpacing="24" Padding="0,8,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="600" />
                                    <ColumnDefinition Width="*" MinWidth="400" />
                                </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="14" Width="600" VerticalAlignment="Center">
                                    <Grid ColumnSpacing="16" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            x:Name="AlbumDetailCoverBorder"
                                            Grid.Column="0"
                                            Width="232"
                                            Height="232"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="14"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid>
                                                <FontIcon
                                                    Glyph="&#xE958;"
                                                    FontSize="60"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.35" />
                                                <Image
                                                    x:Name="AlbumDetailCoverImage"
                                                    Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" HorizontalAlignment="Center">
                                            <Button
                                                x:Name="AlbumDetailPlayButton"
                                                Height="36"
                                                Padding="18,0"
                                                CornerRadius="18"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center"
                                                Click="AlbumDetailPlayButton_Click"
                                                ToolTipService.ToolTip="从音轨 1 开始播放，并替换播放列表">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                                                    <TextBlock Text="播放该专辑" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="AlbumDetailAddToPlaylistButton"
                                                Height="36"
                                                Padding="18,0"
                                                CornerRadius="18"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center"
                                                Click="AlbumDetailAddToPlaylistButton_Click"
                                                ToolTipService.ToolTip="将本专辑歌曲添加到播放队列">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;" FontSize="15" />
                                                    <TextBlock Text="添加至播放队列" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="AlbumDetailAddToNamedListButton"
                                                Height="36"
                                                Padding="18,0"
                                                CornerRadius="18"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center"
                                                Click="AlbumDetailAddToNamedListButton_Click"
                                                ToolTipService.ToolTip="把专辑内歌曲按播放顺序添加到某个播放列表">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                                    <TextBlock Text="添加到播放列表" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        x:Name="AlbumDetailNameText"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <!-- 行2 艺术家可点击超链接（进专辑艺术家详情） -->
                                        <Button
                                            x:Name="AlbumDetailSubArtistLink"
                                            HorizontalAlignment="Left"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            PointerEntered="AlbumDetailArtistLink_PointerEntered"
                                            PointerExited="AlbumDetailArtistLink_PointerExited"
                                            Click="AlbumDetailArtistLink_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE716;" FontSize="14" Opacity="0.8" />
                                                <TextBlock
                                                    x:Name="AlbumDetailArtistText"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    TextDecorations="None" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock
                                            x:Name="AlbumDetailSubInfoText"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Opacity="0.85"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="AlbumDetailTechText"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Opacity="0.9"
                                        TextAlignment="Center"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                    <!-- DSD 专辑提示：全 DSD 专辑时显示，置于左侧整块信息区域底部 -->
                                    <TextBlock
                                        x:Name="AlbumDetailDsdHint"
                                        FontSize="11"
                                        Opacity="0.9"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        TextWrapping="WrapWholeWords"
                                        TextAlignment="Center"
                                        Text="该专辑为 DSD 专辑，推荐使用 WASAPI 独占输出，在播放前请检查音量大小"
                                        Visibility="Collapsed" />
                                    <!-- DSD 预加载：把整专辑 DSF 提前装箱成 WAV 缓存，播放时直读（绕开实时装箱的定点卡顿） -->
                                    <StackPanel
                                        x:Name="AlbumDetailPreloadPanel"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                        <Button
                                            x:Name="AlbumDetailPreloadButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            Click="AlbumDetailPreloadButton_Click"
                                            ToolTipService.ToolTip="把本专辑所有 DSD 曲目提前转成可直接播放的缓存文件，播放时不再边播边装箱（用于解决固定位置卡顿）。缓存目录可在选项设置里修改。">
                                            <TextBlock x:Name="AlbumDetailPreloadText" Text="预加载整专辑 DSD" VerticalAlignment="Center" />
                                        </Button>
                                        <Button
                                            x:Name="AlbumDetailPreloadClearButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            Click="AlbumDetailPreloadClearButton_Click"
                                            ToolTipService.ToolTip="删除本专辑已生成的缓存文件（不影响原 DSF 文件）">
                                            <TextBlock Text="清除本专辑缓存" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="AlbumDetailPreloadHint"
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Opacity="0.85"
                                        TextAlignment="Center"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="Collapsed" />
                                    </StackPanel>
                                    </ScrollViewer>
                                    <!-- 右栏：歌曲列表（铺满右侧，独立滚动） -->
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                    <!-- 专辑曲目表头 + 列表（铺满右栏） -->
                                    <Grid Padding="12,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="音轨号" />
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Opacity="0.7" Text="歌曲标题" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontWeight="SemiBold"
                                                Opacity="0.7"
                                                HorizontalAlignment="Right"
                                                Text="时长" />
                                        </Grid>
                                        <ListView
                                            x:Name="AlbumTrackListView"
                                            Background="Transparent"
                                            SelectionMode="Single"
                                            HorizontalContentAlignment="Stretch"
                                            DoubleTapped="AlbumTrackListView_DoubleTapped"
                                            RightTapped="AlbumTrackListView_RightTapped"
                                            SelectionChanged="AlbumTrackListView_SelectionChromeChanged">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsStackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                            <ListView.GroupStyle>
                                                <GroupStyle HidesIfEmpty="True">
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="12,10,12,4" Background="Transparent">
                                                                <TextBlock
                                                                    Text="{Binding Key}"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="12"
                                                                    Opacity="0.6"
                                                                    HorizontalAlignment="Center" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ListView.GroupStyle>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="MinHeight" Value="40" />
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                    <ContentPresenter
                                                                        Content="{TemplateBinding Content}"
                                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        VerticalContentAlignment="Stretch" />
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:PlaylistItem">
                                                    <Border Tag="SongRowChrome" MinHeight="40" CornerRadius="8" Padding="12,0,24,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinWidth="{Binding ElementName=AlbumTrackListView, Path=ActualWidth}" Background="Transparent" PointerEntered="SongRow_PointerEntered" PointerExited="SongRow_PointerExited">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.7" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind TrackText}" />
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Title}" />
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind DurationText}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 艺术家：浏览墙 + 详情页（无外框） -->
                <Border
                    x:Name="ArtistListBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    Visibility="Collapsed">
                    <Grid>
                        <!-- 艺术家墙 -->
                        <GridView
                            x:Name="ArtistGridView"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="ArtistGridView_ItemClick">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:ArtistEntry">
                                    <StackPanel Width="120" Spacing="10">
                                        <!-- 圆形头像：右键选择本地 jpg -->
                                        <Grid
                                            Width="96"
                                            Height="96"
                                            HorizontalAlignment="Center"
                                            RightTapped="ArtistAvatar_RightTapped">
                                            <Ellipse
                                                Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                                StrokeThickness="1" />
                                            <FontIcon
                                                Glyph="&#xE77B;"
                                                FontSize="40"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="0.4"
                                                IsHitTestVisible="False" />
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush
                                                        Stretch="UniformToFill"
                                                        ImageSource="{x:Bind AvatarImage, Mode=OneWay}" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            TextWrapping="WrapWholeWords"
                                            TextAlignment="Center"
                                            MaxLines="3"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 艺术家详情：返回栏常驻；下方内容可滚动 -->
                        <Grid
                            x:Name="ArtistDetailPanel"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="0,4,0,12"
                                Margin="0,0,0,4"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Button
                                    x:Name="ArtistDetailBackButton"
                                    Content="← 返回艺术家"
                                    HorizontalAlignment="Left"
                                    Click="ArtistDetailBackButton_Click" />
                            </Border>

                            <!-- 内容区：左栏(头像+歌曲)常显占满，右栏(专辑墙)独立滚动 -->
                            <Grid Grid.Row="1" RowSpacing="16" Padding="0,8,20,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="280" />
                                </Grid.ColumnDefinitions>

                                <!-- 左右分隔竖线（作为中间独立列，留空隙分隔两栏，不穿内容） -->
                                <Border
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="1"
                                    Width="1"
                                    Margin="50,0,16,0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    IsHitTestVisible="False" />

                                <!-- 圆形头像 + 名字 + 播放艺术家（左列） -->
                                <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Width="160"
                                        Height="160"
                                        RightTapped="ArtistDetailAvatar_RightTapped">
                                        <Ellipse
                                            Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                            StrokeThickness="1" />
                                        <FontIcon
                                            x:Name="ArtistDetailAvatarPlaceholder"
                                            Glyph="&#xE77B;"
                                            FontSize="56"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Opacity="0.4" />
                                        <Ellipse x:Name="ArtistDetailAvatarEllipse">
                                            <Ellipse.Fill>
                                                <ImageBrush
                                                    x:Name="ArtistDetailAvatarBrush"
                                                    Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12" MaxWidth="270">
                                        <TextBlock
                                            x:Name="ArtistDetailNameText"
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            TextWrapping="WrapWholeWords"
                                            MaxLines="4"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Vertical" Spacing="10">
                                            <Button
                                                x:Name="PlayArtistWorksButton"
                                                Height="32"
                                                Padding="14,0"
                                                CornerRadius="16"
                                                BorderThickness="0"
                                                HorizontalAlignment="Left"
                                                Click="PlayArtistWorksButton_Click"
                                                ToolTipService.ToolTip="用该艺术家全部作品替换播放列表并开始播放">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                                    <TextBlock Text="播放该艺术家的作品" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="AddArtistWorksToPlaylistButton"
                                                Height="32"
                                                Padding="14,0"
                                                CornerRadius="16"
                                                BorderThickness="0"
                                                HorizontalAlignment="Left"
                                                Click="AddArtistWorksToPlaylistButton_Click"
                                                ToolTipService.ToolTip="将该艺术家全部作品添加到播放队列">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                    <TextBlock Text="添加该艺术家的作品至播放队列" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 歌曲列表：与右侧信息卡相同毛玻璃（无阴影） -->
                                <Border
                                    x:Name="ArtistSongsFrostPanel"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="430"
                                    Margin="0,0,12,-30"
                                    MaxWidth="430"
                                    MinHeight="0"
                                    Padding="0"
                                    CornerRadius="0"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0"
                                    Background="Transparent">
                                    <Grid RowSpacing="8" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    FontSize="16"
                                                    Text="歌曲" />
                                                <Button
                                                    x:Name="PlayArtistSongsButton"
                                                    Height="32"
                                                    Padding="12,0"
                                                    CornerRadius="16"
                                                    BorderThickness="0"
                                                    Content="播放所有歌曲"
                                                    Click="PlayArtistSongsButton_Click"
                                                    ToolTipService.ToolTip="按当前排序替换播放列表并播放" />
                                                <Button
                                                    x:Name="AddArtistSongsToPlaylistButton"
                                                    Height="32"
                                                    Padding="12,0"
                                                    CornerRadius="16"
                                                    BorderThickness="0"
                                                    Content="添加至播放队列"
                                                    Click="AddArtistSongsToPlaylistButton_Click"
                                                    ToolTipService.ToolTip="按当前排序添加到播放队列" />
                                            </StackPanel>
                                            <Button
                                                x:Name="ArtistSongSortButton"
                                                Content="排序：标题"
                                                HorizontalAlignment="Right"
                                                Width="150"
                                                RenderTransformOrigin="0.5,0.5"
                                                Click="ArtistSongSortButton_Click"
                                                ToolTipService.ToolTip="点击切换排序方式">
                                                <Button.RenderTransform>
                                                    <TranslateTransform X="30" />
                                                </Button.RenderTransform>
                                            </Button>

                                        </Grid>

                                        <ListView
                                            x:Name="ArtistTrackListView"
                                            Grid.Row="1"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Stretch"
                                            Background="Transparent"
                                            SelectionMode="Single"
                                            HorizontalContentAlignment="Stretch"
                                            DoubleTapped="ArtistTrackListView_DoubleTapped"
                                            RightTapped="ArtistTrackListView_RightTapped"
                                            SelectionChanged="ArtistTrackListView_SelectionChromeChanged">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsStackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                            <ListView.Header>
                                                <Grid Padding="12,8,24,8" ColumnSpacing="12" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="歌曲标题" />
                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Opacity="0.7" Text="专辑" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        FontWeight="SemiBold"
                                                        Opacity="0.7"
                                                        HorizontalAlignment="Right"
                                                        Text="时长" />
                                                </Grid>
                                            </ListView.Header>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="MinHeight" Value="40" />
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                    <ContentPresenter
                                                                        Content="{TemplateBinding Content}"
                                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        VerticalContentAlignment="Stretch" />
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:PlaylistItem">
                                                    <Border
                                                        Tag="SongRowChrome"
                                                        MinHeight="40"
                                                        CornerRadius="8"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalAlignment="Stretch"
                                                        MinWidth="{Binding ElementName=ArtistTrackListView, Path=ActualWidth}"
                                                        Padding="12,0,24,0"
                                                        Background="Transparent" PointerEntered="SongRow_PointerEntered" PointerExited="SongRow_PointerExited">
                                                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="72" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Text="{x:Bind Title}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Opacity="0.85"
                                                                TextTrimming="CharacterEllipsis"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Text="{x:Bind Album}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"
                                                                Opacity="0.7"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Text="{x:Bind DurationText}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <!-- 该艺术家的专辑（右栏，顶对齐、随窗口自适应） -->
                                <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 标题 + 排序（同行对齐，顶部对齐横线附近） -->
                                        <Grid ColumnSpacing="12" Padding="0,0,0,4" Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                FontSize="16"
                                                Text="该艺术家的专辑" />
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                                <Button
                                                    x:Name="ArtistAlbumSortFieldButton"
                                                    Height="32"
                                                    Width="150"
                                                    Padding="14,0"
                                                    CornerRadius="16"
                                                    BorderThickness="0"
                                                    Click="ArtistAlbumSortFieldButton_Click"
                                                    ToolTipService.ToolTip="点击切换：按标题排序 / 按年份排序">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock x:Name="ArtistAlbumSortFieldText" Text="按标题排序" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    x:Name="ArtistAlbumSortOrderButton"
                                                    Height="32"
                                                    Width="80"
                                                    Padding="14,0"
                                                    CornerRadius="16"
                                                    BorderThickness="0"
                                                    Click="ArtistAlbumSortOrderButton_Click"
                                                    ToolTipService.ToolTip="切换升序 / 降序">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock x:Name="ArtistAlbumSortOrderText" Text="升序" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 播放所有专辑 / 添加到播放列表（标题下方） -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="PlayAllArtistAlbumsButton"
                                                Height="32"
                                                Padding="12,0"
                                                CornerRadius="16"
                                                BorderThickness="0"
                                                Content="播放所有专辑"
                                                Click="PlayAllArtistAlbumsButton_Click"
                                                ToolTipService.ToolTip="按当前专辑排序依次替换播放列表并播放" />
                                            <Button
                                                x:Name="AddAllArtistAlbumsToPlaylistButton"
                                                Height="32"
                                                Padding="12,0"
                                                CornerRadius="16"
                                                BorderThickness="0"
                                                Content="将所有专辑添加至播放队列"
                                                Click="AddAllArtistAlbumsToPlaylistButton_Click"
                                                ToolTipService.ToolTip="按当前专辑顺序、音轨号加入播放队列最前" />
                                        </StackPanel>
                                    </Grid>

                                        <GridView
                                        x:Name="ArtistAlbumGridView"
                                        Grid.Row="1"
                                        Margin="0,8,0,-30"
                                        SelectionMode="Single"
                                        IsItemClickEnabled="True"
                                        ItemClick="ArtistAlbumGridView_ItemClick"
                                        RightTapped="ArtistAlbumGridView_RightTapped"
                                        SelectionChanged="ArtistAlbumGridView_SelectionChromeChanged">
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="6" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:AlbumEntry">
                                                <Border
                                                    Tag="AlbumRowChrome"
                                                    CornerRadius="8"
                                                    Padding="6"
                                                    Background="Transparent">
                                                    <StackPanel Width="132" Spacing="8">
                                                        <Border
                                                            Width="132"
                                                            Height="132"
                                                            Background="{x:Bind CoverFrameBackground, Mode=OneWay}"
                                                            CornerRadius="8"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="{x:Bind CoverFrameThickness, Mode=OneWay}">
                                                            <Grid>
                                                                <FontIcon
                                                                    Glyph="&#xE958;"
                                                                    FontSize="24"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Opacity="0.35" />
                                                                <Image
                                                                    Stretch="Uniform"
                                                                    Source="{x:Bind CoverImage, Mode=OneWay}" />
                                                                <!-- DSD 专辑角标：左上角小三角 + 容器文字 -->
                                                                <Border
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Padding="6,2"
                                                                    Margin="0"
                                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                    CornerRadius="0,0,6,0"
                                                                    Visibility="{x:Bind DsdTagVisibility, Mode=OneWay}">
                                                                    <TextBlock
                                                                        Text="{x:Bind DsdTagText}"
                                                                        FontSize="9"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock
                                                            Text="{x:Bind Name}"
                                                            FontSize="11"
                                                            TextWrapping="WrapWholeWords"
                                                            TextAlignment="Center"
                                                            MaxLines="2"
                                                            Height="30"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{x:Bind Name}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 文件夹：本地资源管理器式树（无外框） -->
                <Border
                    x:Name="FolderListBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：媒体库树 -->
                        <!-- 注意：这里必须用 Grid 而不是 StackPanel。StackPanel 在堆叠方向给子项"无限高度"，
                             会让 ListView 撑到内容全高、内建 ScrollViewer 认为无需滚动，导致文件夹树过长时内容被裁切且无法滚动。
                             Grid 用 Auto/Auto/* 让 ListView 拿到有限高度，内建滚动即可正常工作。 -->
                        <Grid Grid.Column="0" Width="430">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="MediaLibraryTreeTitle"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="媒体库" />
                                <Button
                                    x:Name="RefreshMediaFoldersButton"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="30"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="RefreshMediaFoldersButton_Click"
                                    ToolTipService.ToolTip="刷新媒体库">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                            <Button
                                x:Name="AddMediaFolderButton"
                                Grid.Row="1"
                                Margin="0,6"
                                Height="32"
                                Padding="10,0"
                                HorizontalAlignment="Left"
                                CornerRadius="16"
                                BorderThickness="1"
                                Click="AddMediaFolderButton_Click"
                                ToolTipService.ToolTip="把文件夹加入媒体库">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="添加文件夹" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- 网络音乐库的入口已挪到「选项设置 → WebDAV」：在那里配好之后，
                                 左侧「媒体库」下方会自动出现以显示名命名的条目，这里不再放按钮。 -->
                            <ListView
                                x:Name="FolderBrowserView"
                                Grid.Row="2"
                                SelectionMode="Single"
                                DoubleTapped="FolderBrowserView_DoubleTapped"
                                RightTapped="FolderBrowserView_RightTapped"
                                SelectionChanged="FolderBrowserView_SelectionChromeChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:FolderBrowserItem">
                                        <Border
                                            Tag="FolderRowChrome"
                                            MinHeight="36"
                                            CornerRadius="10"
                                            Padding="4,0"
                                            VerticalAlignment="Stretch"
                                            Background="{x:Bind CapsuleBackground, Mode=OneWay}">
                                            <Grid
                                                Padding="{x:Bind Indent}"
                                                ColumnSpacing="4"
                                                Background="Transparent"
                                                Tapped="FolderBrowserItem_Tapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="22"
                                                    Height="36"
                                                    Background="Transparent"
                                                    Visibility="{x:Bind ChevronVisibility, Mode=OneWay}"
                                                    Tapped="FolderBrowserChevron_Tapped">
                                                    <FontIcon
                                                        FontSize="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Glyph="{x:Bind ChevronGlyph, Mode=OneWay}"
                                                        IsHitTestVisible="False" />
                                                </Border>

                                                <Border
                                                    Grid.Column="1"
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    Tag="IconSlot" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{x:Bind DisplayName}"
                                                    ToolTipService.ToolTip="{x:Bind FullPath}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                x:Name="FolderBrowserEmptyHint"
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.55"
                                FontSize="16"
                                Text="请选择文件夹"
                                Visibility="Collapsed" />
                        </Grid>

                        <!-- 右：被选中项详情区 -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Padding="8,6"
                                Margin="0,0,0,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="MediaDetailsHeader"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Text="选择文件夹查看歌曲" />
                                    <Button
                                        x:Name="MediaOptionsButton"
                                        Grid.Column="1"
                                        Height="30"
                                        Padding="14,0"
                                        CornerRadius="15"
                                        BorderThickness="1"
                                        Visibility="Collapsed"
                                        Click="MediaOptionsButton_Click"
                                        ToolTipService.ToolTip="多选操作">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                                            <TextBlock Text="选项" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="MediaExitMultiSelectButton"
                                        Grid.Column="2"
                                        Height="30"
                                        Padding="12,0"
                                        CornerRadius="15"
                                        BorderThickness="0"
                                        Visibility="Collapsed"
                                        Click="MediaExitMultiSelectButton_Click"
                                        ToolTipService.ToolTip="退出多选">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                                            <TextBlock Text="退出多选" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <ListView
                                x:Name="MediaDetailsList"
                                Grid.Row="1"
                                Background="Transparent"
                                SelectionMode="None"
                                ContainerContentChanging="MediaDetailsList_ContainerContentChanging"
                                SelectionChanged="MediaDetailsList_SelectionChanged"
                                RightTapped="MediaDetailsList_RightTapped"
                                DoubleTapped="MediaDetailsList_DoubleTapped"
                                HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PlaylistItem">
                                        <Border Tag="SongRowChrome" MinHeight="40" CornerRadius="8" Padding="10,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent">
                                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Opacity="0.6" Text="{x:Bind IndexLabel}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind FileName}" />
                                                    <TextBlock FontSize="11" Opacity="0.7" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind ArtistAlbumText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Opacity="0.7" Text="{x:Bind DurationText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="MediaDetailsEmptyHint"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.55"
                                Text="无歌曲"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 标签排序：按音频元数据标签字段逐级分组钻取浏览 -->
                <Border
                    x:Name="TagSortBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="16,12,16,0"
                    Visibility="Collapsed">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部：分类字段切换（分类墙维度，按钮动态生成，末尾"＋"配置入口） -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Padding="0,0,0,2">
                            <TextBlock Text="分类：" VerticalAlignment="Center" Opacity="0.7" FontSize="13" />
                            <StackPanel x:Name="TagSortFieldButtonsPanel" Orientation="Horizontal" Spacing="6" />
                            <!-- 常态化显示：直接从分类墙进入分组浏览，不藏到底部溢出条 -->
                            <Button x:Name="TagSortGoGroupButton"
                                    Content="分组浏览"
                                    Padding="12,4"
                                    Height="32"
                                    Margin="10,0,0,0"
                                    Click="TagSortClassWallSwitchToGroupButton_Click" />
                        </StackPanel>

                        <!-- 分类墙：一个分类一张封面卡片 -->
                        <ScrollViewer Grid.Row="1" x:Name="TagSortClassScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GridView
                                    x:Name="TagSortClassGridView"
                                    SelectionMode="None"
                                    IsItemClickEnabled="True"
                                    ItemClick="TagSortClassGridView_ItemClick"
                                    RightTapped="TagSortClassGridView_RightTapped">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="local:TagSortCategoryEntry">
                                            <StackPanel Width="132" Spacing="8">
                                                <Border Width="132" Height="132" CornerRadius="8"
                                                        Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="44" Foreground="White"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                                                        <Image Stretch="UniformToFill" Source="{x:Bind Cover, Mode=OneWay}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" TextWrapping="WrapWholeWords" TextAlignment="Center"
                                                           MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind CountText}" FontSize="11" Opacity="0.7" TextAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <!-- 分类墙底部：基数过多时显示"加载更多 / 去分组浏览"提示 -->
                                <Border x:Name="TagSortClassWallOverflowBar"
                                        Visibility="Collapsed"
                                        Margin="0,12,0,24"
                                        Padding="14,10"
                                        CornerRadius="8"
                                        Background="{ThemeResource SystemControlHighlightListLowBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="TagSortClassWallOverflowText"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.85"
                                                   FontSize="13" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="TagSortClassWallLoadMoreButton"
                                                    Content="加载更多"
                                                    Padding="12,4"
                                                    Click="TagSortClassWallLoadMoreButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 分类面板：进入某个分类后显示 -->
                        <Grid Grid.Row="1" x:Name="TagSortPanel" Visibility="Collapsed" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- 顶栏：返回 + 标题 + 切换视角 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="TagSortPanelBackButton" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Content="← 返回" Click="TagSortPanelBackButton_Click" />
                                <TextBlock x:Name="TagSortPanelTitle" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="" />
                                <Button x:Name="TagSortViewModeButton" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="1" VerticalContentAlignment="Center" Content="曲目">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="曲目" Tag="Songs" Click="TagSortViewModeItem_Click" />
                                            <MenuFlyoutItem Text="专辑" Tag="Albums" Click="TagSortViewModeItem_Click" />
                                            <MenuFlyoutItem Text="艺术家" Tag="Artists" Click="TagSortViewModeItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="排序方式" Tag="Sort" Click="TagSortViewModeItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="分组浏览（按字段分组列表）" Tag="GroupBy" Click="TagSortViewModeItem_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button
                                    x:Name="TagSortPanelPlayAllButton"
                                    Height="32"
                                    Padding="12,0"
                                    CornerRadius="16"
                                    BorderThickness="0"
                                    Click="TagSortPanelPlayAllButton_Click"
                                    ToolTipService.ToolTip="按当前列表顺序替换播放队列并从第一首播放">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="播放当前列表歌曲" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <!-- 专辑 / 艺术家 视角：网格 -->
                                <GridView x:Name="TagSortPanelGridView" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="TagSortPanelGridView_ItemClick" Visibility="Collapsed"
                                          RightTapped="TagSortPanelGridView_RightTapped">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="local:TagSortCategoryEntry">
                                            <StackPanel Width="120" Spacing="8">
                                                <Border Width="120" Height="120" CornerRadius="8"
                                                        Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE74A;" FontSize="40" Foreground="White"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                                                        <Image Stretch="UniformToFill" Source="{x:Bind Cover, Mode=OneWay}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" TextWrapping="WrapWholeWords" TextAlignment="Center"
                                                           MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                            </StackPanel>
                                        </DataTemplate>
