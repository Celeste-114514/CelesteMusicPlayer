<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CelesteMusicPlayer">
    <!-- SystemBackdrop 改到首次 Activated 后代码设置，避免解压/非 VS 启动时 Mica 过早初始化导致 0xC000027B -->

    <Grid x:Name="RootShell">
        <Grid.Resources>
            <Style x:Key="CompactListItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="ComfortableListItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>
        <!-- 自定义背景图片(设置里选择,优先于封面背景) -->
        <Image
            x:Name="CustomBackgroundImage"
            Stretch="UniformToFill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
        <!-- MusicPlayer2 风格：专辑封面放大 + 强模糊作为整窗背景 -->
        <Image
            x:Name="AlbumArtBackgroundImage"
            Stretch="UniformToFill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False" />
        <Border
            x:Name="AlbumArtBackgroundScrim"
            Background="#88101820"
            IsHitTestVisible="False" />

        <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <!-- 与系统标题栏（最小化/最大化/关闭）合并的自定义栏 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaPlayerElement
            x:Name="PlayerElement"
            Grid.Row="0"
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Opacity="0"
            IsHitTestVisible="False"
            AreTransportControlsEnabled="False" />

        <!-- 整条标题栏可拖动；右侧留白给系统最小化/最大化/关闭 -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="12,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Padding="4,0,8,0">
                <Image
                    x:Name="AppTitleBarIcon"
                    Width="20"
                    Height="20"
                    Stretch="Uniform"
                    Source="ms-appx:///Assets/AppIcon.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Opacity="0.9"
                    Text="CelesteMusicPlayer" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Margin="4,0,12,0">
                <TextBlock
                    x:Name="NowPlayingText"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="尚未选择音频" />
            </StackPanel>

            <!-- 标题栏右上角：功能按钮（选择/刷新/全屏）+ 自绘系统按钮（靠紧）-->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
                <Button
                    x:Name="AudioSettingsButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="AudioSettingsButton_Click"
                    ToolTipService.ToolTip="音频设置">
                    <FontIcon Glyph="&#xE95B;" FontSize="15" />
                </Button>
                <Button
                    x:Name="SelectLocalAudioButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SelectLocalAudioButton_Click"
                    ToolTipService.ToolTip="选择本地音频">
                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                </Button>
                <Button
                    x:Name="RefreshCurrentPageButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="RefreshCurrentPageButton_Click"
                    ToolTipService.ToolTip="刷新当前页面">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                </Button>
                <Border
                    Width="1"
                    Height="20"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <!-- 自绘系统按钮（无边框窗口） -->
                <Button
                    x:Name="WindowMinButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="WindowMinButton_Click"
                    ToolTipService.ToolTip="最小化">
                    <FontIcon Glyph="&#xE921;" FontSize="15" />
                </Button>
                <Button
                    x:Name="WindowMaxRestoreButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="WindowMaxRestoreButton_Click"
                    ToolTipService.ToolTip="最大化 / 还原">
                    <FontIcon x:Name="WindowMaxRestoreIcon" Glyph="&#xE922;" FontSize="13" />
                </Button>
                <Button
                    x:Name="WindowCloseButton"
                    Width="34"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="WindowCloseButton_Click"
                    ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                </Button>
            </StackPanel>

        </Grid>

        <!-- 中部：分类 | 播放列表（右侧信息面板已停用，播放列表区扩张到底） -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="16,8,16,0" Tapped="MainContentGrid_Tapped">
            <Grid.Resources>
                <!-- 主内容区景深退后：切出播放信息面板时缩小变暗 -->
                <Storyboard x:Name="MainContentDepthBackStoryboard">
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryGrid" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryTransform" Storyboard.TargetProperty="ScaleX"
                                     To="0.9" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryTransform" Storyboard.TargetProperty="ScaleY"
                                     To="0.9" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneRoot" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneTransform" Storyboard.TargetProperty="ScaleX"
                                     To="0.9" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneTransform" Storyboard.TargetProperty="ScaleY"
                                     To="0.9" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <!-- 主内容区景深恢复 -->
                <Storyboard x:Name="MainContentDepthRestoreStoryboard">
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryGrid" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryTransform" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LeftCategoryTransform" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneRoot" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneTransform" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LibraryPaneTransform" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <!-- 音乐库 -->
                <ColumnDefinition x:Name="CategoryColumn" Width="156" MinWidth="148" MaxWidth="220" />
                <!-- 播放列表占剩余全部 -->
                <ColumnDefinition x:Name="PlaylistColumn" Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左：音乐库 + 播放列表入口（统一 Button 选中样式） -->
            <Grid
                x:Name="LeftCategoryGrid"
                Grid.Column="0"
                Margin="0,0,8,0"
                Padding="4"
                RowSpacing="4"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="LeftCategoryTransform" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Margin="8,6,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.7"
                        VerticalAlignment="Center"
                        Text="音乐库" />
                    <FontIcon
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        FontSize="12"
                        Opacity="0.7"
                        VerticalAlignment="Center"
                        Glyph="&#xE8D6;" />
                </Grid>
                <StackPanel
                    x:Name="CategoryNavPanel"
                    Grid.Row="1"
                    Spacing="2">
                    <Button
                        x:Name="NavSongsButton"
                        Tag="Songs"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="歌曲" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavAlbumsButton"
                        Tag="Albums"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE93C;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="专辑" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavArtistsButton"
                        Tag="Artists"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="艺术家" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavAlbumArtistsButton"
                        Tag="AlbumArtists"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE716;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="专辑艺术家" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavFavoritesButton"
                        Tag="Favorites"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB51;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="我喜欢的音乐" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavRatingsButton"
                        Tag="Ratings"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8BF;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="评分" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavRecentButton"
                        Tag="Recent"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="最近播放" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavPlaylistWallButton"
                        Tag="UserPlaylist"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="NavPlaylistWallButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE700;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="播放队列" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavGenreButton"
                        Tag="Genres"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8EC;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="流派" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavYearButton"
                        Tag="Years"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE787;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="年份" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavMostPlayedButton"
                        Tag="MostPlayed"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="播放最多" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NavFoldersButton"
                        Tag="Folders"
                        Margin="4,2"
                        Padding="8,10"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="CategoryNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="文件夹" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Spacing="6"
                    Margin="4,8,4,4">
                    <!-- 音效处理：入口占位（后续阶段接入 ECHO 音效页面） -->
                    <Button
                        x:Name="NavAudioFxButton"
                        Tag="AudioFX"
                        Padding="8,10"
                        FontSize="14"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="1"
                        CornerRadius="20"
                        Click="NavAudioFxButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE91F;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="音效处理" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <!-- 标签排序（三竖图标），与音效处理同级竖排 -->
                    <Button
                        x:Name="NavTagSortButton"
                        Tag="TagSort"
                        Padding="8,10"
                        FontSize="14"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="1"
                        CornerRadius="20"
                        Click="NavTagSortButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Path
                                x:Name="NavTagSortIcon"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Fill="Transparent"
                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                StrokeThickness="1.4"
                                Data="M6,2 L10,2 L10,6 L6,6 Z M2,10 L6,10 L6,14 L2,14 Z M10,10 L14,10 L14,14 L10,14 Z M8,6 L8,8 L4,8 L4,10 M8,8 L12,8 L12,10" />
                            <TextBlock Text="标签排序" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                    <!-- 播放列表，与上面两按钮同级竖排 -->
                    <Button
                        x:Name="UserPlaylistNavButton"
                        Tag="PlaylistWall"
                        Padding="8,10"
                        FontSize="14"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="1"
                        CornerRadius="20"
                        Click="UserPlaylistNavButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path
                                x:Name="UserPlaylistNavIcon"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                Fill="Transparent"
                                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                StrokeThickness="1.4"
                                Data="M2,2 L6,2 L6,6 L2,6 Z M10,2 L14,2 L14,6 L10,6 Z M2,10 L6,10 L6,14 L2,14 Z M10,10 L14,10 L14,14 L10,14 Z" />
                            <TextBlock Text="播放列表" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

        <!-- 中：歌曲列表 / 专辑浏览（侧键前进/后退） -->
            <Grid
                x:Name="LibraryPaneRoot"
                Grid.Column="1"
                RowSpacing="8"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="LibraryPaneTransform" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12" Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="LibraryPaneTitle"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="歌曲"
                            Visibility="Collapsed" />

                        <!-- 多选模式标题：返回 + 选择 + 全选 -->
                        <StackPanel
                            x:Name="MultiSelectTitlePanel"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Button
                                x:Name="ExitMultiSelectButton"
                                Width="36"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ExitMultiSelectButton_Click"
                                ToolTipService.ToolTip="退出多选">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            </Button>
                            <TextBlock
                                x:Name="MultiSelectTitleText"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="选择歌曲" />
                            <Button
                                x:Name="SelectAllMultiSelectButton"
                                Height="32"
                                Padding="10,0"
                                CornerRadius="8"
                                BorderThickness="0"
                                Click="SelectAllMultiSelectButton_Click"
                                ToolTipService.ToolTip="全选 / 取消全选">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="SelectAllMultiSelectIcon" Glyph="&#xE739;" FontSize="14" />
                                    <TextBlock Text="全选" VerticalAlignment="Center" Margin="0,0,0,2" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 歌曲 / 专辑 / 文件夹 搜索 -->
                    <Grid
                        x:Name="LibrarySearchPanel"
                        Grid.Column="1"
                        ColumnSpacing="8"
                        VerticalAlignment="Center"
                        Margin="24,0,0,0"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:StableIBeamTextBox
                            x:Name="LibrarySearchBox"
                            Grid.Column="0"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            PlaceholderText="搜索"
                            TextChanged="LibrarySearchBox_TextChanged" />
                        <StackPanel
                            x:Name="FolderSearchNavPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="FolderSearchCountText"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.85"
                                Text="0/0"
                                MinWidth="36"
                                TextAlignment="Center" />
                            <Button
                                x:Name="FolderSearchPrevButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="FolderSearchPrevButton_Click"
                                ToolTipService.ToolTip="上一个结果">
                                <FontIcon Glyph="&#xE70E;" FontSize="12" />
                            </Button>
                            <Button
                                x:Name="FolderSearchNextButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="FolderSearchNextButton_Click"
                                ToolTipService.ToolTip="下一个结果">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 歌曲库：字段+升/降序；播放列表：更改排序 -->
                    <StackPanel
                        x:Name="SongSortPanel"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="PlayAllLibrarySongsButton"
                            Height="32"
                            Padding="12,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Click="PlayAllLibrarySongsButton_Click"
                            ToolTipService.ToolTip="把当前歌曲列表全部加入队列并按当前排序播放">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="播放所有歌曲" VerticalAlignment="Center" Margin="0,0,0,2" />
                            </StackPanel>
                        </Button>
                        <DropDownButton
                            x:Name="SortFieldButton"
                            Height="32"
                            Padding="14,0"
                            BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="SortFieldText" Text="排序：标题" VerticalAlignment="Center" Margin="0,0,0,2" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="标题" Tag="Title" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="艺术家" Tag="Artist" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="专辑" Tag="Album" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="年份" Tag="Year" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="时长" Tag="Duration" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="流派" Tag="Genre" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="音轨号" Tag="Track" Click="SortFieldMenu_Click" />
                                    <MenuFlyoutItem Text="文件路径" Tag="FilePath" Click="SortFieldMenu_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            x:Name="SortOrderButton"
                            Height="32"
                            MinWidth="72"
                            Padding="14,0"
                            BorderThickness="0"
                            Click="SortOrderButton_Click"
                            ToolTipService.ToolTip="切换升序 / 降序">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="SortOrderText" Text="升序" VerticalAlignment="Center" Margin="0,0,0,2" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ChangeSortButton"
                            Height="32"
                            Padding="14,0"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="ChangeSortButton_Click"
                            ToolTipService.ToolTip="按字段重新排序当前列表（会打乱原有顺序）">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="更改排序"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,2" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 评分分类：6 类胶囊（未评分 + 1..5 星） -->
                    <StackPanel
                        x:Name="RatingFilterPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Button x:Name="RatingFilter0Button" Tag="0" Content="未评分" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter1Button" Tag="1" Content="★1" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter2Button" Tag="2" Content="★2" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter3Button" Tag="3" Content="★3" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter4Button" Tag="4" Content="★4" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                        <Button x:Name="RatingFilter5Button" Tag="5" Content="★5" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Click="RatingFilter_Click" />
                    </StackPanel>

                    <!-- 专辑墙排序：类别下拉 + 升序/降序（两个胶囊并列） -->
                    <StackPanel
                        x:Name="AlbumSortPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <DropDownButton
                            x:Name="AlbumSortButton"
                            Height="32"
                            Padding="14,0"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="按专辑名称"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,8" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="按专辑名称" Tag="Title" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按艺术家" Tag="Artist" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按发行年份" Tag="Year" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按添加时间" Tag="Added" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="随机" Tag="Random" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按专辑曲目数" Tag="TrackCount" Click="AlbumSortMenu_Click" />
                                    <MenuFlyoutItem Text="按专辑总时长" Tag="TotalDuration" Click="AlbumSortMenu_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            x:Name="AlbumSortOrderButton"
                            Height="32"
                            MinWidth="64"
                            Padding="14,0"
                            BorderThickness="0"
                            Click="AlbumSortOrderButton_Click"
                            ToolTipService.ToolTip="切换升序 / 降序">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="升序"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,8" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 播放列表墙（Poweramp 式）：命名单封面墙 -->
                <Border
                    x:Name="PlaylistWallBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            Grid.Row="0"
                            Padding="4,0,4,8"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="播放列表墙" />
                            <Button
                                x:Name="CreatePlaylistWallButton"
                                Grid.Column="1"
                                Height="32"
                                Padding="12,0"
                                CornerRadius="8"
                                Content="新建播放列表"
                                Click="CreatePlaylistWallButton_Click" />
                            <Button
                                x:Name="ExportPlaylistsButton"
                                Grid.Column="2"
                                Height="32"
                                Padding="12,0"
                                CornerRadius="8"
                                Content="导出为 m3u8"
                                Click="ExportPlaylistsButton_Click" />
                        </Grid>
                        <GridView
                        x:Name="PlaylistWallGridView"
                        Grid.Row="1"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="PlaylistWallGridView_ItemClick"
                        RightTapped="PlaylistWallGridView_RightTapped">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistCardViewModel">
                                <StackPanel Width="160" Spacing="8">
                                    <Border
                                        Width="160"
                                        Height="160"
                                        CornerRadius="8"
                                        Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Grid>
                                            <FontIcon
                                                Glyph="&#xE8B7;"
                                                FontSize="52"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="0.9" />
                                            <Image
                                                Stretch="UniformToFill"
                                                Source="{x:Bind Cover, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        TextWrapping="WrapWholeWords"
                                        TextAlignment="Center"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind SongCountText}"
                                        FontSize="11"
                                        Opacity="0.7"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <!-- 播放列表墙：无任何命中单时的空状态提示 -->
                    <StackPanel
                        x:Name="PlaylistWallEmptyHint"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                        <FontIcon
                            Glyph="&#xE8B7;"
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            Opacity="0.7" />
                        <TextBlock
                            Text="当前没有已创建的列表"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Opacity="0.85"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border
                        x:Name="PlaylistWallMultiBar"
                        Grid.Row="2"
                        Padding="0,8,0,0"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button
                                x:Name="PlaylistWallMultiExitButton"
                                Height="30"
                                Padding="10,0"
                                CornerRadius="15"
                                BorderThickness="0"
                                Content="退出"
                                Click="PlaylistWallMultiExitButton_Click" />
                            <Button
                                x:Name="PlaylistWallMultiAddQueueButton"
                                Height="30"
                                Padding="10,0"
                                CornerRadius="15"
                                BorderThickness="0"
                                Content="添加到播放队列"
                                Click="PlaylistWallMultiAddToQueue_Click" />
                            <Button
                                x:Name="PlaylistWallMultiDeleteButton"
                                Height="30"
                                Padding="10,0"
                                CornerRadius="15"
                                BorderThickness="0"
                                Content="删除所选播放列表"
                                Click="PlaylistWallMultiDelete_Click" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>

                <!-- 命中单详情页（主程序内，仿专辑详情：上封面/头像、下歌曲列表） -->
                <Border
                    x:Name="PlaylistDetailBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    Visibility="Collapsed">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="10">
                            <Button
                                x:Name="PlaylistDetailBackButton"
                                Content="← 返回播放列表墙"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                CornerRadius="8"
                                BorderThickness="0"
                                Click="PlaylistDetailBackButton_Click" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border
                                    x:Name="PlaylistDetailCover"
                                    Width="168"
                                    Height="168"
                                    CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid>
                                        <FontIcon
                                            Glyph="&#xE8B7;"
                                            FontSize="56"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Opacity="0.5" />
                                        <Image
                                            x:Name="PlaylistDetailCoverImage"
                                            Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="8">
                                    <TextBlock
                                        x:Name="PlaylistDetailNameText"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    <TextBlock
                                        x:Name="PlaylistDetailCountText"
                                        FontSize="12"
                                        Opacity="0.7" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="PlaylistDetailPlayButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            BorderThickness="0"
                                            Content="播放该列表"
                                            Click="PlaylistDetailPlayButton_Click" />
                                        <Button
                                            x:Name="PlaylistDetailAddQueueButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            BorderThickness="0"
                                            Content="添加至播放队列"
                                            Click="PlaylistDetailAddQueueButton_Click" />
                                        <Button
                                            x:Name="PlaylistDetailAddWallButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            BorderThickness="0"
                                            Content="添加到播放列表"
                                            Click="PlaylistDetailAddWallButton_Click" />
                                        <Button
                                            x:Name="PlaylistDetailSortButton"
                                            Height="32"
                                            Padding="14,0"
                                            CornerRadius="16"
                                            BorderThickness="0"
                                            Content="排序">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="按标题排序" Tag="Title" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按艺术家排序" Tag="Artist" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按专辑排序" Tag="Album" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按音轨号排序" Tag="Track" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按年份排序" Tag="Year" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按时长排序" Tag="Duration" Click="PlaylistDetailSortMenu_Click" />
                                                    <MenuFlyoutItem Text="按文件路径排序" Tag="FilePath" Click="PlaylistDetailSortMenu_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Height="36" Margin="4,0" Padding="12,6,12,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Text="#" />
                                <TextBlock Grid.Column="1" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Text="标题" />
                                <TextBlock Grid.Column="2" FontSize="12" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Right" Text="时长" />
                            </Grid>
                            <ListView
                                x:Name="PlaylistDetailListView"
                                Grid.Row="1"
                                Background="Transparent"
                                SelectionMode="Extended"
                                HorizontalContentAlignment="Stretch"
                                CanDragItems="True"
                                CanReorderItems="True"
                                AllowDrop="True"
                                DoubleTapped="PlaylistDetailListView_DoubleTapped"
                                RightTapped="PlaylistDetailListView_RightTapped"
                                DragItemsCompleted="PlaylistDetailListView_DragItemsCompleted">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PlaylistItem">
                                        <Border Tag="SongRowChrome" MinHeight="64" CornerRadius="8" Padding="10,8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinWidth="{Binding ElementName=PlaylistDetailListView, Path=ActualWidth}" Background="Transparent" PointerEntered="PlaylistDetailRow_PointerEntered" PointerExited="PlaylistDetailRow_PointerExited">
                                            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Opacity="0.7" Text="{x:Bind Index}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Width="52"
                                                    Height="52"
                                                    CornerRadius="6"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE93C;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                                                        <Image x:Name="RowCoverImage" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind DisplayTitle}" />
                                                    <TextBlock FontSize="11" FontWeight="Normal" Opacity="0.75" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind ArtistAlbumText}" />
                                                    <ItemsControl ItemsSource="{x:Bind FormatChips}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="5" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="9,2" CornerRadius="9" Background="#33FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                                    <TextBlock FontSize="10" Opacity="0.85" Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Opacity="0.8" Margin="0,0,16,0" Text="{x:Bind DurationText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 歌曲列表（无外框）；表头固定，仅列表滚动 -->
                <Border
                    x:Name="PlaylistListBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    SizeChanged="PlaylistListBorder_SizeChanged">
                    <Grid RowSpacing="0" PointerPressed="PlaylistList_PointerPressed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 固定信息栏：标题 / 艺术家 / 专辑 / 年份 / 时长（胶囊底，列间可拖无竖线） -->
                        <Grid
                            x:Name="PlaylistHeaderGrid"
                            Grid.Row="0"
                            Height="40"
                            Margin="4,4,4,4"
                            ColumnSpacing="0"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HeaderTitleCol" Width="168" MinWidth="48" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition x:Name="HeaderArtistCol" Width="120" MinWidth="48" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition x:Name="HeaderAlbumCol" Width="120" MinWidth="48" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition x:Name="HeaderYearCol" Width="56" MinWidth="40" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition x:Name="HeaderDurationCol" Width="64" MinWidth="40" />
                                <!-- 右侧留白，避免「时长」胶囊右圆角被裁切 -->
                                <ColumnDefinition x:Name="HeaderEndPadCol" Width="12" MinWidth="12" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="HeaderTitleChip"
                                Grid.Column="0"
                                Height="32"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="标题" />
                            </Border>
                            <local:HorizontalResizeSplitter
                                x:Name="SplitTitleArtist"
                                Grid.Column="1"
                                Tag="Title|Artist"
                                ShowVisualLine="False"
                                PointerPressed="ColumnSplitter_PointerPressed"
                                PointerMoved="ColumnSplitter_PointerMoved"
                                PointerReleased="ColumnSplitter_PointerReleased"
                                PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />

                            <Border
                                x:Name="HeaderArtistChip"
                                Grid.Column="2"
                                Height="32"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="艺术家" />
                            </Border>
                            <local:HorizontalResizeSplitter
                                x:Name="SplitArtistAlbum"
                                Grid.Column="3"
                                Tag="Artist|Album"
                                ShowVisualLine="False"
                                PointerPressed="ColumnSplitter_PointerPressed"
                                PointerMoved="ColumnSplitter_PointerMoved"
                                PointerReleased="ColumnSplitter_PointerReleased"
                                PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />

                            <Border
                                x:Name="HeaderAlbumChip"
                                Grid.Column="4"
                                Height="32"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="专辑" />
                            </Border>
                            <local:HorizontalResizeSplitter
                                x:Name="SplitAlbumYear"
                                Grid.Column="5"
                                Tag="Album|Year"
                                ShowVisualLine="False"
                                PointerPressed="ColumnSplitter_PointerPressed"
                                PointerMoved="ColumnSplitter_PointerMoved"
                                PointerReleased="ColumnSplitter_PointerReleased"
                                PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />

                            <Border
                                x:Name="HeaderYearChip"
                                Grid.Column="6"
                                Height="32"
                                Padding="10,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="年份" />
                            </Border>
                            <local:HorizontalResizeSplitter
                                x:Name="SplitYearDuration"
                                Grid.Column="7"
                                Tag="Year|Duration"
                                ShowVisualLine="False"
                                PointerPressed="ColumnSplitter_PointerPressed"
                                PointerMoved="ColumnSplitter_PointerMoved"
                                PointerReleased="ColumnSplitter_PointerReleased"
                                PointerCaptureLost="ColumnSplitter_PointerCaptureLost" />

                            <Border
                                x:Name="HeaderDurationChip"
                                Grid.Column="8"
                                Height="32"
                                Padding="10,0"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                BorderThickness="0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="时长" />
                            </Border>
                        </Grid>

                        <ListView
                            x:Name="PlaylistView"
                            Grid.Row="1"
                            DoubleTapped="PlaylistView_DoubleTapped"
                            RightTapped="PlaylistView_RightTapped"
                            SelectionMode="Single"
                            CanDragItems="True"
                            AllowDrop="True"
                            CanReorderItems="True"
                            DragItemsCompleted="PlaylistView_DragItemsCompleted"
                            HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="66" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistItem">
                                <!-- 歌曲面板行：序号 | 小封面 | 三行信息 | 时长 -->
                                <Border
                                    Tag="SongRowChrome"
                                    MinHeight="64"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    MinWidth="{Binding ElementName=PlaylistView, Path=ActualWidth}"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent" PointerEntered="SongRow_PointerEntered" PointerExited="SongRow_PointerExited">
                                    <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 序号 -->
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Opacity="0.7"
                                            Text="{x:Bind Index}" />

                                        <!-- 小封面 -->
                                        <Border
                                            Grid.Column="1"
                                            Width="60"
                                            Height="60"
                                            VerticalAlignment="Center"
                                            CornerRadius="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid>
                                                <FontIcon
                                                    Glyph="&#xE93C;"
                                                    FontSize="26"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.5" />
                                                <Image
                                                    x:Name="RowCoverImage"
                                                    Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <!-- 三行信息 -->
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                            <!-- 第一行：标题（内嵌标签，较大加粗） -->
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Tag="Title"
                                                PointerEntered="PlaylistCell_PointerEntered"
                                                PointerExited="PlaylistCell_PointerExited"
                                                PointerMoved="PlaylistCell_PointerMoved"
                                                Text="{x:Bind DisplayTitle}" />
                                            <!-- 第二行：艺术家 - 专辑（比标题更小、更细） -->
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="Normal"
                                                Opacity="0.75"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Tag="Album"
                                                PointerEntered="PlaylistCell_PointerEntered"
                                                PointerExited="PlaylistCell_PointerExited"
                                                PointerMoved="PlaylistCell_PointerMoved"
                                                Text="{x:Bind ArtistAlbumText}" />
                                            <!-- 第三行：格式胶囊（格式 / 位深·采样率 / 比特率） -->
                                            <ItemsControl ItemsSource="{x:Bind FormatChips}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="5" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Padding="9,2"
                                                            CornerRadius="9"
                                                            Background="#33FFFFFF"
                                                            BorderBrush="#22FFFFFF"
                                                            BorderThickness="1">
                                                            <TextBlock
                                                                FontSize="10"
                                                                Opacity="0.85"
                                                                Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 时长（贴右边界但避开滚动条） -->
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Opacity="0.8"
                                            Margin="0,0,16,0"
                                            Text="{x:Bind DurationText, Mode=OneWay, FallbackValue='--:--'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="PlaylistEmptyHint"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Opacity="0.6"
                        Text="暂无内容"
                        Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- 专辑：浏览墙 + 详情页（无外框） -->
                <Border
                    x:Name="AlbumListBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    Visibility="Collapsed">
                    <Grid>
                        <!-- 专辑墙 -->
                        <GridView
                            x:Name="AlbumGridView"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="AlbumGridView_ItemClick"
                            RightTapped="AlbumGridView_RightTapped"
                            SelectionChanged="AlbumGridView_SelectionChromeChanged">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:AlbumEntry">
                                    <Border
                                        Tag="AlbumRowChrome"
                                        CornerRadius="8"
                                        Padding="6"
                                        Background="Transparent">
                                        <StackPanel Width="156" Spacing="6">
                                            <Border
                                                Width="146"
                                                Height="146"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="10"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                                <Grid>
                                                    <FontIcon
                                                        Glyph="&#xE93C;"
                                                        FontSize="40"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.35" />
                                                    <Image
                                                        Stretch="UniformToFill"
                                                        Source="{x:Bind CoverImage, Mode=OneWay}" />
                                                    <!-- DSD 专辑角标：左上角小三角 + 容器文字 -->
                                                    <Border
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Padding="7,2"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="0,0,8,0"
                                                        Visibility="{x:Bind DsdTagVisibility, Mode=OneWay}">
                                                        <TextBlock
                                                            Text="{x:Bind DsdTagText}"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                FontWeight="SemiBold"
                                                TextWrapping="NoWrap"
                                                TextAlignment="Left"
                                                MaxLines="1"
                                                Height="20"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Name}" />
                                            <!-- 小字行：左=专辑艺术家（省略号收尾），右=歌曲数 -->
                                            <Grid ColumnSpacing="6" Height="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="10"
                                                    Opacity="0.7"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Artist}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="10"
                                                    Opacity="0.7"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind TrackCountText}" />
                                            </Grid>
                                            <!-- 第三行：总时长 -->
                                            <TextBlock
                                                FontSize="10"
                                                Opacity="0.7"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                HorizontalAlignment="Left"
                                                Text="{x:Bind TotalDurationText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 专辑详情：返回栏常驻；下方整页滚动（曲目无独立滚动条） -->
                        <Grid
                            x:Name="AlbumDetailPanel"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="0,4,0,12"
                                Margin="0,0,0,4"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Button
                                    x:Name="AlbumDetailBackButton"
                                    Content="← 返回专辑"
                                    HorizontalAlignment="Left"
                                    Click="AlbumDetailBackButton_Click" />
                            </Border>

                            <Grid
                                Grid.Row="1"
                                ColumnSpacing="24" Padding="0,8,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="600" />
                                    <ColumnDefinition Width="*" MinWidth="400" />
                                </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="14" Width="600" VerticalAlignment="Center">
                                    <Grid ColumnSpacing="16" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="232"
                                            Height="232"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="14"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid>
                                                <FontIcon
                                                    Glyph="&#xE93C;"
                                                    FontSize="60"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.35" />
                                                <Image
                                                    x:Name="AlbumDetailCoverImage"
                                                    Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" HorizontalAlignment="Center">
                                            <Button
                                                x:Name="AlbumDetailPlayButton"
                                                Height="36"
                                                Padding="18,0"
                                                CornerRadius="18"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center"
                                                Click="AlbumDetailPlayButton_Click"
                                                ToolTipService.ToolTip="从音轨 1 开始播放，并替换播放列表">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                                                    <TextBlock Text="播放该专辑" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="AlbumDetailAddToPlaylistButton"
                                                Height="36"
                                                Padding="18,0"
                                                CornerRadius="18"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center"
                                                Click="AlbumDetailAddToPlaylistButton_Click"
                                                ToolTipService.ToolTip="将本专辑歌曲添加到播放队列">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;" FontSize="15" />
                                                    <TextBlock Text="添加至播放队列" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="AlbumDetailAddToNamedListButton"
                                                Height="36"
                                                Padding="18,0"
                                                CornerRadius="18"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center"
                                                Click="AlbumDetailAddToNamedListButton_Click"
                                                ToolTipService.ToolTip="把专辑内歌曲按播放顺序添加到某个播放列表">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                                    <TextBlock Text="添加到播放列表" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        x:Name="AlbumDetailNameText"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <!-- 行2 艺术家可点击超链接（进专辑艺术家详情） -->
                                        <Button
                                            x:Name="AlbumDetailSubArtistLink"
                                            HorizontalAlignment="Left"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            PointerEntered="AlbumDetailArtistLink_PointerEntered"
                                            PointerExited="AlbumDetailArtistLink_PointerExited"
                                            Click="AlbumDetailArtistLink_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE716;" FontSize="14" Opacity="0.8" />
                                                <TextBlock
                                                    x:Name="AlbumDetailArtistText"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center"
                                                    TextDecorations="None" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock
                                            x:Name="AlbumDetailSubInfoText"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Opacity="0.85"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="AlbumDetailTechText"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Opacity="0.9"
                                        TextAlignment="Center"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                    <!-- DSD 专辑提示：全 DSD 专辑时显示，置于左侧整块信息区域底部 -->
                                    <TextBlock
                                        x:Name="AlbumDetailDsdHint"
                                        FontSize="11"
                                        Opacity="0.9"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        TextWrapping="WrapWholeWords"
                                        TextAlignment="Center"
                                        Text="该专辑为 DSD 专辑，推荐使用 WASAPI 独占输出，在播放前请检查音量大小"
                                        Visibility="Collapsed" />
                                    </StackPanel>
                                    </ScrollViewer>
                                    <!-- 右栏：歌曲列表（铺满右侧，独立滚动） -->
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                    <!-- 专辑曲目表头 + 列表（铺满右栏） -->
                                    <Grid Padding="12,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="音轨号" />
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Opacity="0.7" Text="歌曲标题" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontWeight="SemiBold"
                                                Opacity="0.7"
                                                HorizontalAlignment="Right"
                                                Text="时长" />
                                        </Grid>
                                        <ListView
                                            x:Name="AlbumTrackListView"
                                            Background="Transparent"
                                            SelectionMode="Single"
                                            HorizontalContentAlignment="Stretch"
                                            DoubleTapped="AlbumTrackListView_DoubleTapped"
                                            RightTapped="AlbumTrackListView_RightTapped"
                                            SelectionChanged="AlbumTrackListView_SelectionChromeChanged">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsStackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                            <ListView.GroupStyle>
                                                <GroupStyle HidesIfEmpty="True">
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="12,10,12,4" Background="Transparent">
                                                                <TextBlock
                                                                    Text="{Binding Key}"
                                                                    FontFamily="Segoe UI"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="12"
                                                                    Opacity="0.6"
                                                                    HorizontalAlignment="Center" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ListView.GroupStyle>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="MinHeight" Value="40" />
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                    <ContentPresenter
                                                                        Content="{TemplateBinding Content}"
                                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        VerticalContentAlignment="Stretch" />
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:PlaylistItem">
                                                    <Border Tag="SongRowChrome" MinHeight="40" CornerRadius="8" Padding="12,0,24,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinWidth="{Binding ElementName=AlbumTrackListView, Path=ActualWidth}" Background="Transparent" PointerEntered="SongRow_PointerEntered" PointerExited="SongRow_PointerExited">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind TrackText}" />
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Title}" />
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" Text="{x:Bind DurationText}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 艺术家：浏览墙 + 详情页（无外框） -->
                <Border
                    x:Name="ArtistListBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    Visibility="Collapsed">
                    <Grid>
                        <!-- 艺术家墙 -->
                        <GridView
                            x:Name="ArtistGridView"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="ArtistGridView_ItemClick">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="10" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:ArtistEntry">
                                    <StackPanel Width="120" Spacing="10">
                                        <!-- 圆形头像：右键选择本地 jpg -->
                                        <Grid
                                            Width="96"
                                            Height="96"
                                            HorizontalAlignment="Center"
                                            RightTapped="ArtistAvatar_RightTapped">
                                            <Ellipse
                                                Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                                StrokeThickness="1" />
                                            <FontIcon
                                                Glyph="&#xE77B;"
                                                FontSize="40"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="0.4"
                                                IsHitTestVisible="False" />
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush
                                                        Stretch="UniformToFill"
                                                        ImageSource="{x:Bind AvatarImage, Mode=OneWay}" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock
                                            Text="{x:Bind Name}"
                                            TextWrapping="WrapWholeWords"
                                            TextAlignment="Center"
                                            MaxLines="3"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 艺术家详情：返回栏常驻；下方内容可滚动 -->
                        <Grid
                            x:Name="ArtistDetailPanel"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="0,4,0,12"
                                Margin="0,0,0,4"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Button
                                    x:Name="ArtistDetailBackButton"
                                    Content="← 返回艺术家"
                                    HorizontalAlignment="Left"
                                    Click="ArtistDetailBackButton_Click" />
                            </Border>

                            <!-- 内容区：左栏(头像+歌曲)常显占满，右栏(专辑墙)独立滚动 -->
                            <Grid Grid.Row="1" RowSpacing="16" Padding="0,8,20,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="280" />
                                </Grid.ColumnDefinitions>

                                <!-- 左右分隔竖线（作为中间独立列，留空隙分隔两栏，不穿内容） -->
                                <Border
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="1"
                                    Width="1"
                                    Margin="50,0,16,0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    IsHitTestVisible="False" />

                                <!-- 圆形头像 + 名字 + 播放艺术家（左列） -->
                                <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Width="160"
                                        Height="160"
                                        RightTapped="ArtistDetailAvatar_RightTapped">
                                        <Ellipse
                                            Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                            StrokeThickness="1" />
                                        <FontIcon
                                            x:Name="ArtistDetailAvatarPlaceholder"
                                            Glyph="&#xE77B;"
                                            FontSize="56"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Opacity="0.4" />
                                        <Ellipse x:Name="ArtistDetailAvatarEllipse">
                                            <Ellipse.Fill>
                                                <ImageBrush
                                                    x:Name="ArtistDetailAvatarBrush"
                                                    Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12" MaxWidth="270">
                                        <TextBlock
                                            x:Name="ArtistDetailNameText"
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            TextWrapping="WrapWholeWords"
                                            MaxLines="4"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Vertical" Spacing="10">
                                            <Button
                                                x:Name="PlayArtistWorksButton"
                                                Height="32"
                                                Padding="14,0"
                                                CornerRadius="16"
                                                BorderThickness="0"
                                                HorizontalAlignment="Left"
                                                Click="PlayArtistWorksButton_Click"
                                                ToolTipService.ToolTip="用该艺术家全部作品替换播放列表并开始播放">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                                    <TextBlock Text="播放该艺术家的作品" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="AddArtistWorksToPlaylistButton"
                                                Height="32"
                                                Padding="14,0"
                                                CornerRadius="16"
                                                BorderThickness="0"
                                                HorizontalAlignment="Left"
                                                Click="AddArtistWorksToPlaylistButton_Click"
                                                ToolTipService.ToolTip="将该艺术家全部作品添加到播放队列">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                    <TextBlock Text="添加该艺术家的作品至播放队列" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- 歌曲列表：与右侧信息卡相同毛玻璃（无阴影） -->
                                <Border
                                    x:Name="ArtistSongsFrostPanel"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="430"
                                    Margin="0,0,12,-30"
                                    MaxWidth="430"
                                    MinHeight="0"
                                    Padding="0"
                                    CornerRadius="0"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0"
                                    Background="Transparent">
                                    <Grid RowSpacing="8" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    FontSize="16"
                                                    Text="歌曲" />
                                                <Button
                                                    x:Name="PlayArtistSongsButton"
                                                    Height="32"
                                                    Padding="12,0"
                                                    CornerRadius="16"
                                                    BorderThickness="0"
                                                    Content="播放所有歌曲"
                                                    Click="PlayArtistSongsButton_Click"
                                                    ToolTipService.ToolTip="按当前排序替换播放列表并播放" />
                                                <Button
                                                    x:Name="AddArtistSongsToPlaylistButton"
                                                    Height="32"
                                                    Padding="12,0"
                                                    CornerRadius="16"
                                                    BorderThickness="0"
                                                    Content="添加至播放队列"
                                                    Click="AddArtistSongsToPlaylistButton_Click"
                                                    ToolTipService.ToolTip="按当前排序添加到播放队列" />
                                            </StackPanel>
                                            <Button
                                                x:Name="ArtistSongSortButton"
                                                Content="排序：标题"
                                                HorizontalAlignment="Right"
                                                Width="150"
                                                RenderTransformOrigin="0.5,0.5"
                                                Click="ArtistSongSortButton_Click"
                                                ToolTipService.ToolTip="点击切换排序方式">
                                                <Button.RenderTransform>
                                                    <TranslateTransform X="30" />
                                                </Button.RenderTransform>
                                            </Button>
                                        </Grid>

                                        <ListView
                                            x:Name="ArtistTrackListView"
                                            Grid.Row="1"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Stretch"
                                            Background="Transparent"
                                            SelectionMode="Single"
                                            HorizontalContentAlignment="Stretch"
                                            DoubleTapped="ArtistTrackListView_DoubleTapped"
                                            RightTapped="ArtistTrackListView_RightTapped"
                                            SelectionChanged="ArtistTrackListView_SelectionChromeChanged">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsStackPanel Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                            <ListView.Header>
                                                <Grid Padding="12,8,24,8" ColumnSpacing="12" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Opacity="0.7" Text="歌曲标题" />
                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Opacity="0.7" Text="专辑" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        FontWeight="SemiBold"
                                                        Opacity="0.7"
                                                        HorizontalAlignment="Right"
                                                        Text="时长" />
                                                </Grid>
                                            </ListView.Header>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="MinHeight" Value="40" />
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                    <ContentPresenter
                                                                        Content="{TemplateBinding Content}"
                                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        VerticalContentAlignment="Stretch" />
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:PlaylistItem">
                                                    <Border
                                                        Tag="SongRowChrome"
                                                        MinHeight="40"
                                                        CornerRadius="8"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalAlignment="Stretch"
                                                        MinWidth="{Binding ElementName=ArtistTrackListView, Path=ActualWidth}"
                                                        Padding="12,0,24,0"
                                                        Background="Transparent" PointerEntered="SongRow_PointerEntered" PointerExited="SongRow_PointerExited">
                                                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="1.2*" />
                                                                <ColumnDefinition Width="72" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"
                                                                Text="{x:Bind Title}" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Opacity="0.85"
                                                                TextTrimming="CharacterEllipsis"
                                                                Text="{x:Bind Album}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"
                                                                Opacity="0.7"
                                                                Text="{x:Bind DurationText}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <!-- 该艺术家的专辑（右栏，顶对齐、随窗口自适应） -->
                                <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 标题 + 排序（同行对齐，顶部对齐横线附近） -->
                                        <Grid ColumnSpacing="12" Padding="0,0,0,4" Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                FontSize="16"
                                                Text="该艺术家的专辑" />
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                                <Button
                                                    x:Name="ArtistAlbumSortFieldButton"
                                                    Height="32"
                                                    Width="150"
                                                    Padding="14,0"
                                                    CornerRadius="16"
                                                    BorderThickness="0"
                                                    Click="ArtistAlbumSortFieldButton_Click"
                                                    ToolTipService.ToolTip="点击切换：按标题排序 / 按年份排序">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock x:Name="ArtistAlbumSortFieldText" Text="按标题排序" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    x:Name="ArtistAlbumSortOrderButton"
                                                    Height="32"
                                                    Width="80"
                                                    Padding="14,0"
                                                    CornerRadius="16"
                                                    BorderThickness="0"
                                                    Click="ArtistAlbumSortOrderButton_Click"
                                                    ToolTipService.ToolTip="切换升序 / 降序">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock x:Name="ArtistAlbumSortOrderText" Text="升序" VerticalAlignment="Center" Margin="0,0,0,2" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 播放所有专辑 / 添加到播放列表（标题下方） -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="PlayAllArtistAlbumsButton"
                                                Height="32"
                                                Padding="12,0"
                                                CornerRadius="16"
                                                BorderThickness="0"
                                                Content="播放所有专辑"
                                                Click="PlayAllArtistAlbumsButton_Click"
                                                ToolTipService.ToolTip="按当前专辑排序依次替换播放列表并播放" />
                                            <Button
                                                x:Name="AddAllArtistAlbumsToPlaylistButton"
                                                Height="32"
                                                Padding="12,0"
                                                CornerRadius="16"
                                                BorderThickness="0"
                                                Content="将所有专辑添加至播放队列"
                                                Click="AddAllArtistAlbumsToPlaylistButton_Click"
                                                ToolTipService.ToolTip="按当前专辑顺序、音轨号加入播放队列最前" />
                                        </StackPanel>
                                    </Grid>

                                        <GridView
                                        x:Name="ArtistAlbumGridView"
                                        Grid.Row="1"
                                        Margin="0,8,0,-30"
                                        SelectionMode="Single"
                                        IsItemClickEnabled="True"
                                        ItemClick="ArtistAlbumGridView_ItemClick"
                                        RightTapped="ArtistAlbumGridView_RightTapped"
                                        SelectionChanged="ArtistAlbumGridView_SelectionChromeChanged">
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Margin" Value="6" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:AlbumEntry">
                                                <Border
                                                    Tag="AlbumRowChrome"
                                                    CornerRadius="8"
                                                    Padding="6"
                                                    Background="Transparent">
                                                    <StackPanel Width="132" Spacing="8">
                                                        <Border
                                                            Width="132"
                                                            Height="132"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="8"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1">
                                                            <Grid>
                                                                <FontIcon
                                                                    Glyph="&#xE93C;"
                                                                    FontSize="24"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Opacity="0.35" />
                                                                <Image
                                                                    Stretch="UniformToFill"
                                                                    Source="{x:Bind CoverImage, Mode=OneWay}" />
                                                                <!-- DSD 专辑角标：左上角小三角 + 容器文字 -->
                                                                <Border
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Padding="6,2"
                                                                    Margin="0"
                                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                    CornerRadius="0,0,6,0"
                                                                    Visibility="{x:Bind DsdTagVisibility, Mode=OneWay}">
                                                                    <TextBlock
                                                                        Text="{x:Bind DsdTagText}"
                                                                        FontSize="9"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock
                                                            Text="{x:Bind Name}"
                                                            FontSize="11"
                                                            TextWrapping="WrapWholeWords"
                                                            TextAlignment="Center"
                                                            MaxLines="2"
                                                            Height="30"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{x:Bind Name}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 文件夹：本地资源管理器式树（无外框） -->
                <Border
                    x:Name="FolderListBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：媒体库树 -->
                        <StackPanel Grid.Column="0" Width="430" Spacing="6">
                            <Grid Margin="12,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="媒体库" />
                                <Button
                                    x:Name="RefreshMediaFoldersButton"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="30"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="RefreshMediaFoldersButton_Click"
                                    ToolTipService.ToolTip="刷新媒体库">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                            <Button
                                x:Name="AddMediaFolderButton"
                                Height="32"
                                Padding="10,0"
                                HorizontalAlignment="Left"
                                CornerRadius="16"
                                BorderThickness="1"
                                Click="AddMediaFolderButton_Click"
                                ToolTipService.ToolTip="把文件夹加入媒体库">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="添加文件夹" VerticalAlignment="Center" Margin="0,0,0,2" />
                                </StackPanel>
                            </Button>
                            <ListView
                                x:Name="FolderBrowserView"
                                SelectionMode="Single"
                                DoubleTapped="FolderBrowserView_DoubleTapped"
                                RightTapped="FolderBrowserView_RightTapped"
                                SelectionChanged="FolderBrowserView_SelectionChromeChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:FolderBrowserItem">
                                        <Border
                                            Tag="FolderRowChrome"
                                            MinHeight="36"
                                            CornerRadius="10"
                                            Padding="4,0"
                                            VerticalAlignment="Stretch"
                                            Background="{x:Bind CapsuleBackground, Mode=OneWay}">
                                            <Grid
                                                Padding="{x:Bind Indent}"
                                                ColumnSpacing="4"
                                                Background="Transparent"
                                                Tapped="FolderBrowserItem_Tapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="22"
                                                    Height="36"
                                                    Background="Transparent"
                                                    Visibility="{x:Bind ChevronVisibility, Mode=OneWay}"
                                                    Tapped="FolderBrowserChevron_Tapped">
                                                    <FontIcon
                                                        FontSize="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Glyph="{x:Bind ChevronGlyph, Mode=OneWay}"
                                                        IsHitTestVisible="False" />
                                                </Border>

                                                <Border
                                                    Grid.Column="1"
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    Tag="IconSlot" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    TextTrimming="CharacterEllipsis"
                                                    Text="{x:Bind DisplayName}"
                                                    ToolTipService.ToolTip="{x:Bind FullPath}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                x:Name="FolderBrowserEmptyHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.55"
                                FontSize="16"
                                Text="请选择文件夹"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <!-- 右：被选中项详情区 -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Padding="8,6"
                                Margin="0,0,0,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="MediaDetailsHeader"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        Text="选择文件夹查看歌曲" />
                                    <Button
                                        x:Name="MediaOptionsButton"
                                        Grid.Column="1"
                                        Height="30"
                                        Padding="14,0"
                                        CornerRadius="15"
                                        BorderThickness="1"
                                        Visibility="Collapsed"
                                        Click="MediaOptionsButton_Click"
                                        ToolTipService.ToolTip="多选操作">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                                            <TextBlock Text="选项" VerticalAlignment="Center" Margin="0,0,0,2" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="MediaExitMultiSelectButton"
                                        Grid.Column="2"
                                        Height="30"
                                        Padding="12,0"
                                        CornerRadius="15"
                                        BorderThickness="0"
                                        Visibility="Collapsed"
                                        Click="MediaExitMultiSelectButton_Click"
                                        ToolTipService.ToolTip="退出多选">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                                            <TextBlock Text="退出多选" VerticalAlignment="Center" Margin="0,0,0,2" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <ListView
                                x:Name="MediaDetailsList"
                                Grid.Row="1"
                                Background="Transparent"
                                SelectionMode="None"
                                ContainerContentChanging="MediaDetailsList_ContainerContentChanging"
                                SelectionChanged="MediaDetailsList_SelectionChanged"
                                RightTapped="MediaDetailsList_RightTapped"
                                HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Margin" Value="0,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PlaylistItem">
                                        <Border Tag="SongRowChrome" MinHeight="40" CornerRadius="8" Padding="10,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent">
                                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Opacity="0.6" Text="{x:Bind Index}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind FileName}" />
                                                    <TextBlock FontSize="11" Opacity="0.7" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{x:Bind ArtistAlbumText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Opacity="0.7" Text="{x:Bind DurationText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="MediaDetailsEmptyHint"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.55"
                                Text="无歌曲"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 标签排序：按音频元数据标签字段逐级分组钻取浏览 -->
                <Border
                    x:Name="TagSortBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="16,12,16,0"
                    Visibility="Collapsed">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部：分类字段切换（分类墙维度） -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Padding="0,0,0,2">
                            <TextBlock Text="分类：" VerticalAlignment="Center" Opacity="0.7" FontSize="13" />
                            <Button x:Name="TagSortFieldArtistButton" Tag="Artist" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="1" VerticalContentAlignment="Center" Content="艺术家" Click="TagSortFieldBoundButton_Click" />
                            <Button x:Name="TagSortFieldAlbumArtistButton" Tag="AlbumArtist" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="1" VerticalContentAlignment="Center" Content="专辑艺术家" Click="TagSortFieldBoundButton_Click" />
                            <Button x:Name="TagSortFieldAlbumButton" Tag="Album" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="1" VerticalContentAlignment="Center" Content="专辑" Click="TagSortFieldBoundButton_Click" />
                            <Button x:Name="TagSortFieldGenreButton" Tag="Genre" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="1" VerticalContentAlignment="Center" Content="流派" Click="TagSortFieldBoundButton_Click" />
                            <Button x:Name="TagSortFieldYearButton" Tag="Year" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="1" VerticalContentAlignment="Center" Content="年份" Click="TagSortFieldBoundButton_Click" />
                        </StackPanel>

                        <!-- 分类墙：一个分类一张封面卡片 -->
                        <ScrollViewer Grid.Row="1" x:Name="TagSortClassScroll" VerticalScrollBarVisibility="Auto">
                            <GridView
                                x:Name="TagSortClassGridView"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="TagSortClassGridView_ItemClick"
                                RightTapped="TagSortClassGridView_RightTapped">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TagSortCategoryEntry">
                                        <StackPanel Width="132" Spacing="8">
                                            <Border Width="132" Height="132" CornerRadius="8"
                                                    Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="44" Foreground="White"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                                                    <Image Stretch="UniformToFill" Source="{x:Bind Cover, Mode=OneWay}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="WrapWholeWords" TextAlignment="Center"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind CountText}" FontSize="11" Opacity="0.7" TextAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </ScrollViewer>

                        <!-- 分类面板：进入某个分类后显示 -->
                        <Grid Grid.Row="1" x:Name="TagSortPanel" Visibility="Collapsed" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- 顶栏：返回 + 标题 + 切换视角 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="TagSortPanelBackButton" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="0" VerticalContentAlignment="Center" Content="← 返回" Click="TagSortPanelBackButton_Click" />
                                <TextBlock x:Name="TagSortPanelTitle" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="" />
                                <Button x:Name="TagSortViewModeButton" Height="32" Padding="12,0" CornerRadius="16" BorderThickness="1" VerticalContentAlignment="Center" Content="曲目">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="曲目" Tag="Songs" Click="TagSortViewModeItem_Click" />
                                            <MenuFlyoutItem Text="专辑" Tag="Albums" Click="TagSortViewModeItem_Click" />
                                            <MenuFlyoutItem Text="艺术家" Tag="Artists" Click="TagSortViewModeItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="排序方式" Tag="Sort" Click="TagSortViewModeItem_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button
                                    x:Name="TagSortPanelPlayAllButton"
                                    Height="32"
                                    Padding="12,0"
                                    CornerRadius="16"
                                    BorderThickness="0"
                                    Click="TagSortPanelPlayAllButton_Click"
                                    ToolTipService.ToolTip="按当前列表顺序替换播放队列并从第一首播放">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="播放当前列表歌曲" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <!-- 专辑 / 艺术家 视角：网格 -->
                                <GridView x:Name="TagSortPanelGridView" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="TagSortPanelGridView_ItemClick" Visibility="Collapsed"
                                          RightTapped="TagSortPanelGridView_RightTapped">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="100" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="local:TagSortCategoryEntry">
                                            <StackPanel Width="120" Spacing="8">
                                                <Border Width="120" Height="120" CornerRadius="8"
                                                        Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE74A;" FontSize="40" Foreground="White"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                                                        <Image Stretch="UniformToFill" Source="{x:Bind Cover, Mode=OneWay}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" TextWrapping="WrapWholeWords" TextAlignment="Center"
                                                           MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <!-- 曲目 视角：列表 -->
                                <ListView x:Name="TagSortPanelSongListView" SelectionMode="Extended"
                                          DoubleTapped="TagSortPanelSongListView_DoubleTapped"
                                          RightTapped="TagSortPanelSongListView_RightTapped"
                                          ContainerContentChanging="TagSortPanelSongList_ContainerContentChanging"
                                          SelectionChanged="TagSortPanelSongList_SelectionChanged" Visibility="Collapsed">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="40" />
                                            <Setter Property="CornerRadius" Value="8" />
                                            <Setter Property="Margin" Value="0,2" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:PlaylistItem">
                                            <Border Tag="SongRowChrome" MinHeight="40" CornerRadius="8" Padding="12,0" Background="Transparent">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.7" Text="{x:Bind Index}" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Title}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" Text="{x:Bind DurationText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- 排序方式 视图：预设 + 自定义 + 升降序 -->
                                <StackPanel x:Name="TagSortSortPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="排序方式（用于排序曲库/主面板歌曲顺序）" Opacity="0.7" FontSize="13" />
                                    <ComboBox x:Name="TagSortPresetCombo" MinWidth="280"
                                              SelectionChanged="TagSortPresetCombo_SelectionChanged">
                                        <ComboBoxItem Content="专辑" />
                                        <ComboBoxItem Content="专辑艺术家 / 专辑" />
                                        <ComboBoxItem Content="专辑艺术家 / 年份 / 专辑" />
                                        <ComboBoxItem Content="艺术家 / 专辑" />
                                        <ComboBoxItem Content="流派 / 专辑" />
                                        <ComboBoxItem Content="年份 / 专辑" />
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ToggleButton x:Name="TagSortAscButton" Content="升序" IsChecked="True"
                                                      Click="TagSortOrderClick" />
                                        <ToggleButton x:Name="TagSortDescButton" Content="降序"
                                                      Click="TagSortOrderClick" />
                                    </StackPanel>
                                    <Button Content="自定义排序…" Click="TagSortCustomSortButton_Click" />
                                    <TextBlock x:Name="TagSortSortStatusText" Opacity="0.7" Text="" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 音效处理 DSP 面板：EQ / 声道平衡 / 安全限幅（对齐 ECHO 音效处理工作台） -->
                <Border
                    x:Name="AudioFxBorder"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,4"
                    Visibility="Collapsed">
                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,12,0">
                        <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Stretch">
                            <!-- 顶部提示：使用 DSP 时提示非 bit-perfect -->
                            <Border
                                x:Name="AudioFxBitPerfectHint"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="AudioFxHintText"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.7"
                                        TextWrapping="WrapWholeWords"
                                        Text="开启任一音效（EQ / 声道平衡 / 限幅）后，输出将不再 bit-perfect。" />
                                    <TextBlock
                                        x:Name="AudioFxBitPerfectStatusText"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="bit-perfect" />
                                </Grid>
                            </Border>
                            <!-- EQ 分区：ECHO 式曲线均衡 -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                                <StackPanel Spacing="12">
                                    <!-- 标题行：EQ 开关 + 专业/简单模式 -->
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="均衡器（EQ）" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Name="AudioFxEqSubText"
                                                Text="曲线均衡 · 实时生效 · 使用 DSP 时输出非 bit-perfect"
                                                FontSize="12"
                                                Opacity="0.6" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <ToggleSwitch
                                                x:Name="AudioFxEqEnableToggle"
                                                Header="EQ"
                                                OnContent=""
                                                OffContent=""
                                                Toggled="AudioFxEqEnable_Toggled" />
                                            <RadioButtons
                                                x:Name="AudioFxEqModeRadio"
                                                MaxColumns="2"
                                                SelectedIndex="0"
                                                SelectionChanged="AudioFxEqMode_SelectionChanged">
                                                <x:String>专业</x:String>
                                                <x:String>简单</x:String>
                                            </RadioButtons>
                                        </StackPanel>
                                    </Grid>
                                    <!-- 工具栏：预设 + preamp + 自动增益 + 添加段 -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="AudioFxEqPresetCombo"
                                            MinWidth="170"
                                            SelectionChanged="AudioFxEqPreset_SelectionChanged" />
                                        <TextBlock
                                            x:Name="AudioFxEqPreampText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Opacity="0.7"
                                            Text="预增益 (preamp)：0.0 dB" />
                                        <Button
                                            x:Name="AudioFxEqAutoGainButton"
                                            Grid.Column="2"
                                            Content="自动增益"
                                            Click="AudioFxEqAutoGain_Click" />
                                        <Button
                                            x:Name="AudioFxEqAddBandButton"
                                            Grid.Column="3"
                                            Content="＋ 添加段"
                                            Click="AudioFxEqAddBand_Click" />
                                        <Button
                                            x:Name="AudioFxEqSavePresetButton"
                                            Grid.Column="4"
                                            Content="保存预设"
                                            ToolTipService.ToolTip="把当前曲线保存为你命名的预设"
                                            Click="AudioFxEqSavePreset_Click" />
                                    </Grid>
                                    <!-- 曲线视图 -->
                                    <Border
                                        x:Name="AudioFxEqCurveHost"
                                        Height="250"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Canvas
                                            x:Name="AudioFxEqCurveCanvas"
                                            Background="Transparent"
                                            PointerPressed="AudioFxEqCurve_PointerPressed"
                                            PointerMoved="AudioFxEqCurve_PointerMoved"
                                            PointerReleased="AudioFxEqCurve_PointerReleased"
                                            PointerCanceled="AudioFxEqCurve_PointerReleased"
                                            PointerCaptureLost="AudioFxEqCurve_PointerReleased" />
                                    </Border>
                                    <!-- 选中 band 的属性编辑器（专业模式） -->
                                    <Grid
                                        x:Name="AudioFxEqBandEditor"
                                        ColumnSpacing="10"
                                        Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="AudioFxEqBandTypeCombo"
                                            MinWidth="110"
                                            SelectionChanged="AudioFxEqBandType_SelectionChanged" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="频率 (Hz)" FontSize="11" Opacity="0.7" />
                                            <Slider
                                                x:Name="AudioFxEqBandFreqSlider"
                                                Minimum="1.3"
                                                Maximum="4.3"
                                                ValueChanged="AudioFxEqBandFreq_ValueChanged" />
                                            <TextBlock
                                                x:Name="AudioFxEqBandFreqLabel"
                                                FontSize="11"
                                                Opacity="0.6"
                                                Text="1000 Hz" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="增益 (dB)" FontSize="11" Opacity="0.7" />
                                            <Slider
                                                x:Name="AudioFxEqBandGainSlider"
                                                Minimum="-24"
                                                Maximum="24"
                                                StepFrequency="0.5"
                                                ValueChanged="AudioFxEqBandGain_ValueChanged" />
                                            <TextBlock
                                                x:Name="AudioFxEqBandGainLabel"
                                                FontSize="11"
                                                Opacity="0.6"
                                                Text="0.0 dB" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="2">
                                            <TextBlock Text="Q" FontSize="11" Opacity="0.7" />
                                            <Slider
                                                x:Name="AudioFxEqBandQSlider"
                                                Minimum="0.1"
                                                Maximum="24"
                                                StepFrequency="0.1"
                                                ValueChanged="AudioFxEqBandQ_ValueChanged" />
                                            <TextBlock
                                                x:Name="AudioFxEqBandQLabel"
                                                FontSize="11"
                                                Opacity="0.6"
                                                Text="1.0" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="AudioFxEqBandEnableToggle"
                                            Grid.Column="4"
                                            Header="启用"
                                            OnContent=""
                                            OffContent=""
                                            VerticalAlignment="Center"
                                            Toggled="AudioFxEqBandEnable_Toggled" />
                                        <Button
                                            x:Name="AudioFxEqBandDeleteButton"
                                            Grid.Column="5"
                                            Content="删除段"
                                            VerticalAlignment="Center"
                                            Click="AudioFxEqBandDelete_Click" />
                                    </Grid>
                                    <!-- 简单模式面板 -->
                                    <StackPanel
                                        x:Name="AudioFxEqSimplePanel"
                                        Spacing="10"
                                        Visibility="Collapsed">
                                        <TextBlock Text="一键调音（低音 / 人声 / 空气 / 温暖）" FontSize="12" Opacity="0.7" />
                                        <Slider
                                            x:Name="AudioFxEqSimpleBassSlider"
                                            Header="低音"
                                            Minimum="0"
                                            Maximum="1"
                                            StepFrequency="0.05"
                                            ValueChanged="AudioFxEqSimple_ValueChanged" />
                                        <Slider
                                            x:Name="AudioFxEqSimpleVocalSlider"
                                            Header="人声"
                                            Minimum="0"
                                            Maximum="1"
                                            StepFrequency="0.05"
                                            ValueChanged="AudioFxEqSimple_ValueChanged" />
                                        <Slider
                                            x:Name="AudioFxEqSimpleAirSlider"
                                            Header="空气"
                                            Minimum="0"
                                            Maximum="1"
                                            StepFrequency="0.05"
                                            ValueChanged="AudioFxEqSimple_ValueChanged" />
                                        <Slider
                                            x:Name="AudioFxEqSimpleWarmSlider"
                                            Header="温暖"
                                            Minimum="0"
                                            Maximum="1"
                                            StepFrequency="0.05"
                                            ValueChanged="AudioFxEqSimple_ValueChanged" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="平坦" Click="AudioFxEqSimpleFlat_Click" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Opacity="0.55"
                                                Text="简单模式通过预设曲线生成，可在专业模式中继续微调。" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- 提示 + 重置 -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="重置 EQ" Click="AudioFxEqReset_Click" />
                                        <TextBlock
                                            x:Name="AudioFxEqHintText"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Opacity="0.55"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 声道平衡分区 -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="声道平衡" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="左右增益 / 平衡 / 反相 / 交换 / 单声道" FontSize="12" Opacity="0.6" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="AudioFxChannelToggle"
                                            Grid.Column="1"
                                            Header="启用"
                                            OnContent=""
                                            OffContent=""
                                            Toggled="AudioFxChannel_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="24" RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="左右平衡" FontSize="12" />
                                            <Slider
                                                x:Name="AudioFxChannelBalanceSlider"
                                                Minimum="-1" Maximum="1" StepFrequency="0.05" Value="0"
                                                ValueChanged="AudioFxChannelSlider_ValueChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="左声道增益 (dB)" FontSize="12" />
                                            <Slider
                                                x:Name="AudioFxChannelLeftGainSlider"
                                                Minimum="-12" Maximum="12" StepFrequency="1" Value="0"
                                                ValueChanged="AudioFxChannelSlider_ValueChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="右声道增益 (dB)" FontSize="12" />
                                            <Slider
                                                x:Name="AudioFxChannelRightGainSlider"
                                                Minimum="-12" Maximum="12" StepFrequency="1" Value="0"
                                                ValueChanged="AudioFxChannelSlider_ValueChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="单声道模式" FontSize="12" />
                                            <ComboBox
                                                x:Name="AudioFxChannelMonoCombo"
                                                SelectionChanged="AudioFxChannelMono_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="16">
                                            <ToggleSwitch x:Name="AudioFxChannelSwapToggle" Header="交换左右" OnContent="" OffContent="" Toggled="AudioFxChannelSwap_Toggled" />
                                            <ToggleSwitch x:Name="AudioFxChannelInvertLToggle" Header="左反相" OnContent="" OffContent="" Toggled="AudioFxChannelSwap_Toggled" />
                                            <ToggleSwitch x:Name="AudioFxChannelInvertRToggle" Header="右反相" OnContent="" OffContent="" Toggled="AudioFxChannelSwap_Toggled" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 安全限幅 / 余量分区 -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="安全限幅 / 余量" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="全局余量预衰减 + 峰值软限幅，防削波 / 爆音" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="AudioFxSafetyHeadroomLabel" Text="余量 (dB)：0.0" FontSize="12" />
                                        <Slider
                                            x:Name="AudioFxSafetyHeadroomSlider"
                                            Minimum="-12" Maximum="0" StepFrequency="0.5" Value="0"
                                            ValueChanged="AudioFxSafetyHeadroom_ValueChanged" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="AudioFxSafetyLimiterToggle"
                                        Header="启用安全限幅器（soft-clip）"
                                        IsOn="True"
                                        OnContent=""
                                        OffContent=""
                                        Toggled="AudioFxSafetyLimiter_Toggled" />
                                </StackPanel>
                            </Border>
                            <!-- 响度归一化（ReplayGain）分区：对齐 ECHO ReplayGain（单曲/专辑增益 + preamp + peak 防削波 + 10ms 平滑） -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="响度归一化（ReplayGain）" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="按单曲 / 专辑统一响度，10ms 平滑渐变，peak 防削波" FontSize="12" Opacity="0.6" />
                                        <TextBlock Text="⚠ 启用 ReplayGain 后输出将不能达成 bit-perfect（会改变样本增益）" FontSize="11" Opacity="0.7" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="AudioFxRgModeCombo"
                                            MinWidth="130"
                                            SelectionChanged="AudioFxRgMode_SelectionChanged" />
                                        <TextBlock
                                            x:Name="AudioFxRgInfoText"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Opacity="0.6"
                                            TextWrapping="WrapWholeWords"
                                            Text="当前曲目：无 ReplayGain 标签" />
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="AudioFxRgPreampLabel" Text="额外增益 (dB)：0.0" FontSize="12" />
                                        <Slider
                                            x:Name="AudioFxRgPreampSlider"
                                            Minimum="-12" Maximum="12" StepFrequency="0.5" Value="0"
                                            ValueChanged="AudioFxRgPreamp_ValueChanged" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="AudioFxRgPreventClippingToggle"
                                        Header="防削波（peak 超限时自动压低增益）"
                                        IsOn="True"
                                        OnContent=""
                                        OffContent=""
                                        Toggled="AudioFxRgPreventClipping_Toggled" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 播放列表：保存 / 打开 / 清空 / 播放（仅播放列表界面显示） -->
                <Grid
                    x:Name="UserPlaylistActionBar"
                    Grid.Row="2"
                    Padding="4,8"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button
                            x:Name="SavePlaylistButton"
                            Height="32"
                            Padding="14,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Content="保存为新的播放列表"
                            Click="SavePlaylistButton_Click"
                            ToolTipService.ToolTip="把当前队列保存为新播放列表" />
                        <Button
                            x:Name="OpenPlaylistButton"
                            Height="32"
                            Padding="14,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Content="添加到播放列表"
                            Click="OpenPlaylistButton_Click"
                            ToolTipService.ToolTip="把当前队列添加到播放列表（列表墙）" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button
                            x:Name="ClearPlaylistButton"
                            Height="32"
                            Padding="14,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Content="清空当前队列"
                            Click="ClearPlaylistButton_Click"
                            ToolTipService.ToolTip="清空当前播放队列" />
                        <Button
                            x:Name="PlayUserPlaylistButton"
                            Height="32"
                            Padding="14,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Click="PlayUserPlaylistButton_Click"
                            ToolTipService.ToolTip="按当前播放列表顺序开始播放">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="播放该队列" VerticalAlignment="Center" Margin="0,0,0,2" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 多选模式底部操作条 -->
                <Grid
                    x:Name="MultiSelectActionBar"
                    Grid.Row="2"
                    Padding="4,8"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <Button x:Name="MultiSelectMoreButton" Padding="12,8" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="更多操作">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="添加到我喜欢" Click="MultiSelectFavoriteButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB51;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="下载歌词" Click="MultiSelectDownloadLyricButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="下载封面" Click="MultiSelectDownloadCoverButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="编辑标签" Click="MultiSelectEditTagsButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="复制位置" Click="MultiSelectCopyPathButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="MultiSelectDeleteMenuItem" Text="从磁盘删除（回收站）"
                                                    Click="MultiSelectDeleteButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <TextBlock Text="更多" VerticalAlignment="Center" Margin="0,0,0,2" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MultiSelectPrimaryActionButton"
                            Padding="14,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="MultiSelectPrimaryActionButton_Click"
                            ToolTipService.ToolTip="将选中歌曲添加至播放队列">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="MultiSelectPrimaryActionIcon" Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Name="MultiSelectPrimaryActionText" Text="添加至播放队列" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MultiSelectAddToPlaylistButton"
                            Padding="14,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="MultiSelectAddToPlaylistButton_Click"
                            ToolTipService.ToolTip="添加到播放列表（列表墙）">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="添加到播放列表" VerticalAlignment="Center" Margin="0,0,0,2" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 播放歌曲信息页(切出时占满整个主内容区，含左侧音乐库分类栏) -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="NowPlayingPane"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    RenderTransformOrigin="0.5,0.5"
                    Visibility="Collapsed">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="NowPlayingPaneTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="16" />
                    </Border.RenderTransform>
                    <Border.Resources>
                        <!-- 景深推进：面板向前放大并上浮切入 -->
                        <Storyboard x:Name="NowPlayingDepthInStoryboard">
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPane" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="ScaleX"
                                             From="0.92" To="1" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="ScaleY"
                                             From="0.92" To="1" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="TranslateY"
                                             From="16" To="0" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                        <!-- 景深退回：面板缩小并下沉淡出 -->
                        <Storyboard x:Name="NowPlayingDepthOutStoryboard">
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPane" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="ScaleX"
                                             From="1" To="0.92" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="ScaleY"
                                             From="1" To="0.92" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="TranslateY"
                                             From="0" To="16" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Border.Resources>
                <Grid
                    x:Name="NowPlayingPaneContent"
                    Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 左上角：返回按钮（整合式，仿专辑详情页返回栏） -->
                    <Border
                        Grid.Row="0"
                        Padding="0,2,0,10"
                        Margin="0,0,0,4"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Button
                            x:Name="NowPlayingCollapseButton"
                            Width="36"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="NowPlayingCollapseButton_Click"
                            ToolTipService.ToolTip="返回音乐库">
                            <FontIcon Glyph="&#xE70D;" FontSize="13" />
                        </Button>
                    </Border>

                    <!-- 主体：左侧封面区 + 右侧滚动歌词 -->
                    <Grid
                        Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左栏：大封面 + 波形 + 歌曲信息（以封面中轴居中，文字超长换行） -->
                        <StackPanel
                            x:Name="NowPlayingLeftColumn"
                            Grid.Column="0"
                            MinWidth="320"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <CompositeTransform x:Name="NowPlayingLeftShift" ScaleX="1" ScaleY="1" />
                            </StackPanel.RenderTransform>
                            <Border
                                x:Name="NowPlayingCoverBorder"
                                Width="320"
                                Height="320"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <FontIcon
                                        Glyph="&#xE93C;"
                                        FontSize="96"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Opacity="0.55" />
                                    <Image
                                        x:Name="NowPlayingCoverImage"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <Canvas
                                x:Name="WaveformCanvas"
                                Width="320"
                                Height="40"
                                HorizontalAlignment="Center"
                                IsHitTestVisible="False"
                                SizeChanged="WaveformCanvas_SizeChanged" />

                            <StackPanel
                                x:Name="NowPlayingMetaPanel"
                                Spacing="8"
                                HorizontalAlignment="Center">
                                <TextBlock
                                    x:Name="NowPlayingTitleText"
                                    FontSize="26"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords"
                                    Text="未在播放" />
                                <!-- 歌手 / 专辑：各自一行，宽=半区-留边，超长换行 -->
                                <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">
                                    <Button
                                        x:Name="NowPlayingArtistLinkButton"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Click="NowPlayingArtistLinkButton_Click"
                                        PointerEntered="NowPlayingArtistLink_PointerEntered"
                                        PointerExited="NowPlayingArtistLink_PointerExited">
                                        <TextBlock
                                            x:Name="NowPlayingArtistText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            TextDecorations="None"
                                            TextWrapping="WrapWholeWords"
                                            Text="未知艺术家" />
                                    </Button>
                                    <Button
                                        x:Name="NowPlayingAlbumLinkButton"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Click="NowPlayingAlbumLinkButton_Click"
                                        PointerEntered="NowPlayingAlbumLink_PointerEntered"
                                        PointerExited="NowPlayingAlbumLink_PointerExited">
                                        <TextBlock
                                            x:Name="NowPlayingAlbumText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="15"
                                            TextDecorations="None"
                                            TextWrapping="WrapWholeWords"
                                            Text="未知专辑" />
                                    </Button>
                                </StackPanel>
                                <TextBlock
                                    x:Name="NowPlayingAudioInfoText"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    FontSize="11"
                                    Opacity="0.85"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords"
                                    Text="" />
                                <TextBlock
                                    x:Name="SignalChainInfoText"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    FontSize="10"
                                    Opacity="0.7"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords"
                                    Text="信号链：未初始化" />
                                <Button
                                    x:Name="DownloadLyricButton"
                                    Content="下载歌词"
                                    Click="DownloadLyricButton_Click"
                                    CornerRadius="16"
                                    MinWidth="128"
                                    Padding="16,4"
                                    HorizontalAlignment="Center"
                                    ToolTipService.ToolTip="为当前歌曲从在线平台下载歌词（Apple Music 不提供歌词：将按歌名/艺人从其他平台获取）" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 右半区：滚动歌词（由 layout 位移到 3/4 中轴，宽=半区-60，居中换行） -->
                        <Grid Grid.Column="0" x:Name="LyricsSection" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="LyricsShift" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <ScrollViewer
                                x:Name="LyricsScrollViewer"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Enabled"
                                HorizontalScrollMode="Disabled"
                                HorizontalContentAlignment="Stretch"
                                ViewChanged="LyricsScrollViewer_ViewChanged"
                                PointerWheelChanged="LyricsScrollViewer_PointerWheelChanged"
                                PointerPressed="LyricsScrollViewer_PointerPressed">
                                <StackPanel x:Name="LyricsPanel" Spacing="10" HorizontalAlignment="Stretch" />
                            </ScrollViewer>

                            <TextBlock
                                x:Name="LyricsEmptyHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Opacity="0.7"
                                Text="暂无歌词"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- 底部播放控制 -->
        <Grid
            Grid.Row="2"
            MinHeight="70"
            Margin="16,6,16,10"
            ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 正在播放封面 -->
            <Border
                x:Name="TransportCoverBorder"
                Width="58"
                Height="58"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                PointerPressed="TransportCover_PointerPressed"
                PointerEntered="TransportCover_PointerEntered"
                PointerExited="TransportCover_PointerExited"
                PointerCaptureLost="TransportCover_PointerExited">
                <Border.Resources>
                    <!-- hover 时状态条封面上浮三角箭头淡入 -->
                    <Storyboard x:Name="TransportArrowInStoryboard">
                        <DoubleAnimation Storyboard.TargetName="TransportCoverExpandHint" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="TransportCoverExpandHintTransform" Storyboard.TargetProperty="ScaleX"
                                         From="0.7" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="TransportCoverExpandHintTransform" Storyboard.TargetProperty="ScaleY"
                                         From="0.7" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="TransportCoverDimLayer" Storyboard.TargetProperty="Opacity"
                                         From="0" To="0.55" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Storyboard x:Name="TransportArrowOutStoryboard">
                        <DoubleAnimation Storyboard.TargetName="TransportCoverExpandHint" Storyboard.TargetProperty="Opacity"
                                         From="1" To="0" Duration="0:0:0.12">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="TransportCoverDimLayer" Storyboard.TargetProperty="Opacity"
                                         From="0.55" To="0" Duration="0:0:0.12">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Border.Resources>
                <Grid>
                    <FontIcon
                        Glyph="&#xE93C;"
                        FontSize="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Opacity="0.55" />
                    <Image
                        x:Name="TransportCoverImage"
                        Stretch="UniformToFill" />
                    <!-- hover 变暗层 -->
                    <Border
                        x:Name="TransportCoverDimLayer"
                        Background="#B0000000"
                        CornerRadius="6"
                        Opacity="0"
                        IsHitTestVisible="False" />
                    <!-- hover 提示：朝上三角箭头，表示可展开 -->
                    <FontIcon
                        x:Name="TransportCoverExpandHint"
                        Glyph="&#xE70E;"
                        FontSize="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,3,3,0"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <CompositeTransform x:Name="TransportCoverExpandHintTransform" ScaleX="0.7" ScaleY="0.7" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Grid>
            </Border>

            <!-- 歌曲信息 -->
            <StackPanel
                Grid.Column="1"
                MinWidth="140"
                MaxWidth="240"
                VerticalAlignment="Center"
                Spacing="4">
                <TextBlock
                    x:Name="TransportTitleText"
                    FontSize="15"
                    FontWeight="SemiBold"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Text="目前未播放音乐" />
                <TextBlock
                    x:Name="TransportArtistText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="TransportFormatText"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Opacity="0.85"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Column="2" RowSpacing="4" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0" VerticalAlignment="Center" Text="00:00" />
                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="28">
                        <Slider
                            x:Name="ProgressSlider"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Minimum="0"
                            Value="0"
                            ValueChanged="ProgressSlider_ValueChanged" />
                        <Canvas
                            x:Name="ProgressStyleCanvas"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" VerticalAlignment="Center" Text="00:00" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Center">
                        <Button
                            x:Name="PlaybackOrderButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PlaybackOrderButton_Click"
                            RightTapped="PlaybackOrderButton_RightTapped"
                            ToolTipService.ToolTip="列表循环（左键切换，右键选择）">
                            <Grid>
                                <FontIcon x:Name="PlaybackOrderIcon" Glyph="&#xE8EE;" FontSize="18" />
                                <!-- 单曲播放：上「1」下右箭头 -->
                                <StackPanel
                                    x:Name="PlaybackOrderTrackOnceGlyph"
                                    Orientation="Vertical"
                                    Spacing="-1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Text="1"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        LineHeight="11"
                                        Margin="0,1,0,0" />
                                    <FontIcon Glyph="&#xE72A;" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button
                            x:Name="PreviousButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PreviousButton_Click"
                            ToolTipService.ToolTip="上一首">
                            <FontIcon Glyph="&#xE892;" FontSize="18" />
                        </Button>
                        <Button
                            x:Name="SeekBackButton"
                            Width="36"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SeekBackButton_Click"
                            ToolTipService.ToolTip="快退 5 秒">
                            <FontIcon Glyph="&#xEB9E;" FontSize="16" />
                        </Button>
                        <Button
                            x:Name="PlayPauseButton"
                            Width="44"
                            Height="44"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PlayPauseButton_Click"
                            ToolTipService.ToolTip="播放 / 暂停">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="22" />
                        </Button>
                        <Button
                            x:Name="SeekForwardButton"
                            Width="36"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SeekForwardButton_Click"
                            ToolTipService.ToolTip="快进 5 秒">
                            <FontIcon Glyph="&#xEB9D;" FontSize="16" />
                        </Button>
                        <Button
                            x:Name="NextButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="NextButton_Click"
                            ToolTipService.ToolTip="下一首">
                            <FontIcon Glyph="&#xE893;" FontSize="18" />
                        </Button>
                        <Button
                            x:Name="PlaybackRateButton"
                            Width="56"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PlaybackRateButton_Click"
                            ToolTipService.ToolTip="播放速度">
                            <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PlaybackRateText" Text="1.0x" FontSize="13" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="FavoriteButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="FavoriteButton_Click"
                            ToolTipService.ToolTip="我喜欢的音乐">
                            <FontIcon x:Name="FavoriteButtonIcon" Glyph="&#xEB51;" FontSize="18" />
                        </Button>
                        <Button
                            x:Name="ShowCurrentPlaylistButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ShowCurrentPlaylistButton_Click"
                            ToolTipService.ToolTip="显示播放队列">
                            <FontIcon Glyph="&#xE700;" FontSize="18" />
                        </Button>
                        <Button
                            x:Name="FeaturesMoreButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="FeaturesMoreButton_Click"
                            ToolTipService.ToolTip="更多功能（均衡器 / 歌词 / AB / 转换）">
                            <FontIcon Glyph="&#xE712;" FontSize="18" />
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="MiniPlayerButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="MiniPlayerButton_Click"
                            ToolTipService.ToolTip="迷你播放器（开/关）">
                            <Grid Width="36" Height="36">
                                <FontIcon Glyph="&#xE8A9;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Padding="2,0"
                                    Margin="0,0,0,1">
                                    <TextBlock
                                        x:Name="MiniPlayerStateBadge"
                                        Text="off"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        LineHeight="9"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button
                            x:Name="DesktopLyricsButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DesktopLyricsButton_Click"
                            RightTapped="DesktopLyricsButton_RightTapped"
                            ToolTipService.ToolTip="桌面歌词（左键开/关，锁定时右键解锁）">
                            <Grid Width="36" Height="36">
                                <FontIcon
                                    x:Name="DesktopLyricsIcon"
                                    Glyph="&#xED1E;"
                                    FontSize="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Padding="2,0"
                                    Margin="0,0,0,1">
                                    <TextBlock
                                        x:Name="DesktopLyricsStateBadge"
                                        Text="off"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        LineHeight="9"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>
                        <FontIcon
                            x:Name="VolumeIcon"
                            Glyph="&#xE767;"
                            FontSize="16"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="音量" />
                        <Grid Width="140" Height="24" VerticalAlignment="Center">
                            <Slider
                                x:Name="VolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="80"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged">
                                <Slider.Template>
                                    <ControlTemplate TargetType="Slider">
                                        <Grid />
                                    </ControlTemplate>
                                </Slider.Template>
                            </Slider>
                            <Canvas x:Name="VolumeStyleCanvas" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
        <!-- 音频设置右侧滑出面板（从右边界向左延伸，仿 ECHO） -->
        <Grid
            x:Name="AudioSettingsOverlayHost"
            Grid.RowSpan="3"
            Visibility="Collapsed"
            IsHitTestVisible="False">
            <Grid.Resources>
                <Storyboard x:Name="AudioSettingsOpenStoryboard">
                    <DoubleAnimation Storyboard.TargetName="AudioSettingsPanelTransform" Storyboard.TargetProperty="TranslateX"
                                     From="360" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="AudioSettingsCloseStoryboard">
                    <DoubleAnimation Storyboard.TargetName="AudioSettingsPanelTransform" Storyboard.TargetProperty="TranslateX"
                                     From="0" To="360" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Grid x:Name="AudioSettingsScrim" Background="#66000000" Tapped="AudioSettingsScrim_Tapped" />
            <Border
                x:Name="AudioSettingsPanel"
                Width="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="AudioSettingsPanelTransform" TranslateX="360" />
                </Border.RenderTransform>
                <Grid Padding="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部标题 + 关闭 -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE95B;" FontSize="15" />
                            <TextBlock Text="音频设置" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AudioSettingsCloseButton_Click"
                            ToolTipService.ToolTip="关闭">
                            <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                        </Button>
                    </Grid>

                    <!-- 输出模式 -->
                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="输出模式" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="ModeSharedCard"
                                Grid.Column="0"
                                Height="52"
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="1"
                                Click="AudioModeCard_Click"
                                Tag="Shared"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="WASAPI 共享（系统混音）">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="共享" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="系统混音" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ModeExclusiveCard"
                                Grid.Column="1"
                                Height="52"
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="1"
                                Click="AudioModeCard_Click"
                                Tag="WasapiExclusive"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="WASAPI 独占（HiFi，bit-perfect）">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="独占" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="HiFi" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ModeAsioCard"
                                Grid.Column="2"
                                Height="52"
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="1"
                                Click="AudioModeCard_Click"
                                Tag="Asio"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="ASIO（专有声卡驱动）">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="ASIO" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="专有声卡" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ComboBox x:Name="AudioOutputDeviceCombo" HorizontalAlignment="Stretch" SelectionChanged="AudioOutputDeviceCombo_SelectionChanged" PlaceholderText="输出设备" />
                    </StackPanel>

                    <!-- 链路状态（可视化：源 → DSP → 输出） -->
                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                        <TextBlock Text="链路状态" FontSize="14" FontWeight="SemiBold" />
                        <!-- 改为纵向堆叠、每块左右扩张，保证源/输出/DSP 文字完整显示 -->
                        <StackPanel Spacing="6">
                            <Border
                                x:Name="LinkSrcCapsule"
                                CornerRadius="8"
                                Padding="10,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="源" FontSize="10" Opacity="0.7" />
                                    <TextBlock x:Name="AudioLinkSourceFmt" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="WrapWholeWords" TextTrimming="None" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="LinkDspCapsule"
                                CornerRadius="8"
                                Padding="10,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="DSP" FontSize="10" Opacity="0.7" />
                                    <TextBlock x:Name="AudioLinkDsp" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="WrapWholeWords" TextTrimming="None" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="LinkOutCapsule"
                                CornerRadius="8"
                                Padding="10,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="输出" FontSize="10" Opacity="0.7" />
                                    <TextBlock x:Name="AudioLinkOutputFmt" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="WrapWholeWords" TextTrimming="None" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模式" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioLinkMode" Grid.Column="1" Text="—" TextWrapping="WrapWholeWords" FontSize="12" />
                            <Border
                                x:Name="BitPerfectBadge"
                                Grid.Column="2"
                                CornerRadius="10"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="#222">
                                <TextBlock x:Name="AudioLinkBitPerfectBadgeText" Text="bit-perfect" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="AudioLinkBitPerfect" FontSize="12" Opacity="0.8" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <!-- 专业播放状态 -->
                    <StackPanel Grid.Row="3" Spacing="6" Margin="0,16,0,0">
                        <TextBlock Text="专业播放状态" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="会话缓冲" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioProBuffer" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DSP 链" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioProDspChain" Grid.Column="1" Text="—" TextWrapping="WrapWholeWords" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="播放位置" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioProPosition" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                    </StackPanel>

                    <!-- 底部说明 -->
                    <TextBlock
                        Grid.Row="5"
                        FontSize="12"
                        Opacity="0.55"
                        TextWrapping="WrapWholeWords"
                        Margin="0,10,0,0"
                        Text="DSP（EQ／声道／限幅／ReplayGain）参与处理时不再 bit-perfect；全部旁路且输出格式未变才可直通。" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
