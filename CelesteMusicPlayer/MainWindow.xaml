                                                </StackPanel>
                                                <Border
                                                    x:Name="DspBadgeSafety"
                                                    Grid.Column="2"
                                                    Padding="10,3"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="10"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                                    <TextBlock
                                                        x:Name="DspBadgeSafetyText"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="—" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16">
                                            <StackPanel Spacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="输出安全监控" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Opacity="0.6"
                                                        TextWrapping="WrapWholeWords"
                                                        Text="实时观察输出链：有没有削波、哪些 DSP 正在生效、当前是否仍然 bit-perfect。" />
                                                </StackPanel>
                                                <Grid ColumnSpacing="16" Padding="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="12"
                                                        Opacity="0.7"
                                                        VerticalAlignment="Center"
                                                        Text="输出峰值" />
                                                    <TextBlock
                                                        x:Name="OutMonitorPeakText"
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="WrapWholeWords"
                                                        Text="—" />
                                                </Grid>
                                                <Grid ColumnSpacing="16" Padding="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="12"
                                                        Opacity="0.7"
                                                        VerticalAlignment="Center"
                                                        Text="削波计数" />
                                                    <TextBlock
                                                        x:Name="OutMonitorClipText"
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="WrapWholeWords"
                                                        Text="0 次" />
                                                </Grid>
                                                <Grid ColumnSpacing="16" Padding="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="12"
                                                        Opacity="0.7"
                                                        VerticalAlignment="Center"
                                                        Text="过载状态" />
                                                    <TextBlock
                                                        x:Name="OutMonitorOverloadText"
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="WrapWholeWords"
                                                        Text="正常" />
                                                </Grid>
                                                <Grid ColumnSpacing="16" Padding="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="12"
                                                        Opacity="0.7"
                                                        VerticalAlignment="Center"
                                                        Text="活跃 DSP" />
                                                    <TextBlock
                                                        x:Name="OutMonitorActiveDspText"
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="WrapWholeWords"
                                                        Text="无" />
                                                </Grid>
                                                <Grid ColumnSpacing="16" Padding="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="12"
                                                        Opacity="0.7"
                                                        VerticalAlignment="Center"
                                                        Text="采样率链路" />
                                                    <TextBlock
                                                        x:Name="OutMonitorChainText"
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="WrapWholeWords"
                                                        Text="—" />
                                                </Grid>
                                                <Button
                                                    x:Name="OutMonitorResetButton"
                                                    Content="重置统计"
                                                    HorizontalAlignment="Left"
                                                    Click="OutMonitorReset_Click" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="输出链路" />
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Padding="8,6" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock FontSize="10" Opacity="0.6" Text="输入" />
                                                            <TextBlock x:Name="DspChainInputText" FontSize="11" FontWeight="SemiBold" Text="—" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.4" Text="→" />
                                                    <Border Grid.Column="2" Padding="8,6" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock FontSize="10" Opacity="0.6" Text="余量" />
                                                            <TextBlock x:Name="DspChainHeadroomText" FontSize="11" FontWeight="SemiBold" Text="—" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Opacity="0.4" Text="→" />
                                                    <Border Grid.Column="4" Padding="8,6" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock FontSize="10" Opacity="0.6" Text="处理" />
                                                            <TextBlock x:Name="DspChainProcessText" FontSize="11" FontWeight="SemiBold" TextWrapping="WrapWholeWords" Text="—" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Opacity="0.4" Text="→" />
                                                    <Border Grid.Column="6" Padding="8,6" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock FontSize="10" Opacity="0.6" Text="输出" />
                                                            <TextBlock x:Name="DspChainOutputText" FontSize="11" FontWeight="SemiBold" Text="—" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 播放列表：保存 / 打开 / 清空 / 播放（仅播放列表界面显示） -->
                <Grid
                    x:Name="UserPlaylistActionBar"
                    Grid.Row="2"
                    Padding="4,8"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button
                            x:Name="SavePlaylistButton"
                            Height="32"
                            Padding="14,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Content="保存为新的播放列表"
                            Click="SavePlaylistButton_Click"
                            ToolTipService.ToolTip="把当前队列保存为新播放列表" />
                        <Button
                            x:Name="OpenPlaylistButton"
                            Height="32"
                            Padding="14,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Content="添加到播放列表"
                            Click="OpenPlaylistButton_Click"
                            ToolTipService.ToolTip="把当前队列添加到播放列表（列表墙）" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button
                            x:Name="ClearPlaylistButton"
                            Height="32"
                            Padding="14,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Content="清空当前队列"
                            Click="ClearPlaylistButton_Click"
                            ToolTipService.ToolTip="清空当前播放队列" />
                        <Button
                            x:Name="PlayUserPlaylistButton"
                            Height="32"
                            Padding="14,0"
                            CornerRadius="16"
                            BorderThickness="0"
                            Click="PlayUserPlaylistButton_Click"
                            ToolTipService.ToolTip="按当前播放列表顺序开始播放">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="播放该队列" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 多选模式底部操作条 -->
                <Grid
                    x:Name="MultiSelectActionBar"
                    Grid.Row="2"
                    Padding="4,8"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <Button x:Name="MultiSelectMoreButton" Padding="12,8" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="更多操作">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="添加到我喜欢" Click="MultiSelectFavoriteButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB51;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="下载歌词" Click="MultiSelectDownloadLyricButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="下载封面" Click="MultiSelectDownloadCoverButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="编辑标签" Click="MultiSelectEditTagsButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="复制位置" Click="MultiSelectCopyPathButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="MultiSelectDeleteMenuItem" Text="从磁盘删除（回收站）"
                                                    Click="MultiSelectDeleteButton_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <TextBlock Text="更多" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MultiSelectPrimaryActionButton"
                            Padding="14,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="MultiSelectPrimaryActionButton_Click"
                            ToolTipService.ToolTip="将选中歌曲添加至播放队列">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="MultiSelectPrimaryActionIcon" Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Name="MultiSelectPrimaryActionText" Text="添加至播放队列" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MultiSelectAddToPlaylistButton"
                            Padding="14,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="MultiSelectAddToPlaylistButton_Click"
                            ToolTipService.ToolTip="添加到播放列表（列表墙）">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="添加到播放列表" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 播放歌曲信息页(切出时占满整个主内容区，含左侧音乐库分类栏) -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="NowPlayingPane"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12"
                    RenderTransformOrigin="0.5,0.5"
                    Visibility="Collapsed">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="NowPlayingPaneTransform" ScaleX="0.92" ScaleY="0.92" TranslateY="16" />
                    </Border.RenderTransform>
                    <Border.Resources>
                        <!-- 景深推进：面板向前放大并上浮切入 -->
                        <Storyboard x:Name="NowPlayingDepthInStoryboard">
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPane" Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="ScaleX"
                                             From="0.92" To="1" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="ScaleY"
                                             From="0.92" To="1" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="TranslateY"
                                             From="16" To="0" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                        <!-- 景深退回：面板缩小并下沉淡出 -->
                        <Storyboard x:Name="NowPlayingDepthOutStoryboard">
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPane" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="ScaleX"
                                             From="1" To="0.92" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="ScaleY"
                                             From="1" To="0.92" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NowPlayingPaneTransform" Storyboard.TargetProperty="TranslateY"
                                             From="0" To="16" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Border.Resources>
                <Grid
                    x:Name="NowPlayingPaneContent"
                    Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ⚠️ 这里曾经加过一层「播放页自己的背景图 + 压暗层」，用户反馈像
                         「在主程序上加了一块板子」，已移除。背景统一走整窗的
                         AlbumArtBackgroundImage（见 ApplyAlbumArtBackgroundAsync），别再加回来。 -->

                    <!-- 左上角：返回按钮（整合式，仿专辑详情页返回栏） -->
                    <!-- 左上角：返回按钮（整合式，仿专辑详情页返回栏）
                         ⚠️ 这里以前有一条 BorderThickness="0,0,0,1" 的分割线，横跨整个面板宽度，
                         视觉上像一条压在专辑封面上的细线 —— 用户要求去掉，别再加回来。 -->
                    <Border
                        Grid.Row="0"
                        Padding="0,2,0,10"
                        Margin="0,0,0,4"
                        BorderThickness="0">
                        <Grid>
                            <Button
                                x:Name="NowPlayingCollapseButton"
                                Width="36"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="NowPlayingCollapseButton_Click"
                                ToolTipService.ToolTip="返回音乐库">
                                <FontIcon Glyph="&#xE70D;" FontSize="13" />
                            </Button>
                            <!-- 播放页：可视化元素 + 布局切换（页内即时切换，不打断播放） -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                <Button
                                    x:Name="NowPlayingVisualButton"
                                    Height="32"
                                    Padding="10,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="切换播放页的可视化元素">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="NowPlayingVisualButtonText" Text="可视化：波形" FontSize="12" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <!-- 菜单项在代码里按「当前布局的可用清单」动态生成（见 RebuildVisualFlyout）：
                                             该布局用不了的档位直接不出现，避免点了没反应。 -->
                                        <MenuFlyout x:Name="NowPlayingVisualFlyout" Placement="BottomEdgeAlignedRight" />
                                    </Button.Flyout>
                                </Button>
                                <Button
                                    x:Name="NowPlayingLayoutButton"
                                    Height="32"
                                    Padding="10,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="切换播放页布局">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="NowPlayingLayoutButtonText" Text="布局：经典" FontSize="12" VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <!-- 菜单项在代码里动态生成（见 RebuildLayoutFlyout）：
                                         「终端」布局属于极客 UI，只有开了极客模式才列出来。 -->
                                    <MenuFlyout x:Name="NowPlayingLayoutFlyout" Placement="BottomEdgeAlignedRight" />
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 主体：三块（封面列 / 信息块 / 歌词块）都是 NowPlayingBody 的直接子元素，
                         靠 Grid.Row/Column + 对齐在「经典」「水面」间切换，不重新挂接控件。
                         经典：封面+信息叠在左侧居中、歌词在右半区；
                         水面：封面在左下居中、信息在右上、歌词在右下。 -->
                    <Grid
                        x:Name="NowPlayingBody"
                        Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <!-- 第三列：只有「剧场」三栏布局会用到（由 UpdateNowPlayingBodyColumns 在代码里给宽度）。
                                 平时宽度 0，完全不占位，其它布局不受任何影响。 -->
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>

                        <!-- 黑胶布局：唱机（旋转唱片 + 唱臂）。仅「黑胶」布局显示，其它布局 Collapsed。
                             盘面尺寸 / 标签尺寸 / 唱臂长度由 UpdateNowPlayingCardLayout 按面板大小设置。
                             旋转用 Storyboard（放在资源里、按 x:Key 取），暂停用 Pause() 而不是 Stop()，
                             这样唱片会停在当前角度，再播放时从原处继续转（跟真唱机一样）。 -->
                        <Grid
                            x:Name="VinylStage"
                            Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Grid.Resources>
                                <Storyboard x:Key="VinylSpinStoryboard">
                                    <DoubleAnimation
                                        Storyboard.TargetName="VinylDiscRotate"
                                        Storyboard.TargetProperty="Angle"
                                        From="0"
                                        To="360"
                                        Duration="0:0:7"
                                        RepeatBehavior="Forever" />
                                </Storyboard>
                                <Storyboard x:Key="VinylArmDownStoryboard">
                                    <DoubleAnimation
                                        Storyboard.TargetName="VinylArmRotate"
                                        Storyboard.TargetProperty="Angle"
                                        To="27"
                                        Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                                <Storyboard x:Key="VinylArmUpStoryboard">
                                    <DoubleAnimation
                                        Storyboard.TargetName="VinylArmRotate"
                                        Storyboard.TargetProperty="Angle"
                                        To="0"
                                        Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </Grid.Resources>

                            <!-- 唱盘（整体旋转） -->
                            <Grid
                                x:Name="VinylDisc"
                                Width="320"
                                Height="320"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="VinylDiscRotate" Angle="0" />
                                </Grid.RenderTransform>
                                <Ellipse x:Name="VinylPlate">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF1C1C21" Offset="0" />
                                            <GradientStop Color="#FF0B0B0D" Offset="0.5" />
                                            <GradientStop Color="#FF25252B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- 纹路：几圈极淡的同心圆，纯装饰 -->
                                <Ellipse Margin="12" Stroke="#1FFFFFFF" StrokeThickness="1" />
                                <Ellipse Margin="24" Stroke="#16FFFFFF" StrokeThickness="1" />
                                <Ellipse Margin="37" Stroke="#12FFFFFF" StrokeThickness="1" />
                                <Ellipse Margin="51" Stroke="#0FFFFFFF" StrokeThickness="1" />
                                <Ellipse Margin="66" Stroke="#0CFFFFFF" StrokeThickness="1" />
                                <!-- 中心标签 = 专辑封面（圆形，跟真唱片的标签一样） -->
                                <Ellipse
                                    x:Name="VinylArtEllipse"
                                    Width="126"
                                    Height="126"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <!-- 中心孔 -->
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="#FF08080A" />
                            </Grid>

                            <!-- 径向频谱：只画在黑胶唱盘外圈（可视化「径向」档）。
                                 必须放在 VinylStage 里、不能放进 VinylDisc 内 —— 唱盘整体带旋转动画，
                                 画布跟进去会跟着一起转。画布尺寸由 UpdateVinylGeometry 按唱盘大小设置。 -->
                            <Canvas
                                x:Name="RadialVisualCanvas"
                                Width="400"
                                Height="400"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />

                            <!-- 唱臂：支点在右端，播放时落下搭到盘上，暂停时抬起 -->
                            <Grid
                                x:Name="VinylTonearm"
                                Width="170"
                                Height="26"
                                Margin="0,8,-8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                RenderTransformOrigin="1,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="VinylArmRotate" Angle="0" />
                                </Grid.RenderTransform>
                                <!-- 支点座 -->
                                <Ellipse
                                    Width="26"
                                    Height="26"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Fill="#FF5A5F66" />
                                <!-- 臂杆 -->
                                <Rectangle
                                    Width="134"
                                    Height="6"
                                    RadiusX="3"
                                    RadiusY="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="#FFB9BEC6" />
                                <!-- 唱头 -->
                                <Rectangle
                                    Width="30"
                                    Height="15"
                                    Margin="118,0,0,0"
                                    RadiusX="3"
                                    RadiusY="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="#FF7C828B" />
                            </Grid>
                        </Grid>

                        <!-- 封面列：封面 + 水面倒影 + 波形（始终在左列） -->
                        <StackPanel
                            x:Name="NowPlayingCoverColumn"
                            Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Border
                                x:Name="NowPlayingCoverBorder"
                                Width="320"
                                Height="320"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <FontIcon
                                        Glyph="&#xE958;"
                                        FontSize="96"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Opacity="0.55" />
                                    <Image
                                        x:Name="NowPlayingCoverImage"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 水面倒影（仅「水面」布局显示；经典保持 Collapsed）。
                                 镜像与渐隐已在 CPU 侧烤进贴图（见 NowPlayingReflection.cs）：
                                 WinUI 3 的 UIElement 没有 OpacityMask，无法用遮罩做渐隐。
                                 Margin 的 -10 用于抵消上方 StackPanel 的 Spacing=10，让倒影紧贴封面底边。
                                 注意 Image 必须用 UniformToFill（不能 Uniform）：容器高度是"贴图高 × 比例"，
                                 通常带小数（如 90.23），在 UseLayoutRounding 下会被取整成 90，
                                 此时 Uniform 会按高度等比缩放，渲染宽度只有约 418.9（左右各露 0.5px 透明边，
                                 高 DPI 下就是 1~2 个物理像素的"缺缝"）。UniformToFill 保证横向铺满，
                                 0.2px 级的纵向裁切发生在渐隐尾部，完全不可见。 -->
                            <Grid
                                x:Name="NowPlayingCoverReflection"
                                HorizontalAlignment="Center"
                                Margin="0,-10,0,0"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <Image
                                    x:Name="NowPlayingCoverReflectionImage"
                                    Stretch="UniformToFill"
                                    VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>

                        <!-- 波形：经典在左侧封面列下方；水面改到右侧歌曲信息下方（带倒影、拉长）。
                             它是 NowPlayingBody 的直接子元素，由 UpdateNowPlayingCardLayout 按布局定位。 -->
                        <Canvas
                            x:Name="WaveformCanvas"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Height="40"
                            IsHitTestVisible="False"
                            SizeChanged="WaveformCanvas_SizeChanged" />

                        <!-- 信息块：标题 / 歌手 / 专辑 / 技术信息（经典在封面下方，水面在右上） -->
                        <StackPanel
                            x:Name="NowPlayingMetaPanel"
                            Grid.Column="1"
                            Grid.Row="0"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="NowPlayingTitleText"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords"
                                Text="未在播放" />
                            <!-- 歌手 / 专辑：各自一行，宽=半区-留边，超长换行 -->
                            <StackPanel x:Name="NowPlayingArtistAlbumRow" Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">
                                <Button
                                    x:Name="NowPlayingArtistLinkButton"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Click="NowPlayingArtistLinkButton_Click"
                                    PointerEntered="NowPlayingArtistLink_PointerEntered"
                                    PointerExited="NowPlayingArtistLink_PointerExited">
                                    <TextBlock
                                        x:Name="NowPlayingArtistText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        TextDecorations="None"
                                        TextWrapping="WrapWholeWords"
                                        Text="未知艺术家" />
                                </Button>
                                <Button
                                    x:Name="NowPlayingAlbumLinkButton"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Click="NowPlayingAlbumLinkButton_Click"
                                    PointerEntered="NowPlayingAlbumLink_PointerEntered"
                                    PointerExited="NowPlayingAlbumLink_PointerExited">
                                    <TextBlock
                                        x:Name="NowPlayingAlbumText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="15"
                                        TextDecorations="None"
                                        TextWrapping="WrapWholeWords"
                                        Text="未知专辑" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                x:Name="NowPlayingAudioInfoText"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                FontSize="11"
                                Opacity="0.85"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords"
                                Text="" />
                            <!-- bit-perfect 徽章：播放详情页不需要（非直通时会撑成一长条），默认隐藏。
                                 想看链路状态去「音频设置 → 音频链路」面板。 -->
                            <Border
                                x:Name="MainBitPerfectBadge"
                                CornerRadius="10"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Background="#222"
                                ToolTipService.ToolTip="当前播放链路是否 bit-perfect 直通（与音频设置面板口径一致）">
                                <TextBlock x:Name="MainBitPerfectText" Text="bit-perfect" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <TextBlock
                                x:Name="SignalChainInfoText"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                FontSize="10"
                                Opacity="0.7"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords"
                                Text="信号链：未初始化" />
                        </StackPanel>

                        <!-- 歌词块（经典在右半区，水面在右下） -->
                        <Grid
                            x:Name="LyricsSection"
                            Grid.Column="1"
                            Grid.Row="1"
                            RenderTransformOrigin="0.5,0.5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="LyricsShift" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <ScrollViewer
                                x:Name="LyricsScrollViewer"
                                VerticalScrollBarVisibility="Hidden"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Enabled"
                                HorizontalScrollMode="Disabled"
                                HorizontalContentAlignment="Stretch"
                                ViewChanged="LyricsScrollViewer_ViewChanged"
                                PointerWheelChanged="LyricsScrollViewer_PointerWheelChanged"
                                PointerPressed="LyricsScrollViewer_PointerPressed">
                                <StackPanel x:Name="LyricsPanel" Spacing="10" HorizontalAlignment="Stretch" />
                            </ScrollViewer>

                                <TextBlock
                                    x:Name="LyricsEmptyHint"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Opacity="0.7"
                                    Text="暂无歌词"
                                    Visibility="Collapsed" />
                        </Grid>

                        <!-- 极客「终端」布局：一整块独立面板（固定近黑底 + 等宽字），只在 Terminal 布局显示。
                             三栏：左 = 音频流/信号链/文件；中 = 方块频谱 + 电平 + 峰值；右 = 相位图 + 状态；
                             底部 = 播放头方块条 + 队列预览。
                             强调色的元素（表头 / 频谱柱 / 电平条 / 相位线 / 播放头 / 当前曲目）不在这里写死，
                             由 ApplyTerminalAccent 按应用强调色刷一遍，换主题会跟着变。
                             底部 Margin 92 是给页内控制条让位。 -->
                        <Border
                            x:Name="TerminalStage"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="24,8,24,92"
                            Padding="18,14"
                            Background="#F50B0C10"
                            BorderThickness="0"
                            CornerRadius="0"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 表头 -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock
                                        x:Name="TerminalHeaderText"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        Text="CELESTE // AUDIO TERMINAL" />
                                    <TextBlock
                                        x:Name="TerminalStatusText"
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="#FF7A8290"
                                        Text="STOPPED   00:00 / 00:00" />
                                </Grid>

                                <!-- 三栏 -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1.9*" />
                                        <ColumnDefinition Width="0.95*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左：音频流 / 信号链 / 文件 -->
                                    <ScrollViewer
                                        Grid.Column="0"
                                        Margin="0,0,18,0"
                                        VerticalScrollBarVisibility="Hidden"
                                        HorizontalScrollMode="Disabled">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="#FF7A8290"
                                                Text="AUDIO STREAM" />
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="FORMAT" />
                                                <TextBlock x:Name="TerminalFormatText" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="#FFD7DAE0" Text="—" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="OUTPUT" />
                                                <TextBlock x:Name="TerminalOutputText" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="#FFD7DAE0" Text="—" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="MODE" />
                                                <TextBlock x:Name="TerminalModeText" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="#FFD7DAE0" Text="—" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="DSP" />
                                                <TextBlock x:Name="TerminalDspText" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="#FFD7DAE0" Text="—" />
                                            </Grid>

                                            <TextBlock
                                                Margin="0,14,0,6"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="#FF7A8290"
                                                Text="SIGNAL CHAIN" />
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="SRC" />
                                                <TextBlock x:Name="TerminalSrcText" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="#FFD7DAE0" Text="—" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="OUT" />
                                                <TextBlock x:Name="TerminalOutText" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="#FFD7DAE0" Text="—" TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <TextBlock
                                                Margin="0,14,0,6"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="#FF7A8290"
                                                Text="FILE" />
                                            <TextBlock
                                                x:Name="TerminalPathText"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="#FF9AA2AE"
                                                Text="—"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="当前曲目路径" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- 中：方块频谱 + 电平 + 峰值 -->
                                    <Grid Grid.Column="1" Margin="0,0,18,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="0,0,0,6"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="#FF7A8290"
                                            Text="SPECTRUM" />
                                        <Canvas
                                            x:Name="TerminalSpectrumCanvas"
                                            Grid.Row="1"
                                            MinHeight="90"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            SizeChanged="TerminalCanvas_SizeChanged" />
                                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="#FF7A8290"
                                                Text="LEVEL" />
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="68" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="L" />
                                                <Border x:Name="TerminalLevelLTrack" Grid.Column="1" Height="7" Background="#FF22252B" CornerRadius="2">
                                                    <Border x:Name="TerminalLevelLFill" Width="0" HorizontalAlignment="Left" Background="#FF5DCAA5" CornerRadius="2" />
                                                </Border>
                                                <TextBlock x:Name="TerminalLevelLText" Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11" Foreground="#FFD7DAE0" Text="-inf dB" />
                                            </Grid>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="68" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="R" />
                                                <Border x:Name="TerminalLevelRTrack" Grid.Column="1" Height="7" Background="#FF22252B" CornerRadius="2">
                                                    <Border x:Name="TerminalLevelRFill" Width="0" HorizontalAlignment="Left" Background="#FF5DCAA5" CornerRadius="2" />
                                                </Border>
                                                <TextBlock x:Name="TerminalLevelRText" Grid.Column="2" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11" Foreground="#FFD7DAE0" Text="-inf dB" />
                                            </Grid>
                                            <TextBlock
                                                Margin="0,12,0,6"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Foreground="#FF7A8290"
                                                Text="PEAK" />
                                            <TextBlock
                                                x:Name="TerminalPeakText"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="#FFD7DAE0"
                                                Text="L — / R —" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 右：相位图 + 状态 -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="#FF7A8290"
                                            Text="PHASE" />
                                        <Border
                                            x:Name="TerminalPhaseBorder"
                                            Height="240"
                                            Background="#FF14161B"
                                            BorderBrush="#FF2A2D34"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Canvas
                                                x:Name="TerminalPhaseCanvas"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="220"
                                                Height="220" />
                                        </Border>
                                        <TextBlock
                                            Margin="0,14,0,6"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="#FF7A8290"
                                            Text="STATE" />
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="PLAYBACK" />
                                            <TextBlock x:Name="TerminalPlaybackText" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="#FFD7DAE0" Text="STOPPED" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="#FF7A8290" Text="DEVICE" />
                                            <TextBlock x:Name="TerminalDeviceText" Grid.Column="1" FontFamily="Consolas" FontSize="12" Foreground="#FFD7DAE0" Text="系统默认" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- 底部：播放头 + 队列 -->
                                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#FF7A8290"
                                        Text="PLAYHEAD" />
                                    <Canvas
                                        x:Name="TerminalPlayheadCanvas"
                                        Height="10"
                                        HorizontalAlignment="Stretch"
                                        SizeChanged="TerminalCanvas_SizeChanged"
                                        Margin="0,0,0,12" />
                                    <TextBlock
                                        x:Name="TerminalQueueHeader"
                                        Margin="0,0,0,6"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="#FF7A8290"
                                        Text="QUEUE" />
                                    <StackPanel x:Name="TerminalQueuePanel" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 页内控制条：水面布局内嵌在波形下方（常显）；经典为亚克力悬浮条（闲置淡出）。
                             一行布局：左侧三个按钮（上一首/播放暂停/下一首），右侧进度条 + 时间。
                             宽度由 UpdateNowPlayingCardLayout 设置为与波形图一致。 -->
                        <Grid
                            x:Name="NowPlayingFloatingBar"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            MaxWidth="680"
                            Padding="16,10"
                            Visibility="Collapsed"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            PointerEntered="NowPlayingFloatingBar_PointerEntered">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 左：三个按钮 -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0" VerticalAlignment="Center">
                                    <Button x:Name="FloatingPrevButton" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" Click="PreviousButton_Click" ToolTipService.ToolTip="上一首">
                                        <FontIcon Glyph="&#xE892;" FontSize="18" />
                                    </Button>
                                    <Button x:Name="FloatingPlayPauseButton" Width="44" Height="44" Padding="0" Background="Transparent" BorderThickness="0" Click="PlayPauseButton_Click" ToolTipService.ToolTip="播放 / 暂停">
                                        <FontIcon x:Name="FloatingPlayPauseIcon" Glyph="&#xE768;" FontSize="22" />
                                    </Button>
                                    <Button x:Name="FloatingNextButton" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" Click="NextButton_Click" ToolTipService.ToolTip="下一首">
                                        <FontIcon Glyph="&#xE893;" FontSize="18" />
                                    </Button>
                                </StackPanel>
                                <!-- 右：当前时间 + 进度条 + 总时间 -->
                                <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FloatingCurrentTime" Grid.Column="0" VerticalAlignment="Center" Text="00:00" FontSize="12" />
                                    <!-- 指针事件不写在 XAML：Slider 内部会把 PointerPressed/Released 标成
                                         Handled，XAML 挂的处理器默认收不到 → _isUserSeeking 永远为 false，
                                         拖动不生效、松手后进度又跳回原位。改由代码 AddHandler(handledEventsToo:true) 挂接。 -->
                                    <Slider
                                        x:Name="NowPlayingProgressSlider"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="0"
                                        ValueChanged="NowPlayingProgressSlider_ValueChanged" />
                                    <TextBlock x:Name="FloatingTotalTime" Grid.Column="2" VerticalAlignment="Center" Text="00:00" FontSize="12" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- 底部播放控制 -->
        <Grid
            x:Name="BottomTransportBar"
            Grid.Row="2"
            MinHeight="70"
            Margin="16,6,16,10"
            ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 正在播放封面 -->
            <Border
                x:Name="TransportCoverBorder"
                Width="58"
                Height="58"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                PointerPressed="TransportCover_PointerPressed"
                PointerEntered="TransportCover_PointerEntered"
                PointerExited="TransportCover_PointerExited"
                PointerCaptureLost="TransportCover_PointerExited">
                <Border.Resources>
                    <!-- hover 时状态条封面上浮三角箭头淡入 -->
                    <Storyboard x:Name="TransportArrowInStoryboard">
                        <DoubleAnimation Storyboard.TargetName="TransportCoverExpandHint" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="TransportCoverExpandHintTransform" Storyboard.TargetProperty="ScaleX"
                                         From="0.7" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="TransportCoverExpandHintTransform" Storyboard.TargetProperty="ScaleY"
                                         From="0.7" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="TransportCoverDimLayer" Storyboard.TargetProperty="Opacity"
                                         From="0" To="0.55" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                    <Storyboard x:Name="TransportArrowOutStoryboard">
                        <DoubleAnimation Storyboard.TargetName="TransportCoverExpandHint" Storyboard.TargetProperty="Opacity"
                                         From="1" To="0" Duration="0:0:0.12">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="TransportCoverDimLayer" Storyboard.TargetProperty="Opacity"
                                         From="0.55" To="0" Duration="0:0:0.12">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Border.Resources>
                <Grid>
                    <FontIcon
                        Glyph="&#xE958;"
                        FontSize="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Opacity="0.55" />
                    <Image
                        x:Name="TransportCoverImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                    <!-- hover 变暗层 -->
                    <Border
                        x:Name="TransportCoverDimLayer"
                        Background="#B0000000"
                        CornerRadius="6"
                        Opacity="0"
                        IsHitTestVisible="False" />
                    <!-- hover 提示：朝上三角箭头，表示可展开 -->
                    <FontIcon
                        x:Name="TransportCoverExpandHint"
                        Glyph="&#xE70E;"
                        FontSize="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,3,3,0"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <CompositeTransform x:Name="TransportCoverExpandHintTransform" ScaleX="0.7" ScaleY="0.7" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Grid>
            </Border>

            <!-- 歌曲信息 -->
            <StackPanel
                Grid.Column="1"
                MinWidth="140"
                MaxWidth="240"
                VerticalAlignment="Center"
                Spacing="4">
                <TextBlock
                    x:Name="TransportTitleText"
                    FontSize="15"
                    FontWeight="SemiBold"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Text="目前未播放音乐" />
                <TextBlock
                    x:Name="TransportArtistText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="TransportFormatText"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Opacity="0.85"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Column="2" RowSpacing="4" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CurrentTimeText" Grid.Column="0" VerticalAlignment="Center" Text="00:00" />
                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="28">
                        <Slider
                            x:Name="ProgressSlider"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Minimum="0"
                            Value="0"
                            ValueChanged="ProgressSlider_ValueChanged" />
                        <Canvas
                            x:Name="ProgressStyleCanvas"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="TotalTimeText" Grid.Column="2" VerticalAlignment="Center" Text="00:00" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Center">
                        <Button
                            x:Name="PlaybackOrderButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PlaybackOrderButton_Click"
                            RightTapped="PlaybackOrderButton_RightTapped"
                            ToolTipService.ToolTip="列表循环（左键切换，右键选择）">
                            <Grid>
                                <FontIcon x:Name="PlaybackOrderIcon" Glyph="&#xE8EE;" FontSize="18" />
                                <!-- 单曲播放：上「1」下右箭头 -->
                                <StackPanel
                                    x:Name="PlaybackOrderTrackOnceGlyph"
                                    Orientation="Vertical"
                                    Spacing="-1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Text="1"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        LineHeight="11"
                                        Margin="0,1,0,0" />
                                    <FontIcon Glyph="&#xE72A;" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button
                            x:Name="PreviousButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PreviousButton_Click"
                            ToolTipService.ToolTip="上一首">
                            <FontIcon Glyph="&#xE892;" FontSize="18" />
                        </Button>
                        <Button
                            x:Name="SeekBackButton"
                            Width="36"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SeekBackButton_Click"
                            ToolTipService.ToolTip="快退 5 秒">
                            <FontIcon Glyph="&#xEB9E;" FontSize="16" />
                        </Button>
                        <Button
                            x:Name="PlayPauseButton"
                            Width="44"
                            Height="44"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PlayPauseButton_Click"
                            ToolTipService.ToolTip="播放 / 暂停">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="22" />
                        </Button>
                        <Button
                            x:Name="SeekForwardButton"
                            Width="36"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SeekForwardButton_Click"
                            ToolTipService.ToolTip="快进 5 秒">
                            <FontIcon Glyph="&#xEB9D;" FontSize="16" />
                        </Button>
                        <Button
                            x:Name="NextButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="NextButton_Click"
                            ToolTipService.ToolTip="下一首">
                            <FontIcon Glyph="&#xE893;" FontSize="18" />
                        </Button>
                        <Button
                            x:Name="PlaybackRateButton"
                            Width="56"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PlaybackRateButton_Click"
                            ToolTipService.ToolTip="播放速度">
                            <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PlaybackRateText" Text="1.0x" FontSize="13" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="FavoriteButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="FavoriteButton_Click"
                            ToolTipService.ToolTip="我喜欢的音乐">
                            <FontIcon x:Name="FavoriteButtonIcon" Glyph="&#xEB51;" FontSize="18" />
                        </Button>
                        <Button
                            x:Name="ShowCurrentPlaylistButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ShowCurrentPlaylistButton_Click"
                            ToolTipService.ToolTip="显示播放队列">
                            <FontIcon Glyph="&#xE7B3;" FontSize="18" />
                        </Button>
                        <Button
                            x:Name="FeaturesMoreButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="FeaturesMoreButton_Click"
                            ToolTipService.ToolTip="更多功能（均衡器 / 歌词 / AB / 转换）">
                            <FontIcon Glyph="&#xE712;" FontSize="18" />
                        </Button>
                        <Button
                            x:Name="AddToLibraryButton"
                            Height="32"
                            Padding="12,0"
                            Margin="6,0,0,0"
                            CornerRadius="16"
                            Visibility="Collapsed"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddToLibraryButton_Click"
                            ToolTipService.ToolTip="把当前播放的这首歌加入音乐库">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="AddToLibraryIcon" Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Name="AddToLibraryText" Text="添加到音乐库" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="MiniPlayerButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="MiniPlayerButton_Click"
                            ToolTipService.ToolTip="迷你播放器（开/关）">
                            <Grid Width="36" Height="36">
                                <FontIcon Glyph="&#xE8A9;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Padding="2,0"
                                    Margin="0,0,0,1">
                                    <TextBlock
                                        x:Name="MiniPlayerStateBadge"
                                        Text="off"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        LineHeight="9"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button
                            x:Name="DesktopLyricsButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DesktopLyricsButton_Click"
                            RightTapped="DesktopLyricsButton_RightTapped"
                            ToolTipService.ToolTip="桌面歌词（左键开/关，锁定时右键解锁）">
                            <Grid Width="36" Height="36">
                                <FontIcon
                                    x:Name="DesktopLyricsIcon"
                                    Glyph="&#xED1E;"
                                    FontSize="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Border
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Padding="2,0"
                                    Margin="0,0,0,1">
                                    <TextBlock
                                        x:Name="DesktopLyricsStateBadge"
                                        Text="off"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        LineHeight="9"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>
                        <!-- 实时电平表：每声道一根竖条（左→右 = 各声道），条子由代码动态生成 -->
                        <StackPanel
                            x:Name="LevelMeterPanel"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="实时电平（post-DSP）：细线=峰值，粗条=RMS；绿色正常，橙黄接近 0dBFS，红色满刻度" />
                        <FontIcon
                            x:Name="VolumeIcon"
                            Glyph="&#xE767;"
                            FontSize="16"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="音量" />
                        <Grid Width="140" Height="24" VerticalAlignment="Center">
                            <Slider
                                x:Name="VolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged">
                                <Slider.Template>
                                    <ControlTemplate TargetType="Slider">
                                        <Grid />
                                    </ControlTemplate>
                                </Slider.Template>
                            </Slider>
                            <Canvas x:Name="VolumeStyleCanvas" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
        <!-- 音频设置右侧滑出面板（从右边界向左延伸，仿 ECHO） -->
        <Grid
            x:Name="AudioSettingsOverlayHost"
            Grid.RowSpan="3"
            Visibility="Collapsed"
            IsHitTestVisible="False">
            <Grid.Resources>
                <Storyboard x:Name="AudioSettingsOpenStoryboard">
                    <DoubleAnimation Storyboard.TargetName="AudioSettingsPanelTransform" Storyboard.TargetProperty="TranslateX"
                                     From="360" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="AudioSettingsCloseStoryboard">
                    <DoubleAnimation Storyboard.TargetName="AudioSettingsPanelTransform" Storyboard.TargetProperty="TranslateX"
                                     From="0" To="360" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>
            <Grid x:Name="AudioSettingsScrim" Background="#66000000" Tapped="AudioSettingsScrim_Tapped" />
            <Border
                x:Name="AudioSettingsPanel"
                Width="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="AudioSettingsPanelTransform" TranslateX="360" />
                </Border.RenderTransform>
                <Grid Padding="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部标题 + 关闭 -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE91F;" FontSize="15" />
                            <TextBlock Text="音频设置" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="AudioSettingsCloseButton_Click"
                            ToolTipService.ToolTip="关闭">
                            <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                        </Button>
                    </Grid>

                    <!-- 内容区（窗口变小时可滚动，避免被裁剪） -->
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Visible"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,8,0"
                        Margin="0,0,-8,0">
                        <StackPanel>

                    <!-- 输出模式 -->
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="输出模式" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="ModeSharedCard"
                                Grid.Column="0"
                                Height="52"
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="1"
                                Click="AudioModeCard_Click"
                                Tag="Shared"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="WASAPI 共享（系统混音）">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="共享" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="系统混音" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ModeExclusiveCard"
                                Grid.Column="1"
                                Height="52"
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="1"
                                Click="AudioModeCard_Click"
                                Tag="WasapiExclusive"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="WASAPI 独占（HiFi，bit-perfect）">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="独占" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="HiFi" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ModeAsioCard"
                                Grid.Column="2"
                                Height="52"
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="1"
                                Click="AudioModeCard_Click"
                                Tag="Asio"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="ASIO（专有声卡驱动）">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="ASIO" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="专有声卡" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ComboBox x:Name="AudioOutputDeviceCombo" HorizontalAlignment="Stretch" SelectionChanged="AudioOutputDeviceCombo_SelectionChanged" PlaceholderText="输出设备" />
                        <!-- ASIO 卡顿排查提醒：2026-09-24 KA13 实测定案——驱动缓冲 5.8ms + USB 电源管理=几秒一次卡；
                             选中 ASIO 模式时常显（RefreshAudioSettingsPanel 控制显隐） -->
                        <TextBlock x:Name="AsioBufferTipText"
                                   FontSize="11"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,6,0,0"
                                   Text="ASIO 播放卡顿（几秒一次、不规律）先查两处：① 打开耳放/声卡的控制面板（如「FiiO USB Audio Control Panel」，开始菜单搜品牌名），把 ASIO Buffer Size 调到 10ms 以上；② 控制面板→电源选项→更改计划设置→更改高级电源设置，关闭「USB 选择性暂停」和「PCI Express 链接状态电源管理」并重启。本播放器已内置 4 秒备货缓冲，若仍卡，基本就是这两项。" />
                        <!-- 热插拔提示：设备拔插时短暂显示，10 秒后自动收起 -->
                        <TextBlock x:Name="AudioDeviceHotplugText"
                                   FontSize="11"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,4,0,0" />
                        <!-- 按设备记忆 DSP 配置档 -->
                        <StackPanel Spacing="6" Margin="0,10,0,0">
                            <ToggleSwitch
                                x:Name="DeviceDspMemoryToggle"
                                Header="按设备记忆 DSP 配置"
                                OffContent="关"
                                OnContent="开"
                                Toggled="DeviceDspMemoryToggle_Toggled" />
                            <TextBlock
                                x:Name="DeviceDspHint"
                                FontSize="11"
                                Opacity="0.75"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="SaveDeviceDspButton"
                                Content="保存当前配置为当前设备"
                                Click="SaveDeviceDspButton_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 链路状态（可视化：源 → DSP → 输出） -->
                    <StackPanel Spacing="8" Margin="0,16,0,0">
                        <TextBlock Text="链路状态" FontSize="14" FontWeight="SemiBold" />
                        <!-- 改为纵向堆叠、每块左右扩张，保证源/输出/DSP 文字完整显示 -->
                        <StackPanel Spacing="6">
                            <Border
                                x:Name="LinkSrcCapsule"
                                CornerRadius="8"
                                Padding="10,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="源" FontSize="10" Opacity="0.7" />
                                    <!-- 两行各说各话：源文件真实格式（探测值） / 实际送链路的转码 WAV（WAV 头） -->
                                    <TextBlock x:Name="AudioLinkSourceFmt" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="WrapWholeWords" TextTrimming="None" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Name="AudioLinkTranscodeWavFmt" Text="" FontFamily="Consolas" FontSize="11" Opacity="0.85" TextWrapping="WrapWholeWords" TextTrimming="None" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="LinkDspCapsule"
                                CornerRadius="8"
                                Padding="10,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="DSP" FontSize="10" Opacity="0.7" />
                                    <TextBlock x:Name="AudioLinkDsp" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="WrapWholeWords" TextTrimming="None" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="LinkOutCapsule"
                                CornerRadius="8"
                                Padding="10,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="输出" FontSize="10" Opacity="0.7" />
                                    <!-- 两行：设备端实际格式（结构化协商值） / 结论（源直通·数值有损·重采样·待确认） -->
                                    <TextBlock x:Name="AudioLinkOutputFmt" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="WrapWholeWords" TextTrimming="None" HorizontalAlignment="Stretch" />
                                    <TextBlock x:Name="AudioLinkOutputVerdict" Text="" FontFamily="Consolas" FontSize="11" Opacity="0.85" TextWrapping="WrapWholeWords" TextTrimming="None" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模式" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioLinkMode" Grid.Column="1" Text="—" TextWrapping="WrapWholeWords" FontSize="12" />
                            <Border
                                x:Name="BitPerfectBadge"
                                Grid.Column="2"
                                CornerRadius="10"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="#222">
                                <TextBlock x:Name="AudioLinkBitPerfectBadgeText" Text="bit-perfect" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="AudioLinkBitPerfect" FontSize="12" Opacity="0.8" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <!-- 专业播放状态 -->
                    <StackPanel Spacing="6" Margin="0,16,0,0">
                        <TextBlock Text="专业播放状态" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="会话缓冲" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioProBuffer" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DSP 链" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioProDspChain" Grid.Column="1" Text="—" TextWrapping="WrapWholeWords" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="播放位置" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioProPosition" Grid.Column="1" Text="—" FontFamily="Consolas" FontSize="12" />
                        </Grid>
                    </StackPanel>

                    <!-- 交叉淡化 -->
                    <StackPanel Spacing="8" Margin="0,16,0,0" VerticalAlignment="Top">
                        <TextBlock Text="交叉淡化" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="时长" Opacity="0.7" VerticalAlignment="Center" />
                            <Slider
                                x:Name="CrossfadeSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="12"
                                StepFrequency="0.5"
                                Value="0"
                                VerticalAlignment="Center"
                                ValueChanged="CrossfadeSlider_ValueChanged" />
                            <TextBlock
                                x:Name="CrossfadeValueText"
                                Grid.Column="2"
                                Text="关闭"
                                FontSize="12"
                                VerticalAlignment="Center"
                                MinWidth="58" />
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            Text="仅在自动连续播放时生效（手动切歌不淡化）。需下一首已预加载且格式相同，否则自动退回无缝硬切。" />


                        <!-- 输出缓冲区 -->
                        <StackPanel Spacing="8" Margin="0,16,0,0">
                            <TextBlock Text="输出缓冲区" FontSize="14" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="缓冲时长" Opacity="0.7" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="OutputBufferCombo"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    SelectionChanged="OutputBufferCombo_SelectionChanged" />
                                <TextBlock
                                    x:Name="OutputBufferHintText"
                                    Grid.Column="2"
                                    Text="推荐"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    MinWidth="58" />
                            </Grid>
                            <TextBlock
                                FontSize="12"
                                Opacity="0.6"
                                TextWrapping="WrapWholeWords"
                                Text="缓冲越大越不容易卡顿、爆音；缓冲越小声音越跟手。播放中有爆音/断续就调大，觉得拖沓就调小。改动在下一首歌开始时生效。" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 独占输出内核（三选一试验田：自研托管渲染线程 / ECHO C++ / 自研原生内核） -->
                    <StackPanel Spacing="8" Margin="0,16,0,0">
                        <TextBlock Text="独占输出内核" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="EngineSelfCard"
                                Grid.Column="0"
                                Height="52"
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="1"
                                Click="ExclusiveEngineCard_Click"
                                Tag="self"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="自研：C# 托管渲染线程（默认，全功能）">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="自研" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="默认 / 全功能" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="EngineEchoCard"
                                Grid.Column="1"
                                Height="52"
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="1"
                                Click="ExclusiveEngineCard_Click"
                                Tag="echo"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="ECHO 核心：C++ 原生渲染线程（实验，抗卡顿；不支持 DSD/DoP）">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="ECHO 核心" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="实验 / 抗卡顿" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="EngineNative2Card"
                                Grid.Column="2"
                                Height="52"
                                Padding="0"
                                CornerRadius="8"
                                BorderThickness="1"
                                Click="ExclusiveEngineCard_Click"
                                Tag="native2"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="原生内核：C++ 原生渲染线程 + 整数字节直喂（实验，抗卡顿且字节级 bit-perfect；不支持 DSD/DoP）">
                                <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="原生内核" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="实验 / 字节直通" FontSize="10" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            Text="切换渲染线程的实现：自研是 C# 线程（系统回收内存时可能把它冻一下，偶发卡顿）；ECHO 核心与原生内核把渲染搬进 C++ 原生线程（冻不到它），音频数据仍来自同一套链路。原生内核的 feeder 直接送整数字节给设备（不过 float），DSP 全关时端到端 bit-perfect。改动下一首歌生效。DSD 由整轨预加载播放，实测原生内核最佳；ECHO 内核不负责 DSD/DoP，用它播 DSD 时界面会提醒切换。" />
                        <Grid ColumnSpacing="8" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="EngineSelfTestButton"
                                Grid.Column="0"
                                Content="播放测试音（3 秒 1kHz）"
                                Click="EngineSelfTest_Click"
                                ToolTipService.ToolTip="用内存生成的正弦波走完整播放链路试听，不进音乐库。先在上面选好内核再点。" />
                            <TextBlock
                                x:Name="EngineSelfTestStatus"
                                Grid.Column="1"
                                FontSize="12"
                                Opacity="0.7"
                                VerticalAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </StackPanel>

                    <!-- 底部说明 -->
                    <TextBlock
                        FontSize="12"
                        Opacity="0.55"
                        TextWrapping="WrapWholeWords"
                        Margin="0,10,0,0"
                        Text="DSP（EQ／声道／限幅／ReplayGain）参与处理时不再 bit-perfect；全部旁路且输出格式未变才可直通。" />

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- DSD×ECHO 内核提醒卡（2026-09-24 用户定案）：echo 内核不负责 DSD，
             EchoCoreOutput.Init 显式拒绝 requireExact；用户用 echo 播 DSD 时左上角提醒切 native2。
             自带一键切换 + 15s 自动收起；RootShell 最后一个子节点=渲染最顶层。 -->
        <Border
            x:Name="DsdEngineTipCard"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="16,64,0,0"
            MaxWidth="430"
            Padding="12,10"
            CornerRadius="8"
            Visibility="Collapsed"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    Glyph="&#xE7BA;"
                    FontSize="16"
                    Foreground="Orange"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock
                        x:Name="DsdEngineTipText"
                        FontSize="12"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="DsdEngineTipSwitch"
                            Content="一键切换到原生内核"
                            FontSize="12"
                            Click="DsdEngineTipSwitch_Click" />
                        <Button
                            x:Name="DsdEngineTipClose"
                            Content="知道了"
                            FontSize="12"
                            Click="DsdEngineTipClose_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>


