<?xml version="1.0" encoding="utf-8"?>
<!--
    DspRackWindow.xaml —— ECHO DSP 机架设置窗口（Stage C 新增）。
    内容：处理顺序（8 模块）+ 压缩器（含实时压缩量表）+ 立体声场 + 声道矩阵
    + Crossfeed 截止频率。滑杆为草稿态，点「应用」才提交；模块电源开关立即生效。
    窗口模式对齐 EqualizerWindow：单例 + Applied 事件 + 毛玻璃/主题随设置。
-->
<Window
    x:Class="CelesteMusicPlayer.DspRackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DSP 机架">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9E9;" FontSize="16" />
                <TextBlock Text="DSP 机架" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="24,8,24,24"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">

                <!-- 顶部说明 + bit-perfect 徽标（徽标只看本页三个模块，口径同 IsActive） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="ECHO DSP 机架" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                Text="调整 8 个模块的处理顺序，以及压缩器 / 立体声场 / 声道矩阵 / Crossfeed 截止频率。滑杆与顺序为草稿态，点底部「应用」才写入并生效；模块电源开关立即生效。"
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <Border
                            x:Name="RackBitPerfectBadge"
                            Grid.Column="1"
                            CornerRadius="10"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="#3B6D11">
                            <TextBlock
                                x:Name="RackBitPerfectText"
                                Text="默认直通"
                                FontSize="12"
                                FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 处理顺序 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="处理顺序" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock
                            Text="信号按从上到下的顺序经过各模块。顺序会影响结果，例如压缩器放在均衡器之前 / 之后，声音有可闻差别。未启用的模块自动跳过。"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel x:Name="RackOrderPanel" Spacing="4" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RackOrderDefaultButton"
                                Content="恢复默认顺序"
                                Click="RackOrderDefaultButton_Click" />
                        </StackPanel>
                        <TextBlock
                            Text="默认顺序（ECHO）：参数 EQ → 卷积（房间校正）→ ReplayGain → 压缩器 → Crossfeed → 立体声场 → 声道矩阵 → 声道平衡。"
                            FontSize="11"
                            Opacity="0.55"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <!-- 压缩器 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="压缩器" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="自动压低超过阈值的响亮部分，让整体音量更平均。适度使用可增现场感；开过头声音会发闷、有呼吸感。"
                                    FontSize="12"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="CompressorToggle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                OnContent="开"
                                OffContent="关"
                                Toggled="CompressorToggle_Toggled" />
                        </Grid>

                        <!-- 实时压缩量（GR）：250ms 轮询内核；无引擎（未播放）时显示为「无」 -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="实时压缩量" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                            <ProgressBar
                                x:Name="CompGrBar"
                                Grid.Column="1"
                                Maximum="24"
                                Minimum="0"
                                Height="6"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="CompGrText"
                                Grid.Column="2"
                                Text="--"
                                FontFamily="Consolas"
                                FontSize="12"
                                VerticalAlignment="Center"
                                MinWidth="72" />
                        </Grid>

                        <StackPanel x:Name="CompressorSliders" Spacing="6" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="CompDefaultButton"
                                Content="恢复默认参数"
                                Click="CompDefaultButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 立体声场 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="立体声场" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="在中置 / 侧向（M/S）域调整：宽度大于 1 声场更开阔，小于 1 更收拢；中置增益影响人声与居中乐器，侧向增益影响空间感。"
                                    FontSize="12"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="StereoFieldToggle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                OnContent="开"
                                OffContent="关"
                                Toggled="StereoFieldToggle_Toggled" />
                        </Grid>
                        <StackPanel x:Name="StereoFieldSliders" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- 声道矩阵 -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="声道矩阵" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="用 2×2 系数自由混合左右声道：输出 = 系数 × 输入。可做交换、反相、单声道化等一切线性变换；改完记得留余量防削波。"
                                    FontSize="12"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="MatrixToggle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                OnContent="开"
                                OffContent="关"
                                Toggled="MatrixToggle_Toggled" />
                        </Grid>
                        <StackPanel x:Name="MatrixSliders" Spacing="6" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="MatrixPresetPassButton"
                                Content="直通"
                                ToolTipService.ToolTip="单位矩阵：左右原样输出"
                                Click="MatrixPresetButton_Click"
                                Tag="pass" />
                            <Button
                                x:Name="MatrixPresetSwapButton"
                                Content="左右交换"
                                ToolTipService.ToolTip="左右互换（线材接反的补救）"
                                Click="MatrixPresetButton_Click"
                                Tag="swap" />
                            <Button
                                x:Name="MatrixPresetMonoButton"
                                Content="等增益单声道"
                                ToolTipService.ToolTip="左右各取一半求和，总音量不变"
                                Click="MatrixPresetButton_Click"
                                Tag="mono" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Crossfeed 截止频率（开关与强度在「音效处理 → 声道」页） -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Crossfeed 截止频率" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Crossfeed 把对侧声道经低通后混入本侧，模拟扬声器串扰，缓解耳机「头中定位」。低通截止越低越接近音箱听感、越高越保留耳机原始质感。开关与强度在「音效处理 → 声道工具」页调整，此处只改截止频率。"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords" />
                        <Slider
                            x:Name="CrossfeedCutoffSlider"
                            Minimum="100"
                            Maximum="4000"
                            StepFrequency="10"
                            Value="700"
                            VerticalAlignment="Center"
                            ValueChanged="CrossfeedCutoffSlider_ValueChanged" />
                        <TextBlock
                            x:Name="CrossfeedCutoffValue"
                            Text="700 Hz"
                            FontFamily="Consolas"
                            FontSize="12"
                            Opacity="0.8" />
                    </StackPanel>
                </Border>

                <!-- 底部操作 -->
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12">
                    <Button x:Name="ApplyButton" Content="应用" Click="ApplyButton_Click" MinWidth="88" />
                    <Button x:Name="ResetButton" Content="重置" Click="ResetButton_Click" MinWidth="88" />
                    <Button x:Name="CloseButton" Content="关闭" Click="CloseButton_Click" MinWidth="88" />
                </StackPanel>

                <TextBlock
                    Text="徽标只代表本页三个模块（压缩器 / 立体声场 / 声道矩阵）是否在处理信号；EQ、ReplayGain、房间校正、声道工具等模块的状态见各自页面与音频设置面板的链路摘要。"
                    FontSize="11"
                    Opacity="0.55"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
