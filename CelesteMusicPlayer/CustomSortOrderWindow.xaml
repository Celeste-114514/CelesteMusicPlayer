<Window
    x:Class="CelesteMusicPlayer.CustomSortOrderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="自定义排序">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                <TextBlock Text="自定义排序" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,6,20,16">
            <StackPanel Spacing="18" MaxWidth="640" HorizontalAlignment="Left">

                <!-- 说明 -->
                <TextBlock Text="按顺序选择 1–5 个元数据标签字段（先选先排），每个字段可设为升序或降序。" TextWrapping="WrapWholeWords" Opacity="0.7" FontSize="13" />

                <!-- 排序规则分组 -->
                <StackPanel Spacing="12" x:Name="SortGrid" />

                <!-- 整体升降序 -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="整体排序方向" />
                        <TextBlock Text="对上面整条排序链整体升序或降序（最终一次排序方向）" FontSize="12" Opacity="0.65" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleButton x:Name="GlobalAscButton" Content="升序" IsChecked="True" Click="GlobalOrderChanged" MinWidth="72" />
                        <ToggleButton x:Name="GlobalDescButton" Content="降序" Click="GlobalOrderChanged" MinWidth="72" />
                    </StackPanel>
                </Grid>

                <!-- 底部操作 -->
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" Padding="18,6" Click="CancelButton_Click" />
                    <Button x:Name="ApplyButton" Content="应用" Padding="18,6" Click="ApplyButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
