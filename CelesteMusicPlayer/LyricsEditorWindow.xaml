<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.LyricsEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="歌词编辑">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                <TextBlock Text="歌词编辑" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,8,24,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="AudioPathText"
                FontSize="12"
                Opacity="0.55"
                TextWrapping="WrapWholeWords" />
            <TextBox
                x:Name="LyricsTextBox"
                Grid.Row="1"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                FontFamily="Consolas"
                PlaceholderText="LRC 歌词内容…" />
        </Grid>

        <StackPanel
            Grid.Row="2"
            Padding="24,8,24,24"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="12">
            <Button x:Name="ShiftEarlierButton" Content="提前0.5秒" Click="ShiftEarlierButton_Click" MinWidth="100" />
            <Button x:Name="ShiftLaterButton" Content="延后0.5秒" Click="ShiftLaterButton_Click" MinWidth="100" />
            <Button x:Name="SaveLrcButton" Content="保存到同名.lrc" Click="SaveLrcButton_Click" MinWidth="130" />
            <Button x:Name="EmbedButton" Content="嵌入到音频" Click="EmbedButton_Click" MinWidth="110" />
            <Button x:Name="CloseButton" Content="关闭" Click="CloseButton_Click" MinWidth="88" />
        </StackPanel>
    </Grid>
</Window>
