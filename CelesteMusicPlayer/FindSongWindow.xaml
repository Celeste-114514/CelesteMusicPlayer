<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.FindSongWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    Title="查找歌曲">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="16" />
                <TextBlock Text="查找歌曲" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,8,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                PlaceholderText="搜索标题、艺术家、专辑或路径…"
                TextChanged="SearchBox_TextChanged" />
            <Button
                x:Name="PlayButton"
                Grid.Column="1"
                Content="播放"
                Click="PlayButton_Click"
                MinWidth="88" />
        </Grid>

        <ListView
            x:Name="ResultsList"
            Grid.Row="2"
            Padding="24,0,24,8"
            SelectionMode="Single"
            DoubleTapped="ResultsList_DoubleTapped"
            RightTapped="ResultsList_RightTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FindSongHit">
                    <Grid Padding="4,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="120" />
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="2*" MinWidth="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Artist}" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Album}" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                        <TextBlock Grid.Column="3" Text="{x:Bind FilePath}" TextTrimming="CharacterEllipsis" FontSize="12" Opacity="0.55" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Padding="24,0,24,16"
            FontSize="12"
            Opacity="0.55"
            Text="双击或点击「播放」开始播放" />
    </Grid>
</Window>
