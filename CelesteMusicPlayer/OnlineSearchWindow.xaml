<Window
    x:Class="CelesteMusicPlayer.OnlineSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（与其他窗口一致） -->
        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="16" />
                <TextBlock Text="在线搜索" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="14" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- 顶部：搜索卡片 -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefault}"
                CornerRadius="10" Padding="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SourceCombo" Width="140" SelectionChanged="SourceCombo_SelectionChanged" />
                <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="输入歌名 / 歌手 / 专辑…"
                         KeyDown="SearchBox_KeyDown" VerticalContentAlignment="Center" />
                <Button x:Name="SearchButton" Grid.Column="2" Content="搜索"
                        Style="{StaticResource AccentButtonStyle}" Click="SearchButton_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="12" Opacity="0.7" />

        <!-- 主体：左侧搜索结果 / 右侧详情 -->
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="ResultList" SelectionChanged="ResultList_SelectionChanged" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:OnlineSearchItem">
                        <Grid ColumnSpacing="10" Padding="2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="6" VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondary}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Display}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondary}"
                                    CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Platform}" FontSize="11" Opacity="0.75" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 详情：封面 + 信息 + 操作 -->
                <Grid Grid.Row="0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="140" Height="140" CornerRadius="10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="1"
                            Background="{ThemeResource SubtleFillColorSecondary}">
                        <Image x:Name="CoverPreview" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                        <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailArtist" FontSize="13" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailAlbum" FontSize="12" Opacity="0.55"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button x:Name="WebPlayButton" Content="在网页播放" Click="WebPlayButton_Click" />
                            <Button x:Name="DownloadLyricButton" Content="下载歌词" Click="DownloadLyric_Click" />
                            <Button x:Name="DownloadCoverButton" Content="下载封面" Click="DownloadCover_Click" />
                            <Button x:Name="DownloadAudioButton" Content="下载音频" Click="DownloadAudio_Click" ToolTipService.ToolTip="网易云 / QQ 下载 128kbps MP3；Apple Music 不提供音频下载" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 歌词预览卡片 -->
                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefault}"
                        CornerRadius="10" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LyricPreview" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" FontSize="13"
                                 PlaceholderText="选中搜索结果后，在此预览歌词…" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Grid>
</Window>
