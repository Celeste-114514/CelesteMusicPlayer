<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.TagSortGroupFieldsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="自定义分组字段">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏（与设置面板一致） -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                <TextBlock Text="自定义分组字段" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 内容：左右两栏卡片（可用字段 / 分组层级） -->
        <Grid Grid.Row="1" Padding="16,8,16,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：可用字段（点击添加到右侧层级） -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Text="可用字段（点击添加到右侧层级）"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8" />
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        MaxHeight="460">
                        <StackPanel x:Name="AvailablePanel" Spacing="4" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右：当前嵌套层级顺序 -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Text="分组层级（从上到下嵌套）"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8" />
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        MaxHeight="460">
                        <StackPanel x:Name="OrderPanel" Spacing="6" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作（主按钮用强调色，与设置面板一致） -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="10"
            HorizontalAlignment="Right"
            Padding="16,10">
            <Button Content="恢复默认" Padding="14,6" Click="ResetButton_Click" />
            <Button x:Name="CancelButton" Content="取消" Padding="18,6" Click="CancelButton_Click" />
            <Button x:Name="ApplyButton" Content="应用" Padding="18,6" Click="ApplyButton_Click" Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
