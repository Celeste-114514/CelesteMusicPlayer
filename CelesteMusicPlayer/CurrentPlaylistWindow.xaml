<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.CurrentPlaylistWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    Title="播放队列">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：三横图标 + 当前播放列表 -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="12,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center"
                Padding="4,0,8,0">
                <FontIcon Glyph="&#xE700;" FontSize="16" Opacity="0.95" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Opacity="0.9"
                    Text="播放队列" />
            </StackPanel>
        </Grid>

        <!-- 工具栏：普通 = 搜索 + 更改排序；多选 = 返回 + 选择歌曲 + 全选 -->
        <Grid
            Grid.Row="1"
            Padding="12,4,12,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="MultiSelectTitlePanel"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Button
                    x:Name="ExitMultiSelectButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ExitMultiSelectButton_Click"
                    ToolTipService.ToolTip="退出多选">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="选择歌曲" />
                <Button
                    x:Name="SelectAllMultiSelectButton"
                    Height="32"
                    Padding="10,0"
                    CornerRadius="8"
                    BorderThickness="0"
                    Click="SelectAllMultiSelectButton_Click"
                    ToolTipService.ToolTip="全选 / 取消全选">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="SelectAllMultiSelectIcon" Glyph="&#xE739;" FontSize="14" />
                        <TextBlock Text="全选" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <local:StableIBeamTextBox
                x:Name="PlaylistSearchBox"
                Grid.Column="1"
                MinWidth="120"
                MaxWidth="360"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                PlaceholderText="搜索标题、艺术家、专辑、年份"
                TextChanged="PlaylistSearchBox_TextChanged" />

            <Button
                x:Name="ChangeSortButton"
                Grid.Column="2"
                Height="32"
                Padding="14,0"
                CornerRadius="16"
                BorderThickness="0"
                VerticalAlignment="Center"
                Content="更改排序"
                Click="ChangeSortButton_Click"
                ToolTipService.ToolTip="按字段重新排序当前列表（会打乱原有顺序）" />
        </Grid>

        <Grid Grid.Row="2" Padding="12,0,12,8" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="PlaylistHeaderGrid"
                Grid.Row="0"
                Height="40"
                Margin="4,4,4,4"
                ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" MinWidth="48" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" MinWidth="48" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" MinWidth="48" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="56" MinWidth="40" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="64" MinWidth="40" />
                    <ColumnDefinition Width="12" MinWidth="12" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="HeaderTitleChip"
                    Grid.Column="0"
                    Height="32"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    CornerRadius="16"
                    BorderThickness="0">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="标题" />
                </Border>
                <Border
                    x:Name="HeaderArtistChip"
                    Grid.Column="2"
                    Height="32"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    CornerRadius="16"
                    BorderThickness="0">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="艺术家" />
                </Border>
                <Border
                    x:Name="HeaderAlbumChip"
                    Grid.Column="4"
                    Height="32"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    CornerRadius="16"
                    BorderThickness="0">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="专辑" />
                </Border>
                <Border
                    x:Name="HeaderYearChip"
                    Grid.Column="6"
                    Height="32"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    CornerRadius="16"
                    BorderThickness="0">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="年份" />
                </Border>
                <Border
                    x:Name="HeaderDurationChip"
                    Grid.Column="8"
                    Height="32"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    CornerRadius="16"
                    BorderThickness="0">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="时长" />
                </Border>
            </Grid>

            <ListView
                x:Name="PlaylistView"
                Grid.Row="1"
                DoubleTapped="PlaylistView_DoubleTapped"
                RightTapped="PlaylistView_RightTapped"
                SelectionChanged="PlaylistView_SelectionChanged"
                ContainerContentChanging="PlaylistView_ContainerContentChanging"
                SelectionMode="Single"
                HorizontalContentAlignment="Stretch"
                IsMultiSelectCheckBoxEnabled="False"
                CanDragItems="True"
                CanReorderItems="True"
                AllowDrop="True"
                DragItemsCompleted="PlaylistView_DragItemsCompleted">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PlaylistItem">
                        <Border
                            Tag="SongRowChrome"
                            MinHeight="40"
                            CornerRadius="8"
                            Padding="12,0"
                            VerticalAlignment="Stretch"
                            Background="Transparent">
                            <Grid VerticalAlignment="Center" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Opacity="0.45"
                                    FontSize="12"
                                    Text="{x:Bind Index}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Title}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Opacity="0.85"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Artist}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Opacity="0.85"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Album}" />
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Opacity="0.85"
                                    Text="{x:Bind YearText}" />
                                <TextBlock
                                    Grid.Column="5"
                                    VerticalAlignment="Center"
                                    Opacity="0.85"
                                    Text="{x:Bind DurationText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 普通操作条 -->
        <Grid
            x:Name="PlaylistActionBar"
            Grid.Row="3"
            Padding="12,8,12,12">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <Button
                    x:Name="SavePlaylistButton"
                    Height="32"
                    Padding="14,0"
                    CornerRadius="16"
                    BorderThickness="0"
                    Content="保存播放列表"
                    Click="SavePlaylistButton_Click"
                    ToolTipService.ToolTip="保存到软件根目录 PlayList 文件夹" />
                <Button
                    x:Name="OpenPlaylistButton"
                    Height="32"
                    Padding="14,0"
                    CornerRadius="16"
                    BorderThickness="0"
                    Content="打开播放列表"
                    Click="OpenPlaylistButton_Click"
                    ToolTipService.ToolTip="从 PlayList 文件夹选择并加载" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button
                    x:Name="ClearPlaylistButton"
                    Height="32"
                    Padding="14,0"
                    CornerRadius="16"
                    BorderThickness="0"
                    Content="清空列表"
                    Click="ClearPlaylistButton_Click"
                    ToolTipService.ToolTip="清空当前播放列表" />
                <Button
                    x:Name="PlayUserPlaylistButton"
                    Height="32"
                    Padding="14,0"
                    CornerRadius="16"
                    BorderThickness="0"
                    Click="PlayUserPlaylistButton_Click"
                    ToolTipService.ToolTip="按当前播放列表顺序开始播放">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="播放该列表" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 多选操作条 -->
        <Grid
            x:Name="MultiSelectActionBar"
            Grid.Row="3"
            Padding="12,8,12,12"
            Visibility="Collapsed">
            <Button
                x:Name="MultiSelectDeleteButton"
                HorizontalAlignment="Right"
                Padding="14,8"
                Background="Transparent"
                BorderThickness="0"
                Click="MultiSelectDeleteButton_Click"
                ToolTipService.ToolTip="将选中歌曲从播放列表移除">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="从播放列表中删除" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
