<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
本地 F5 会导入本文件：切勿在此写 WindowsPackageType=None，否则无法生成 AppxManifest（DEP1560）。
默认（不传 CelesteSelfContainedDistribute）= 框架依赖发布（体积小，目标机需装 .NET 9 + Windows App SDK 运行时）。
自包含（整夹发给别人）请用：dotnet publish -c Release -p:Platform=x64 -r win-x64 -p:CelesteSelfContainedDistribute=true
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>$(CelesteSelfContainedDistribute)</SelfContained>
    <PublishSingleFile>False</PublishSingleFile>
  </PropertyGroup>
</Project>
