<Window
    x:Class="CelesteMusicPlayer.RoomCorrectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Margin="0,20,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold">🏠 房间校正（卷积 FIR）</TextBlock>
            <TextBlock Opacity="0.65" FontSize="12" TextWrapping="WrapWholeWords" TextAlignment="Center"
                       Text="导入测量得到的脉冲响应（IR）WAV 文件做真卷积处理。区别于参数 EQ，卷积能还原真实房间/音箱/耳机脉冲响应。请在「音频设置/音效处理」面板或耳机校正旁找到入口，本次窗口也可设置后即生效。" />
        </StackPanel>

        <!-- 主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- 脉冲响应文件 -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold">脉冲响应（IR）文件</TextBlock>
                        <TextBox x:Name="IrPathTextBox" PlaceholderText="选择 .wav 格式的脉冲响应文件…" IsReadOnly="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BrowseButton" Content="浏览…" Click="BrowseButton_Click" />
                            <Button x:Name="ClearButton" Content="清除" Click="ClearButton_Click" />
                            <TextBlock x:Name="IrInfoText" VerticalAlignment="Center" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                        <TextBlock x:Name="IrLoadStatusText" FontSize="12" Opacity="0.8" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <!-- 启用 + 增益 -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <ToggleSwitch x:Name="EnabledToggle" Header="启用卷积处理" OnContent="已启用" OffContent="已关闭"
                                      Toggled="EnabledToggle_Toggled" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="输出增益" VerticalAlignment="Center" />
                            <Slider x:Name="GainSlider" Width="200" Minimum="-12" Maximum="12"
                                    StepFrequency="0.5" ValueChanged="GainSlider_ValueChanged" />
                            <TextBlock x:Name="GainValueText" VerticalAlignment="Center" Width="60" />
                        </StackPanel>
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="WrapWholeWords"
                                   Text="提示：卷积会引入约 1024 帧（约 5~23ms，视采样率）的处理延迟。启用后输出非 bit-perfect。" />
                    </StackPanel>
                </Border>

                <!-- 示例说明 -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold">IR 文件格式</TextBlock>
                        <TextBlock FontSize="12" Opacity="0.75" TextWrapping="WrapWholeWords"
                                   Text="· 支持 16/24/32-bit 整数或 IEEE Float 的 PCM WAV，采样率自动重采样到当前输出。&#10;· 通常使用音箱/房间的测量脉冲（如 REW 导出的 .wav）。&#10;· 单声道 IR 会应用到左右声道；多声道 IR 按声道对应卷积。" />
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="WrapWholeWords"
                                   Text="没有 IR 文件？可用单个采样 '1' 的 WAV 做直通测试；或用参数 EQ（耳机校正 OPRA / 均衡器）替代校正。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部动作 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Content="应用" Style="{StaticResource AccentButtonStyle}" Click="ApplyButton_Click" />
            <Button x:Name="CloseButton" Content="关闭" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
