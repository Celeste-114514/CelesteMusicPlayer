<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.ArtistAvatarEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="编辑艺术家头像">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.7"
                Text="拖动移动图片，滚轮缩放；圆内为最终头像" />

            <Grid
                x:Name="CropViewport"
                Width="280"
                Height="280"
                HorizontalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                PointerPressed="CropViewport_PointerPressed"
                PointerMoved="CropViewport_PointerMoved"
                PointerReleased="CropViewport_PointerReleased"
                PointerCaptureLost="CropViewport_PointerCaptureLost"
                PointerWheelChanged="CropViewport_PointerWheelChanged">
                <!-- 用 Canvas + 显式宽高摆图，避免 Image 在固定格子里只露出中间一块 -->
                <Canvas x:Name="ImageCanvas" Width="280" Height="280">
                    <Image
                        x:Name="EditImage"
                        Stretch="Fill"
                        IsHitTestVisible="False" />
                </Canvas>

                <Path
                    x:Name="MaskPath"
                    Fill="{ThemeResource LayerFillColorDefaultBrush}"
                    IsHitTestVisible="False"
                    Data="M0,0 H280 V280 H0 Z M140,0 A140,140 0 1 0 140,280 A140,140 0 1 0 140,0 Z" />

                <Ellipse
                    x:Name="RingEllipse"
                    Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                    StrokeThickness="2"
                    IsHitTestVisible="False" />
            </Grid>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="12">
            <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click" MinWidth="88" />
            <Button x:Name="ConfirmButton" Content="确认" Click="ConfirmButton_Click" MinWidth="88" />
        </StackPanel>
    </Grid>
</Window>
