<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.TagEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="编辑标签">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D2;" FontSize="16" />
                <TextBlock Text="编辑标签" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="24,8,24,24"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Stretch">
                <TextBlock
                    x:Name="FilePathText"
                    FontSize="12"
                    Opacity="0.55"
                    TextWrapping="WrapWholeWords" />

                <TextBlock
                    x:Name="BatchHintText"
                    FontSize="12"
                    Opacity="0.75"
                    Text="批量模式：留空的字段将不修改，仅应用到所有选中歌曲"
                    Visibility="Collapsed"
                    TextWrapping="WrapWholeWords" />

                <TextBox x:Name="TitleBox" Header="标题" />
                <TextBox x:Name="ArtistBox" Header="艺术家" />
                <TextBox x:Name="AlbumBox" Header="专辑" />
                <TextBox x:Name="AlbumArtistBox" Header="专辑艺术家" />

                <TextBox x:Name="YearBox" Header="年份" />
                <TextBox x:Name="TrackBox" Header="曲目号" />

                <TextBox x:Name="GenreBox" Header="流派" />
                <TextBox x:Name="CommentBox" Header="注释" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />

                <TextBox
                    x:Name="LyricsBox"
                    Header="歌词"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="120" />

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,8,0,0">
                    <Button x:Name="FillFromFileNameButton" Content="从文件名填充" Click="FillFromFileNameButton_Click" MinWidth="120" />
                    <Button x:Name="SaveButton" Content="保存" Click="SaveButton_Click" MinWidth="88" />
                    <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click" MinWidth="88" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
