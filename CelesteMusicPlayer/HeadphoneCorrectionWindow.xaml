<Window
    x:Class="CelesteMusicPlayer.HeadphoneCorrectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（与其他窗口一致） -->
        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                <TextBlock Text="耳机校正 · OPRA" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="14" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 搜索卡片 -->
            <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="10" Padding="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="输入耳机品牌 / 型号，如 Sennheiser HD 600、Sony WH-1000XM5…"
                             VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown" />
                    <Button x:Name="SearchButton" Grid.Column="1" Content="搜索"
                            Style="{StaticResource AccentButtonStyle}" Click="SearchButton_Click" />
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="12" Opacity="0.7" Text="尚未加载 OPRA 数据库" />
            <TextBlock x:Name="SearchStatusText" Grid.Row="1" Margin="0,16,0,0" FontSize="11" Opacity="0.6" />

            <!-- 主体：左结果 / 右详情 -->
            <Grid Grid.Row="2" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <ListView x:Name="ResultList" SelectionMode="Single" ItemClick="ResultList_ItemClick"
                          IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:OpraSearchResult">
                            <Grid Padding="2,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind VendorName}" FontSize="12" Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind EqCount}" FontSize="11" Opacity="0.55"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="DetailSubTitle" FontSize="12" Opacity="0.65" TextWrapping="WrapWholeWords" />

                    <TextBlock Text="选择校正曲线" FontSize="13" FontWeight="SemiBold" />
                    <ListView x:Name="EqList" MaxHeight="220" SelectionMode="Single" IsItemClickEnabled="True"
                              ItemClick="EqList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:OpraProductEqSummary">
                                <Grid Padding="2,6">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{x:Bind Author}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind EqCountLabel}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="EqDetailText" FontSize="12" Opacity="0.7" TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="EqStatusText" FontSize="12" Opacity="0.75" TextWrapping="WrapWholeWords" />

                    <Button x:Name="EqApplyButton" Content="应用该曲线到均衡器" HorizontalAlignment="Left"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="EqApplyButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
