<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CelesteMusicPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- 关闭 ListView / GridView 选中勾；本应用用主题色背景表示选中 -->
            <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
            <x:Boolean x:Key="GridViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>

            <!-- 全局字体回退：西文用 Segoe UI Variable，中文回退到微软雅黑 UI，
                 修复 Segoe UI 缺中文字形时个别汉字（如「复」）走异常瘦长回退字形的问题。
                 注意：字体名必须是系统真实注册名「Segoe UI Variable」（不带 " Text" 后缀），
                 否则回退链找不到首字体导致中文落到异常字形。 -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="TextControlThemeFontFamily">Segoe UI Variable, Microsoft YaHei UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
