<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="选项设置">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
                <TextBlock Text="选项设置" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="SettingsNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="168"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="SettingsNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="歌词设置" Tag="Lyrics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="外观设置" Tag="Appearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="常规设置" Tag="General">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="播放设置" Tag="Playback">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="媒体库" Tag="MediaLib">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="全局快捷键" Tag="Hotkeys">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="曲库健康" Tag="LibraryHealth">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="流媒体" Tag="Streaming">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FE;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="0,0,8,0">
                <!-- 歌词设置 -->
                <ScrollViewer
                    x:Name="PanelLyrics"
                    VerticalScrollBarVisibility="Auto"
                    Padding="20,12,24,24">
                    <StackPanel Spacing="20" MaxWidth="680">
                        <StackPanel Spacing="10">
                            <TextBlock Text="歌词选项" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="优先使用内嵌歌词" />
                                    <TextBlock Text="播放时优先读取音频文件内嵌歌词" FontSize="12" Opacity="0.65" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PreferInnerLyricSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="模糊匹配歌词文件" />
                                    <TextBlock Text="文件名不完全一致时尝试模糊查找 LRC" FontSize="12" Opacity="0.65" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LyricFuzzyMatchSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="显示歌词翻译" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowLyricTranslateSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="歌词文件夹" />
                                    <TextBox x:Name="LyricFolderTextBox" PlaceholderText="留空则与歌曲同目录或默认路径" LostFocus="SettingTextBox_LostFocus" />
                                </StackPanel>
                                <Button x:Name="BrowseLyricFolderButton" Grid.Column="1" VerticalAlignment="Bottom" Content="浏览…" Click="BrowseLyricFolderButton_Click" MinWidth="72" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="歌词保存策略" />
                                </StackPanel>
                                <ComboBox x:Name="LyricSavePolicyCombo" Grid.Column="1" MinWidth="180" HorizontalAlignment="Stretch" SelectionChanged="SettingCombo_SelectionChanged" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="卡拉 OK 样式歌词" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LyricKaraokeStyleSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="隐藏空白歌词行" />
                                </StackPanel>
                                <ToggleSwitch x:Name="HideBlankLyricLinesSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="歌词行间距" />
                                    <TextBlock x:Name="LyricLineSpacingValueText" Text="10" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <Slider x:Name="LyricLineSpacingSlider" Grid.Column="1" Minimum="0" Maximum="40" StepFrequency="1" ValueChanged="SettingSlider_ValueChanged" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="歌词对齐" />
                                </StackPanel>
                                <ComboBox x:Name="LyricAlignCombo" Grid.Column="1" MinWidth="180" HorizontalAlignment="Stretch" SelectionChanged="SettingCombo_SelectionChanged" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="桌面歌词" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="启动时打开桌面歌词" />
                                    <TextBlock Text="显示桌面歌词窗口" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <ToggleSwitch x:Name="OpenDesktopLyricsSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="无歌词时隐藏" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DesktopLyricHideWithoutLyricSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="暂停时隐藏" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DesktopLyricHideWhenPausedSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="启动时锁定位置" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DesktopLyricLockOnStartSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="锁定时显示解锁提示" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DesktopLyricShowUnlockWhenLockedSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="显示行数" />
                                    <TextBlock Text="同时显示几行歌词" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <ComboBox x:Name="DesktopLyricVisibleLinesCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="SettingCombo_SelectionChanged">
                                    <ComboBoxItem Content="仅当前行" Tag="1" />
                                    <ComboBoxItem Content="当前行 + 下一行" Tag="2" />
                                    <ComboBoxItem Content="上一行 + 当前行 + 下一行" Tag="3" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="鼠标穿透" />
                                    <TextBlock Text="点击穿透到下层窗口" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DesktopLyricClickThroughSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="不透明度" />
                                    <TextBlock x:Name="DesktopLyricOpacityValueText" Text="100" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <Slider x:Name="DesktopLyricOpacitySlider" Grid.Column="1" Minimum="20" Maximum="100" StepFrequency="1" ValueChanged="SettingSlider_ValueChanged" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="字体大小" />
                                    <TextBlock x:Name="DesktopLyricFontSizeValueText" Text="28" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <Slider x:Name="DesktopLyricFontSizeSlider" Grid.Column="1" Minimum="14" Maximum="64" StepFrequency="1" ValueChanged="SettingSlider_ValueChanged" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="已播放颜色" />
                                    <TextBlock Text="卡拉 OK 高亮颜色" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border
                                        x:Name="DesktopLyricPlayedColorSwatch"
                                        Width="28"
                                        Height="28"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        x:Name="DesktopLyricPlayedColorTextBox"
                                        Width="100"
                                        LostFocus="SettingTextBox_LostFocus" />
                                    <Button
                                        Content="调色板"
                                        Click="PickPlayedColorButton_Click"
                                        MinWidth="72" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="未播放颜色" />
                                    <TextBlock Text="歌词正文颜色" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border
                                        x:Name="DesktopLyricUnplayedColorSwatch"
                                        Width="28"
                                        Height="28"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        x:Name="DesktopLyricUnplayedColorTextBox"
                                        Width="100"
                                        LostFocus="SettingTextBox_LostFocus" />
                                    <Button
                                        Content="调色板"
                                        Click="PickUnplayedColorButton_Click"
                                        MinWidth="72" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="外观增强" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="字体" />
                                </StackPanel>
                                <ComboBox x:Name="DesktopLyricFontFamilyCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="SettingCombo_SelectionChanged">
                                    <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei UI" />
                                    <ComboBoxItem Content="黑体" Tag="SimHei" />
                                    <ComboBoxItem Content="等线" Tag="DengXian" />
                                    <ComboBoxItem Content="宋体" Tag="SimSun" />
                                    <ComboBoxItem Content="楷体" Tag="KaiTi" />
                                    <ComboBoxItem Content="微软雅黑（旧）" Tag="Microsoft YaHei" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="配色预设" />
                                    <TextBlock Text="一键套用，也可在下方自定义颜色" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <ComboBox x:Name="DesktopLyricColorPresetCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="DesktopLyricColorPresetCombo_SelectionChanged">
                                    <ComboBoxItem Content="自定义" Tag="Custom" />
                                    <ComboBoxItem Content="冰蓝" Tag="IceBlue" />
                                    <ComboBoxItem Content="暖橙" Tag="WarmOrange" />
                                    <ComboBoxItem Content="霓虹紫" Tag="NeonPurple" />
                                    <ComboBoxItem Content="纯白" Tag="PureWhite" />
                                    <ComboBoxItem Content="青柠" Tag="Lime" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="隐藏翻译歌词" />
                                    <TextBlock Text="桌面歌词里不再显示译文行" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DesktopLyricHideTranslationSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="对齐方式" />
                                </StackPanel>
                                <ComboBox x:Name="DesktopLyricAlignCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="SettingCombo_SelectionChanged">
                                    <ComboBoxItem Content="左对齐" Tag="Left" />
                                    <ComboBoxItem Content="居中" Tag="Center" />
                                    <ComboBoxItem Content="右对齐" Tag="Right" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="阴影强度" />
                                </StackPanel>
                                <ComboBox x:Name="DesktopLyricShadowCombo" Grid.Column="1" MinWidth="200" HorizontalAlignment="Stretch" SelectionChanged="SettingCombo_SelectionChanged">
                                    <ComboBoxItem Content="关" Tag="0" />
                                    <ComboBoxItem Content="弱" Tag="1" />
                                    <ComboBoxItem Content="中" Tag="2" />
                                    <ComboBoxItem Content="强" Tag="3" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="描边宽度" />
                                    <TextBlock x:Name="DesktopLyricOutlineWidthValueText" Text="0" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <Slider x:Name="DesktopLyricOutlineWidthSlider" Grid.Column="1" Minimum="0" Maximum="4" StepFrequency="0.5" ValueChanged="SettingSlider_ValueChanged" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="描边颜色" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border
                                        x:Name="DesktopLyricOutlineColorSwatch"
                                        Width="28" Height="28" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBox x:Name="DesktopLyricOutlineColorTextBox" Width="100" LostFocus="SettingTextBox_LostFocus" />
                                    <Button Content="调色板" Click="PickOutlineColorButton_Click" MinWidth="72" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="行距" />
                                    <TextBlock x:Name="DesktopLyricLineSpacingValueText" Text="6" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <Slider x:Name="DesktopLyricLineSpacingSlider" Grid.Column="1" Minimum="0" Maximum="24" StepFrequency="1" ValueChanged="SettingSlider_ValueChanged" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="背景条" />
                                    <TextBlock Text="歌词后加一条半透明底色，提升可读性" FontSize="12" Opacity="0.65" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DesktopLyricShowBackgroundBarSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="背景条颜色" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border
                                        x:Name="DesktopLyricBackgroundColorSwatch"
                                        Width="28" Height="28" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBox x:Name="DesktopLyricBackgroundColorTextBox" Width="100" LostFocus="SettingTextBox_LostFocus" />
                                    <Button Content="调色板" Click="PickBackgroundColorButton_Click" MinWidth="72" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="迷你播放器" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="迷你播放器始终置顶" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MiniAlwaysOnTopSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="启动时打开迷你播放器" />
                                </StackPanel>
                                <ToggleSwitch x:Name="OpenMiniPlayerSwitch" Grid.Column="1" OffContent="关" OnContent="开" Toggled="SettingToggle_Toggled" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 外观设置 -->
                <ScrollViewer
                    x:Name="PanelAppearance"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto"
                    Padding="20,12,24,24">
                    <StackPanel Spacing="10" MaxWidth="680">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="毛玻璃背景" />
                                <TextBlock Text="主窗口、迷你播放器与设置页使用亚克力透明效果" FontSize="12" Opacity="0.65" TextWrapping="WrapWholeWords" />
                            </StackPanel>
