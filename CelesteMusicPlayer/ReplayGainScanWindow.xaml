<Window
    x:Class="CelesteMusicPlayer.ReplayGainScanWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CelesteMusicPlayer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ReplayGain 扫描">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71C;" FontSize="16" />
                <TextBlock Text="ReplayGain 扫描" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16" Spacing="12">
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource SystemBaseMediumColor}">
                    计算每首曲目的响度（ReplayGain 2.0 / EBU R128），把增益与峰值写回标签。
                    播放端开启 ReplayGain（单曲/专辑）后即自动统一整库响度。仅写入标签，不改动音频数据。
                </TextBlock>

                <StackPanel Spacing="4">
                    <TextBlock Text="扫描范围" FontWeight="SemiBold" />
                    <RadioButtons x:Name="ScopeRadio">
                        <RadioButton x:Name="ScopeLibrary" Content="整库" Tag="Library" IsChecked="True" />
                        <RadioButton x:Name="ScopePlaylist" Content="当前播放列表" Tag="Playlist" />
                        <RadioButton x:Name="ScopeSelection" Content="选中曲目" Tag="Selection" />
                    </RadioButtons>
                </StackPanel>

                <CheckBox x:Name="WriteTagsBox" Content="写入标签（不勾则仅预览计算结果）" IsChecked="True" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="StartButton" Content="开始扫描" Click="StartButton_Click" />
                    <Button x:Name="CancelButton" Content="取消" IsEnabled="False" Click="CancelButton_Click" />
                </StackPanel>

                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Value="0" />
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="{ThemeResource SystemBaseMediumColor}" />

                <TextBox
                    x:Name="LogBox"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontFamily="Consolas"
                    Height="220"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
