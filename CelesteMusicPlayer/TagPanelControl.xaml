<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CelesteMusicPlayer.TagPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CelesteMusicPlayer"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:dgprim="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d">

    <!-- 标签板块（2026-10-13 阶段 5a 骨架）：mp3tag 式「左标签面板 + 右文件列表」。
         左列：横向子导航（ShellPageHost 生成，6 页）+ 当前子页面板；
         右列：工具条 + 列表头 + 文件表格 + 状态条。
         快速编辑页：字段可编辑 + 保存 + 改动前快照整体回滚（阶段 6 落地）；
         批量工具（阶段 7）/ 排序编号 / 在线标签（免费 MB+iTunes+CAA+LRClib，有 Key 的 Discogs+Last.fm+fanart.tv）/
         在线歌词（原「歌词下载」）/ 批量下载歌词（从在线歌词页拆出，独立成页）。
         取色铁律：ShellPageHost 的强调色由外部注入（构造函数传 DspAccentBrush），
         界面里其它颜色一律 ThemeResource，不自己读系统强调色。 -->

    <UserControl.Resources>
        <!-- 文件表格（2026-10-13 第四轮换 DataGrid）：原生列宽/拖拽/格内编辑，
             替掉四轮反馈 bug 不断的自绘 15 列表格。列宽只在这一处定义
             （旧自绘表格要 XAML 表头+行模板+cs 数组三处同步的时代结束）。
             单元格内边距沿用旧口径：左 10px、右 6px（全列文字右留 6px，
             不贴列边界竖线——2026-10-13 用户实测反馈定稿）；
             表头沿用旧的小号半透明样式；列间竖线用 DataGrid 原生网格线。 -->
        <SolidColorBrush x:Key="TagGridLineBrush" Color="#40808080" />
        <Style x:Key="TagGridCellStyle" TargetType="dg:DataGridCell">
            <Setter Property="Padding" Value="10,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TagGridHeaderStyle" TargetType="dgprim:DataGridColumnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <!-- 列头内边距比单元格小（8/4）：列头文字比单元格内容短，省下的宽度都给文字 -->
            <Setter Property="Padding" Value="8,0,4,0" />
            <!-- Stretch：列头可点区域铺满整列（不只是文字那一小块） -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <!-- ⚠ 整个列头模板换成自己写的，不再用 toolkit 默认模板。原因（2026-10-14 实测）：
                 ① 默认模板的 ContentPresenter **不绑定 ContentTemplate** —— 只给 Style 设
                    ContentTemplate 是没用的（上一版列名靠 ToString() 才显示出来，挂在上面的
                    点击手势自然一次都没触发，排序"点了没反应"就是这么来的）；
                 ② 默认模板右侧常驻一块排序图标位（深色主题下就是竖线左边那块白斑），
                    既挡列名又吃掉列宽 —— 用户看到的"列头文字显示不全"是它造成的。
                 自己写的模板只保留两样东西：左边列名 + 排序标记，右边一条 1px 分隔线。
                 VerticalSeparator / SortIcon 这两个名字必须留着（toolkit 内部按名字找），
                 但排序图标默认收起（排序标记我们自己画在列名旁边）。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="dgprim:DataGridColumnHeader">
                        <Grid x:Name="Root" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{StaticResource TagGridHeaderTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                            <Rectangle
                                x:Name="VerticalSeparator"
                                Grid.Column="1"
                                Width="1"
                                VerticalAlignment="Stretch"
                                Fill="{TemplateBinding SeparatorBrush}"
                                Visibility="{TemplateBinding SeparatorVisibility}" />
                            <FontIcon
                                x:Name="SortIcon"
                                Grid.Column="1"
                                FontSize="12"
                                Visibility="Collapsed" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列头内容模板（2026-10-14）：列名 + 排序标记自己渲染。
             ① 修「列头文字显示不全」：文字用 TextTrimming 收尾 + 鼠标悬停出完整列名，
                不再像默认模板那样被硬生生裁掉一半；
             ② 排序标记（▲ / ▼，多列时前面带 1、2、3）才有地方画——
                DataGrid 原生排序只支持单列，多列排序是我们自己排的。
             点击手势走 PointerPressed / PointerReleased（不用 Tapped，是为了
             拿到 Ctrl / Shift 修饰键；位移超过 4px 判为拖列宽，不触发排序）。 -->
        <DataTemplate x:Key="TagGridHeaderTemplate" x:DataType="local:TagColumnHeaderVm">
            <Grid
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                PointerPressed="TagHeader_PointerPressed"
                PointerReleased="TagHeader_PointerReleased"
                Tapped="TagHeader_Tapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind Label, Mode=OneWay}"
                    ToolTipService.ToolTip="{Binding Label}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="3,0,0,0"
                    FontSize="9"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Opacity="0.9"
                    Text="{x:Bind SortMark, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="550" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左列：子导航 + 子页面板 ==================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 横向子导航：6 个页签由 ShellPageHost 动态生成（占位容器，勿删） -->
            <StackPanel
                x:Name="TagSubNavPanel"
                Orientation="Horizontal"
                Spacing="2"
                Margin="0,0,0,6" />

            <!-- 子页面板容器：6 个面板全部常驻，显隐由 ShellPageHost 统一管 -->
            <Grid x:Name="TagSubPageHost" Grid.Row="1">

                <!-- ══════════ 页 1：快速编辑（可编辑 + 保存 + 快照回滚） ══════════ -->
                <ScrollViewer
                    x:Name="QuickEditPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10,8">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords"
                                Text="从右侧文件列表选中文件即可在这里编辑标签。也可以直接在右侧表格里单击单元格修改（回车或点别处即保存）。保存前会自动备份原标签，任何一步失败都会把已改的文件整体还原；多选时只填想改的字段，留空的不动。" />
                        </Border>

                        <!-- 保存 / 还原（2026-10-13 用户要求移到顶部：不用滚到最底就能保存） -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="QuickSaveButton" Grid.Column="0" Content="保存" Click="QuickSaveButton_Click" />
                            <Button x:Name="QuickRevertButton" Grid.Column="1" Content="还原" Click="QuickRevertButton_Click" />
                        </Grid>
                        <TextBlock
                            x:Name="QuickEditModeHint"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            Text="「还原」= 放弃还没保存的改动，恢复成磁盘上的当前值。" />

                        <!-- 当前文件：封面（放大到 240，约旧版 4~5 倍）+ 标题 + 路径 -->
                        <Grid x:Name="QuickEditFileCard">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                Width="240"
                                Height="240"
                                CornerRadius="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <!-- 封面右键菜单（2026-10-14，对标 mp3tag）：换封面 / 导出 /
                                     复制 / 粘贴 / 移除，都作用在右侧列表当前选中的那首歌上。 -->
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="从图片文件替换封面…" Click="CoverMenuReplace_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEB9F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="导出封面到文件…" Click="CoverMenuExport_Click" />
                                        <MenuFlyoutItem Text="复制封面" Click="CoverMenuCopy_Click" />
                                        <MenuFlyoutItem Text="粘贴封面" Click="CoverMenuPaste_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="移除内嵌封面" Click="CoverMenuRemove_Click" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid>
                                    <Image x:Name="QuickEditCover" Stretch="UniformToFill" />
                                    <FontIcon
                                        x:Name="QuickEditNoCoverIcon"
                                        Glyph="&#xE8B9;"
                                        FontSize="96"
                                        Opacity="0.35"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,8,0,0">
                                <TextBlock x:Name="QuickEditTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="QuickEditPath" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- 可编辑字段（阶段 6：保存前快照，失败整体还原） -->
                        <TextBox x:Name="QuickTitleBox" Header="标题" />
                        <TextBox x:Name="QuickArtistBox" Header="艺术家" />
                        <TextBox x:Name="QuickAlbumBox" Header="专辑" />
                        <TextBox x:Name="QuickAlbumArtistBox" Header="专辑艺术家" />
                        <!-- 年份 / 曲目号 / 曲目总数（mp3tag 里曲目号常显示成 "3/12"） -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QuickYearBox" Header="年份" Grid.Column="0" />
                            <TextBox x:Name="QuickTrackBox" Header="曲目号" Grid.Column="1" />
                            <TextBox x:Name="QuickTrackCountBox" Header="曲目总数" Grid.Column="2" />
                        </Grid>

                        <!-- 碟片号 / 碟片总数 / BPM -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QuickDiscBox" Header="碟片号（CD 号）" Grid.Column="0" />
                            <TextBox x:Name="QuickDiscCountBox" Header="碟片总数" Grid.Column="1" />
                            <TextBox x:Name="QuickBpmBox" Header="BPM（速度）" Grid.Column="2" />
                        </Grid>

                        <TextBox x:Name="QuickGenreBox" Header="流派" />
                        <TextBox x:Name="QuickComposerBox" Header="作曲家" />

                        <TextBox x:Name="QuickCommentBox" Header="注释" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                        <TextBox
                            x:Name="QuickLyricsBox"
                            Header="歌词（非同步 · UNSYNCEDLYRICS）"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Height="150" />

                        <!-- 外挂 .lrc 编辑：直接编辑歌曲同目录（或设置里的歌词文件夹）中的同名 .lrc。
                             它是磁盘上的独立文件，与右侧「下载并保存」写的是同一个位置；
                             有独立的保存按钮，不走标签保存流程（不碰音频文件本身）。 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="外挂歌词（.lrc）" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="QuickLrcPathText"
                                    FontSize="11"
                                    Opacity="0.7"
                                    TextWrapping="WrapWholeWords" />
                                <TextBox
                                    x:Name="QuickLrcBox"
                                    Height="150"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    TextWrapping="NoWrap"
                                    PlaceholderText="选中一个文件后，这里显示它同名 .lrc 的内容；还没有 .lrc 就直接写，然后点「保存 .lrc」"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="QuickLrcSaveButton" Content="保存 .lrc" Click="QuickLrcSaveButton_Click" />
                                    <Button x:Name="QuickLrcReloadButton" Content="重新读取" Click="QuickLrcReloadButton_Click" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="QuickLrcStatusText"
                                    FontSize="11"
                                    Opacity="0.7"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <!-- 文件本身的信息（只读，改不了也不需要改） -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="文件信息（只读）" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="QuickFileInfoText" FontSize="11" Opacity="0.75" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <!-- 同步歌词（带时间轴的那种，mp3tag 里就叫 LYRICS）：
                             读得出来但写不回去（写它要重建时间轴事件，风险大又极少用），
                             所以做成只读，省得改了以为生效。按用户要求放在本页最底部。 -->
                        <TextBox
                            x:Name="QuickSyncedLyricsBox"
                            Header="歌词（同步 · LYRICS，只读）"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            Height="110" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 2：批量工具（阶段 7） ══════════
                     六个功能区 + 统一状态条。所有操作的共同安全底线：
                     改动前快照 → 逐个执行 → 任何一步失败就把已改的文件整体还原，
                     绝不留在半改状态。作用范围 = 右侧列表选中项；一个都没选 = 整个列表。 -->
                <ScrollViewer
                    x:Name="BatchToolsPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <!-- 作用范围提示 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10,8">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords"
                                Text="作用范围 = 右侧文件列表里选中的文件；一个都没选时作用于整个列表。每个工具执行前都会自动备份原标签，任何一步失败都会把已改的文件整体还原。" />
                        </Border>

                        <!-- ① 文件名 → 标签 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="① 文件名 → 标签" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="按「艺术家 - 标题」解析文件名（也认「标题 - 艺术家」）。默认只填当前为空的标题/艺术家，已有内容不动；勾选下面的框才会覆盖。" />
                                <CheckBox x:Name="BatchFileNameOverwriteCheck" Content="同时覆盖已有的标题/艺术家" />
                                <Button x:Name="BatchFileNameFillButton" Content="从文件名填充" HorizontalAlignment="Left" Click="BatchFileNameFillButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ② 标签 → 文件名（重命名） -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="② 标签 → 文件名（重命名）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="用标签重命名文件。目标文件名已被占用、或标题为空时，跳过该文件（不改）。扩展名保持原样。" />
                                <ComboBox x:Name="BatchRenamePatternCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="艺术家 - 标题" Tag="ArtistTitle" IsSelected="True" />
                                    <ComboBoxItem Content="曲目. 艺术家 - 标题" Tag="TrackArtistTitle" />
                                    <ComboBoxItem Content="标题" Tag="Title" />
                                </ComboBox>
                                <Button x:Name="BatchRenameButton" Content="重命名所选文件" HorizontalAlignment="Left" Click="BatchRenameButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ③ 文本替换 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="③ 文本替换" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="在选中文件的指定字段里查找并替换文字。勾选正则后按正则表达式匹配（替换串里可用 $1 引用捕获组）。" />
                                <ComboBox x:Name="BatchReplaceFieldCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="标题" Tag="Title" IsSelected="True" />
                                    <ComboBoxItem Content="艺术家" Tag="Artist" />
                                    <ComboBoxItem Content="专辑" Tag="Album" />
                                    <ComboBoxItem Content="专辑艺术家" Tag="AlbumArtist" />
                                    <ComboBoxItem Content="流派" Tag="Genre" />
                                    <ComboBoxItem Content="注释" Tag="Comment" />
                                </ComboBox>
                                <TextBox x:Name="BatchReplaceFindBox" Header="查找" PlaceholderText="要替换掉的文字" />
                                <TextBox x:Name="BatchReplaceWithBox" Header="替换为" PlaceholderText="留空 = 删除查到的文字" />
                                <CheckBox x:Name="BatchReplaceRegexCheck" Content="用正则表达式" />
                                <Button x:Name="BatchReplaceButton" Content="替换" HorizontalAlignment="Left" Click="BatchReplaceButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ④ 大小写 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="④ 大小写整理" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="把选中文件指定字段统一成一种大小写风格，治「全大写 / 全小写」的杂乱命名。" />
                                <ComboBox x:Name="BatchCaseFieldCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="标题" Tag="Title" IsSelected="True" />
                                    <ComboBoxItem Content="艺术家" Tag="Artist" />
                                    <ComboBoxItem Content="专辑" Tag="Album" />
                                    <ComboBoxItem Content="专辑艺术家" Tag="AlbumArtist" />
                                    <ComboBoxItem Content="流派" Tag="Genre" />
                                    <ComboBoxItem Content="注释" Tag="Comment" />
                                </ComboBox>
                                <ComboBox x:Name="BatchCaseModeCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="每词首字母大写（Hello World）" Tag="Title" IsSelected="True" />
                                    <ComboBoxItem Content="全大写（HELLO WORLD）" Tag="Upper" />
                                    <ComboBoxItem Content="全小写（hello world）" Tag="Lower" />
                                </ComboBox>
                                <Button x:Name="BatchCaseButton" Content="整理大小写" HorizontalAlignment="Left" Click="BatchCaseButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ⑤ 自动编号 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⑤ 自动编号（曲目号）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="按列表从上到下的顺序写曲目号：第一个文件 = 起始值，之后每个加一步长。文件格式里曲目号只能存纯数字，补零位数在这里不生效（存不进文件）。" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BatchNumberStartBox" Grid.Column="0" Header="起始值" Text="1" />
                                    <TextBox x:Name="BatchNumberStepBox" Grid.Column="1" Header="步长" Text="1" />
                                </Grid>
                                <Button x:Name="BatchNumberButton" Content="写入曲目号" HorizontalAlignment="Left" Click="BatchNumberButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ⑥ 移除标签 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⑥ 移除标签" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="清空文字标签 = 标题/艺术家/专辑/年份/曲目/流派/注释/歌词全部清空，内嵌封面保留。两个操作执行前都会备份，失败整体还原。" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BatchClearTagsButton" Content="清空文字标签（留封面）" Click="BatchClearTagsButton_Click" />
                                    <Button x:Name="BatchRemoveCoverButton" Content="移除内嵌封面" Click="BatchRemoveCoverButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 批量工具自己的状态条（右侧底部那条同时也在用） -->
                        <TextBlock
                            x:Name="BatchStatusText"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 3：排序编号（2026-10-14 第 3 项落地） ══════════
                     先在上面工具条用「排序…」排好顺序，再在这里把顺序写成曲目号，
                     或整批加入播放队列 / 音乐库 / 播放列表。
                     冲突处理（用户拍板的方案）：播放队列和播放列表都允许库外的歌，
                     不冲突；音乐库是持久化的，只按文件夹收录——「加入音乐库」先做
                     入库检查，文件夹没被收录就问一句要不要一起入库。 -->
                <ScrollViewer
                    x:Name="SortNumberPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10,8">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords"
                                Text="这一页把「排好的顺序」用出价值：写成曲目号（自动编号），或整批加进播放队列 / 音乐库 / 播放列表。排序请在右侧工具条的「排序…」按钮里设置（列头点击排序已停用）。" />
                        </Border>

                        <!-- 当前排序状态（切到本页自动刷新） -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="当前排序" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="SortNumberStatusText"
                                    FontSize="12"
                                    Opacity="0.75"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <!-- ① 把当前顺序写入曲目号 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="① 把当前顺序写入曲目号" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="按列表从上到下的顺序写曲目号：第一个文件 = 起始值，之后每个加一步长。写之前会自动备份，失败整体还原。" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SortNumberStartBox" Grid.Column="0" Header="起始值" Text="1" />
                                    <TextBox x:Name="SortNumberStepBox" Grid.Column="1" Header="步长" Text="1" />
                                </Grid>
                                <Button x:Name="SortNumberWriteButton" Content="写入曲目号" HorizontalAlignment="Left" Click="SortNumberWriteButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ② 加入播放队列 / 音乐库 / 播放列表 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="② 加入播放队列 / 音乐库 / 播放列表" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="SortNumberScopeText"
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SortNumberQueueButton" Content="加入播放队列" Click="SortNumberQueueButton_Click" />
                                    <Button x:Name="SortNumberLibraryButton" Content="加入音乐库…" Click="SortNumberLibraryButton_Click" />
                                    <Button x:Name="SortNumberPlaylistButton" Content="加入播放列表…" Click="SortNumberPlaylistButton_Click" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.55"
                                    TextWrapping="WrapWholeWords"
                                    Text="播放队列和播放列表都允许库外的歌；音乐库只按文件夹收录——加入音乐库时如果文件夹还没被收录，会先问你要不要一起入库。作用范围 = 右侧列表的选中项，一个都没选就是整个列表。" />
                                <TextBlock
                                    x:Name="SortNumberActionText"
                                    FontSize="12"
                                    Opacity="0.7"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 4：在线标签（免费 MB+iTunes+CAA+LRClib；有 Key 的 Discogs+Last.fm+fanart.tv） ══════════
                     搜索 → 点结果看详情（封面/字段/歌词预览）→ 勾要写的字段 → 写入所选文件。
                     写入前快照、失败整体回滚（与快速编辑页同一套安全底线）。 -->
                <ScrollViewer
                    x:Name="OnlineTagPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <!-- ① 当前文件 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="① 当前文件" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="OnlineTagFileText"
                                    FontSize="12"
                                    Opacity="0.75"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <!-- ② 搜索 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="② 搜索" FontSize="13" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OnlineTagTitleBox" Grid.Column="0" Header="标题" />
                                    <TextBox x:Name="OnlineTagArtistBox" Grid.Column="1" Header="艺术家" />
                                </Grid>
                                <TextBox x:Name="OnlineTagAlbumBox" Header="专辑（可留空）" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                        <ComboBox
                                        x:Name="OnlineTagSourceCombo"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="全部（免费 + Key）" Tag="All" IsSelected="True" />
                                        <ComboBoxItem Content="MusicBrainz + iTunes" Tag="Both" />
                                        <ComboBoxItem Content="MusicBrainz" Tag="MusicBrainz" />
                                        <ComboBoxItem Content="iTunes" Tag="iTunes" />
                                        <ComboBoxItem Content="Discogs（需 Key）" Tag="Discogs" />
                                        <ComboBoxItem Content="Last.fm（需 Key）" Tag="Last.fm" />
                                    </ComboBox>
                                    <Button x:Name="OnlineTagSearchButton" Grid.Column="1" Content="搜索" Click="OnlineTagSearchButton_Click" />
                                </Grid>
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="免费源：MusicBrainz（官方限速每秒 1 次）+ iTunes，封面走 Cover Art Archive / Apple artwork，歌词只有 LRClib。有 Key 源：Discogs（极详尽发行元数据 + 高清封面）、Last.fm（流派 / 封面）、fanart.tv（按 MBID 取 HD 封面）。Key 在「设置」里填。" />
                            </StackPanel>
                        </Border>

                        <!-- ③ 搜索结果 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="③ 搜索结果" FontSize="13" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8" Padding="2,0,2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="1" Text="标题" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="2" Text="艺术家" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="3" Text="专辑" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="4" Text="年份" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="5" Text="来源" FontSize="11" Opacity="0.55" />
                                </Grid>
                                <ListView
                                    x:Name="OnlineTagResultList"
                                    MaxHeight="230"
                                    SelectionMode="Single"
                                    SelectionChanged="OnlineTagResultList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:OnlineTagCandidate">
                                            <Grid Padding="2,5" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind Index}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Title}"
                                                    FontSize="12"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind Artist}"
                                                    FontSize="11"
                                                    Opacity="0.75"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{x:Bind Album}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="4"
                                                    Text="{x:Bind YearText}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="5"
                                                    Text="{x:Bind SourceLabel}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ④ 结果详情 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="④ 结果详情（点上面的结果加载）" FontSize="13" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="120"
                                        Height="120"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Image x:Name="OnlineTagCoverImage" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            x:Name="OnlineTagDetailText"
                                            FontSize="12"
                                            Opacity="0.8"
                                            TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            x:Name="OnlineTagLyricText"
                                            FontSize="11"
                                            Opacity="0.65"
                                            MaxHeight="80"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ⑤ 写入所选文件 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⑤ 写入所选文件" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="OnlineTagScopeText"
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock FontSize="12" Text="勾选要写入的字段（没勾的不动）：" />
                                <StackPanel Spacing="2">
                                    <CheckBox x:Name="OnlineTagFieldTitle" Content="标题" />
                                    <CheckBox x:Name="OnlineTagFieldArtist" Content="艺术家" />
                                    <CheckBox x:Name="OnlineTagFieldAlbum" Content="专辑" />
                                    <CheckBox x:Name="OnlineTagFieldAlbumArtist" Content="专辑艺术家" />
                                    <CheckBox x:Name="OnlineTagFieldYear" Content="年份" />
                                    <CheckBox x:Name="OnlineTagFieldTrack" Content="曲目号 / 曲目总数" />
                                    <CheckBox x:Name="OnlineTagFieldDisc" Content="碟片号 / 碟片总数" />
                                    <CheckBox x:Name="OnlineTagFieldGenre" Content="流派" />
                                    <CheckBox x:Name="OnlineTagFieldCover" Content="封面（内嵌进文件）" />
                                    <CheckBox x:Name="OnlineTagFieldLyrics" Content="歌词（LRClib，写进歌词字段）" />
                                </StackPanel>
                                <Button x:Name="OnlineTagWriteButton" Content="写入所选文件" HorizontalAlignment="Left" Click="OnlineTagWriteButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- 状态条：每条成败原因都写在这里，绝不静默失败 -->
                        <TextBlock
                            x:Name="OnlineTagStatusText"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 5：在线歌词（原「歌词下载」改名） ══════════
                     单首精修：搜索 → 预览 → 选写入口径（外挂 .lrc / 歌词字段纯文本 /
                     歌词字段带时间戳 / 两头都写）。批量下载在下一个子页。 -->
                <ScrollViewer
                    x:Name="LyricDownloadPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <!-- ① 当前文件 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="① 当前文件" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="LyricCurrentFileText"
                                    FontSize="12"
                                    Opacity="0.75"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <!-- ② 搜索 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="② 搜索" FontSize="13" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="LyricSourceCombo"
                                        Grid.Column="0"
                                        MinWidth="118"
                                        SelectionChanged="LyricSourceCombo_SelectionChanged">
                                        <ComboBoxItem Content="LRClib（免 key）" Tag="LRClib" />
                                        <ComboBoxItem Content="QQ 音乐（非官方）" Tag="QQ" />
                                    </ComboBox>
                                    <TextBox x:Name="LyricTitleBox" Grid.Column="1" Header="标题" />
                                    <TextBox x:Name="LyricArtistBox" Grid.Column="2" Header="艺术家" />
                                    <Button x:Name="LyricSearchButton" Grid.Column="3" Content="搜索" Click="LyricSearchButton_Click" />
                                </Grid>
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="关键词 = 艺术家 + 标题。QQ 音乐走客户端老接口，非官方渠道，随时可能失效。" />
                            </StackPanel>
                        </Border>

                        <!-- ③ 搜索结果 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="③ 搜索结果" FontSize="13" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8" Padding="2,0,2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="1" Text="标题" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="2" Text="艺术家" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="3" Text="专辑" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="4" Text="时长" FontSize="11" Opacity="0.55" />
                                </Grid>
                                <ListView
                                    x:Name="LyricResultList"
                                    MaxHeight="230"
                                    SelectionChanged="LyricResultList_SelectionChanged"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LyricCandidate">
                                            <Grid Padding="2,5" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="42" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind Index}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Title}"
                                                    FontSize="12"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind Artist}"
                                                    FontSize="11"
                                                    Opacity="0.75"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{x:Bind Album}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="4"
                                                    Text="{x:Bind DurationText}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- ④ 预览与保存 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="④ 预览与保存" FontSize="13" FontWeight="SemiBold" />
                                <TextBox
                                    x:Name="LyricPreviewBox"
                                    Height="170"
                                    AcceptsReturn="True"
                                    IsReadOnly="True"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    TextWrapping="NoWrap"
                                    PlaceholderText="选中上面的搜索结果后，这里显示歌词正文"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                <CheckBox
                                    x:Name="LyricTranslateCheck"
                                    Content="包含翻译（QQ 源有译文时附在正文后面）" />
                                <TextBlock
                                    FontSize="12"
                                    Text="写入口径（自己选）：" />
                                <StackPanel Spacing="2">
                                    <RadioButton
                                        x:Name="LyricTargetSidecar"
                                        GroupName="LyricWriteTarget"
                                        Tag="Sidecar"
                                        Content="外挂 .lrc 文件（带时间轴，所有播放器都认）" />
                                    <RadioButton
                                        x:Name="LyricTargetTagPlain"
                                        GroupName="LyricWriteTarget"
                                        Tag="TagPlain"
                                        Content="写进音频的歌词字段，纯文本（剥掉时间戳）" />
                                    <RadioButton
                                        x:Name="LyricTargetTagTs"
                                        GroupName="LyricWriteTarget"
                                        Tag="TagTimestamped"
                                        Content="写进音频的歌词字段，保留时间戳（ECHO 这类播放器能跟着滚）" />
                                    <RadioButton
                                        x:Name="LyricTargetBoth"
                                        GroupName="LyricWriteTarget"
                                        Tag="Both"
                                        Content="两头都写：外挂 .lrc + 歌词字段纯文本" />
                                </StackPanel>
                                <TextBlock FontSize="12" Text="外挂 .lrc 保存位置：" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton
                                        x:Name="LyricSaveSongFolder"
                                        GroupName="LyricSaveLoc"
                                        Content="歌曲所在目录（同名 .lrc）" />
                                    <RadioButton
                                        x:Name="LyricSaveLyricFolder"
                                        GroupName="LyricSaveLoc"
                                        Content="歌词文件夹（设置→歌词里配的那个）" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="LyricDownloadButton" Content="下载并保存" Click="LyricDownloadButton_Click" />
                                    <Button x:Name="LyricOnlineViewButton" Content="在线查看" Click="LyricOnlineViewButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 状态条：每条成败原因都写在这里，绝不静默失败 -->
                        <TextBlock
                            x:Name="LyricPageStatusText"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 6：批量下载歌词（从在线歌词页拆出，独立成页） ══════════
                     逐首：算 .lrc 路径 → 跳过已有 → 拼关键词 → 搜索 → 加权选最佳 →
                     下载 → 写外挂 .lrc（只写外挂；想写进歌词字段用「在线歌词」页）。 -->
                <ScrollViewer
                    x:Name="LyricBatchPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <!-- ① 下载设置 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="① 下载设置" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="LyricBatchScopeText"
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="来源：" FontSize="12" VerticalAlignment="Center" />
                                    <ComboBox
                                        x:Name="LyricBatchSourceCombo"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        SelectionChanged="LyricBatchSourceCombo_SelectionChanged">
                                        <ComboBoxItem Content="LRClib（免 key）" Tag="LRClib" />
                                        <ComboBoxItem Content="QQ 音乐（非官方）" Tag="QQ" />
                                    </ComboBox>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox x:Name="LyricBatchSkipExistCheck" Content="跳过已有 .lrc 的曲目" />
                                    <CheckBox x:Name="LyricBatchTranslateCheck" Content="带翻译" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="保存到：" FontSize="12" VerticalAlignment="Center" />
                                    <RadioButton
                                        x:Name="LyricBatchSaveSongFolder"
                                        GroupName="LyricBatchSaveLoc"
                                        Content="歌曲所在目录" />
                                    <RadioButton
                                        x:Name="LyricBatchSaveLyricFolder"
                                        GroupName="LyricBatchSaveLoc"
                                        Content="歌词文件夹" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="逐首下载并写成同名 .lrc（外挂文件）。想写进音频文件里的歌词字段，用「在线歌词」页。QQ 音乐走客户端老接口，非官方渠道，随时可能失效。" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="LyricBatchStartButton" Content="开始批量下载" Click="LyricBatchStartButton_Click" />
                                    <Button x:Name="LyricBatchStopButton" Content="停止" Click="LyricBatchStopButton_Click" IsEnabled="False" />
                                </StackPanel>
                                <ProgressBar x:Name="LyricBatchProgressBar" Maximum="100" />
                            </StackPanel>
                        </Border>

                        <!-- ② 逐首状态 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="② 逐首状态" FontSize="13" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8" Padding="2,0,2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="1" Text="标题" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="2" Text="艺术家" FontSize="11" Opacity="0.55" />
                                    <TextBlock Grid.Column="3" Text="状态" FontSize="11" Opacity="0.55" />
                                </Grid>
                                <ListView x:Name="LyricBatchList" MaxHeight="260">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LyricBatchItem">
                                            <Grid Padding="2,4" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{x:Bind Index}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Title}"
                                                    FontSize="12"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind Artist}"
                                                    FontSize="11"
                                                    Opacity="0.75"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{x:Bind Status}"
                                                    FontSize="11"
                                                    Opacity="0.75"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- 状态条：汇总与失败原因 -->
                        <TextBlock
                            x:Name="LyricBatchStatusText"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ==================== 右列：文件列表 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工具条 -->
            <Grid ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button CornerRadius="16" x:Name="AddFilesButton" Content="添加文件…" Click="AddFilesButton_Click" />
                <Button CornerRadius="16" x:Name="AddFolderButton" Grid.Column="1" Content="添加文件夹…" Click="AddFolderButton_Click" />
                <!-- 添加文件夹时到底要不要连子文件夹一起扫：用户自己说了算
                     （默认勾上 = 和以前一样连子文件夹一起加）。 -->
                <CheckBox
                    x:Name="IncludeSubfoldersCheck"
                    Grid.Column="2"
                    Content="含子文件夹"
                    FontSize="12"
                    IsChecked="True"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="勾上 = 连所选文件夹里的所有子文件夹一起扫描；不勾 = 只收这一层里的音频文件。" />
                <Button CornerRadius="16" x:Name="RemoveSelectedButton" Grid.Column="3" Content="移除所选" Click="RemoveSelectedButton_Click" />
                <Button CornerRadius="16" x:Name="ClearListButton" Grid.Column="4" Content="清空" Click="ClearListButton_Click" />

                <!-- 排序（2026-10-14）：列头点击那条路放弃了（DataGrid 把列头的指针事件
                     都吃掉，三条挂法都试过一次也没进来），改成按钮。面板是贴着按钮往下
                     弹的小面板，不弹大窗、不占额外地方，可以多列依次排序（mp3tag 口径）。 -->
                <Button
                    CornerRadius="16"
                    x:Name="SortButton"
                    Grid.Column="5"
                    Content="排序…"
                    ToolTipService.ToolTip="按多个字段依次排序（先排的优先）">
                    <Button.Flyout>
                        <Flyout x:Name="SortFlyout" Opening="SortFlyout_Opening">
                            <StackPanel Width="360" Spacing="10">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    TextWrapping="WrapWholeWords"
                                    Text="从上到下依次生效：先按第一行排，相同的再按第二行排（和 mp3tag 的排序一个意思）。" />
                                <StackPanel x:Name="SortRuleList" Spacing="8" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SortAddRuleButton" Content="+ 添加一级" Click="SortAddRuleButton_Click" />
                                    <Button x:Name="SortClearRulesButton" Content="清除排序" Click="SortClearRulesButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- 列显隐 + 前后顺序（2026-10-14 用户要求：mp3tag 能读的标签也要能加进列表；
                     而且每个字段都要能选显不显示、能前移后移）。全部 21 个真实列都归这里管
                     （末尾星号填充列恒在末行，不参与）。顺序与勾选状态一起存配置目录的
                     tag-panel-columns.json，重启后还在。 -->
                <Button
                    CornerRadius="16"
                    x:Name="ColumnsButton"
                    Grid.Column="6"
                    Content="列…"
                    ToolTipService.ToolTip="选择要显示的列，调整列的前后顺序">
                    <Button.Flyout>
                        <Flyout x:Name="ColumnsFlyout" Opening="ColumnsFlyout_Opening">
                            <StackPanel Width="330" Spacing="6">
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    TextWrapping="WrapWholeWords"
                                    Text="勾上的列会显示在表格里；↑ ↓ 调整列的前后顺序（对所有列生效，包括默认列）。" />
                                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ColumnToggleList" Spacing="2" />
                                </ScrollViewer>
                                <Button
                                    x:Name="ColumnsResetButton"
                                    Content="恢复默认列与顺序"
                                    HorizontalAlignment="Left"
                                    Click="ColumnsResetButton_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <TextBlock
                    x:Name="FileCountText"
                    Grid.Column="7"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.65"
                    Text="0 个文件" />
            </Grid>

            <!-- 文件表格（2026-10-13 第四轮换 DataGrid）：列宽 / 列头 / 横向滚动 / 行选中
                 全部用原生能力，四轮反馈 bug 不断的自绘表头 + 拖拽把手整块删除。
                 列宽只在这一处定义（旧自绘表格要 XAML 表头 + 行模板 + cs 数组三处同步）。
                 单元格内边距沿用旧口径：左 10px、右 6px（全列文字右留 6px，不贴列
                 边界竖线——2026-10-13 用户实测反馈定稿）；列间竖线用原生网格线。
                 格内编辑 = mp3tag 口径：单击行选中整行，再击可编辑格进编辑，回车 /
                 点别处提交并立即写盘，Esc 放弃。可编辑列（标题/艺术家/专辑/年份/曲目/
                 流派）显示态 TextBlock、编辑态无边框 TextBox；编辑框 OneWay 绑定只负责
                 显示初值，落盘值在 CellEditEnding 里从编辑框直读（不依赖绑定回写时序，
                 Esc 取消也不会把半成品写进行模型）。末尾星号列吸收剩余宽度，真实列
                 永不被挤压。 -->
            <dg:DataGrid
                x:Name="TagFileGrid"
                Grid.Row="2"
                ItemsSource="{x:Bind _files, Mode=OneWay}"
                AutoGenerateColumns="False"
                SelectionMode="Extended"
                RowHeight="34"
                ColumnHeaderHeight="32"
                HeadersVisibility="Column"
                GridLinesVisibility="Vertical"
                VerticalGridLinesBrush="{StaticResource TagGridLineBrush}"
                HorizontalScrollBarVisibility="Auto"
                CanUserSortColumns="False"
                CanUserReorderColumns="False"
                CellStyle="{StaticResource TagGridCellStyle}"
                ColumnHeaderStyle="{StaticResource TagGridHeaderStyle}"
                SelectionChanged="TagFileGrid_SelectionChanged"
                CellEditEnding="TagFileGrid_CellEditEnding"
                CellEditEnded="TagFileGrid_CellEditEnded"
                LoadingRow="TagFileGrid_LoadingRow"
                UnloadingRow="TagFileGrid_UnloadingRow">
                <dg:DataGrid.Columns>
                    <!-- # 序号列（只读；行模型 INPC，Renumber 后可见行实时更新） -->
                    <dg:DataGridTemplateColumn Tag="Index" Header="#" Width="36" MinWidth="28">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind IndexLabel, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <!-- 可编辑列：显示态 TextBlock + 编辑态无边框 TextBox（回车 / 点别处提交即写盘） -->
                    <dg:DataGridTemplateColumn Tag="Title" Header="标题" Width="100" MinWidth="100">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Title, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Text="{x:Bind Title, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Artist" Header="艺术家" Width="130" MinWidth="60">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Artist, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Text="{x:Bind Artist, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Album" Header="专辑" Width="130" MinWidth="60">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Album, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Text="{x:Bind Album, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Year" Header="年份" Width="52" MinWidth="36">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind YearText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" TextAlignment="Right" Text="{x:Bind YearEdit, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Track" Header="曲目" Width="44" MinWidth="32">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind TrackText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" TextAlignment="Right" Text="{x:Bind TrackEdit, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Genre" Header="流派" Width="84" MinWidth="48">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Genre, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Text="{x:Bind Genre, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <!-- 只读列：时长 / 文件名 / 文件派生规格（右留 6px，不贴列边界竖线） -->
                    <dg:DataGridTemplateColumn Tag="Duration" Header="时长" Width="60" MinWidth="44">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind DurationText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <!-- 文件名列可编辑（2026-10-14 用户要求）：提交 = 直接重命名磁盘上的文件
                         （不是改标签）。扩展名没写会自动补原来的；目标名已存在 / 名字有
                         非法字符 / 文件被占用 → 一律不改，状态条说明原因。 -->
                    <dg:DataGridTemplateColumn Tag="FileName" Header="文件名" Width="150" MinWidth="80">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind FileName, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Text="{x:Bind FileName, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Format" Header="格式" Width="64" MinWidth="44">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind FormatName, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="BitDepth" Header="位深" Width="52" MinWidth="36">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind BitDepthText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="SampleRate" Header="采样率" Width="76" MinWidth="48">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind SampleRateText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Bitrate" Header="码率" Width="68" MinWidth="48">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind BitrateText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="FileSize" Header="大小" Width="76" MinWidth="48">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind FileSizeText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <!-- ══════════ 可选列（2026-10-14 用户要求：mp3tag 能读的标签也要能加进列表） ══════════
                         默认全部隐藏（Visibility=Collapsed），在工具条「列…」按钮里勾出来才显示。
                         勾选状态存到配置目录的 tag-panel-columns.json，下次打开还在。
                         显示文本只读（这些字段的编辑在左侧面板做，避免两处都能改搞混）。 -->
                    <dg:DataGridTemplateColumn Tag="AlbumArtist" Header="专辑艺术家" Width="120" MinWidth="60" Visibility="Collapsed">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind AlbumArtist, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Composer" Header="作曲家" Width="110" MinWidth="60" Visibility="Collapsed">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind ComposerText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Disc" Header="碟片号" Width="60" MinWidth="40" Visibility="Collapsed">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind DiscText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="TrackCount" Header="曲目总数" Width="64" MinWidth="44" Visibility="Collapsed">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind TrackCountText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Bpm" Header="BPM" Width="56" MinWidth="40" Visibility="Collapsed">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind BpmText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Comment" Header="注释" Width="140" MinWidth="60" Visibility="Collapsed">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind CommentText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <!-- 末尾星号填充列：吸收视口剩余宽度，真实列永不被挤压（不可见、不可拖宽） -->
                    <dg:DataGridTemplateColumn Tag="Filler" Width="*" MinWidth="0" CanUserResize="False">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <Grid />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <!-- 空列表提示（叠在表格上方，不挡操作） -->
            <TextBlock
                x:Name="TagListEmptyHint"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0.55"
                TextWrapping="WrapWholeWords"
                TextAlignment="Center"
                MaxWidth="320"
                Text="列表还是空的。点上方「添加文件…」或「添加文件夹…」把要整理标签的歌曲加进来。" />

            <!-- 底部状态条 -->
            <Border Grid.Row="3" Padding="0,8,0,0">
                <TextBlock
                    x:Name="TagStatusText"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="WrapWholeWords" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
