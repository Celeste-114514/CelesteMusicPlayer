<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CelesteMusicPlayer.TagPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CelesteMusicPlayer"
    mc:Ignorable="d">

    <!-- 标签板块（2026-10-13 阶段 5a 骨架）：mp3tag 式「左标签面板 + 右文件列表」。
         左列：横向子导航（ShellPageHost 生成，4 页）+ 当前子页面板；
         右列：工具条 + 列表头 + 文件表格 + 状态条。
         快速编辑本阶段只做只读预览；编辑 / 保存 / 撤销快照是阶段 6，
         批量工具 / 排序编号 / 在线补全分别在阶段 7 / 8 与后续在线阶段接入。
         取色铁律：ShellPageHost 的强调色由外部注入（构造函数传 DspAccentBrush），
         界面里其它颜色一律 ThemeResource，不自己读系统强调色。 -->

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左列：子导航 + 子页面板 ==================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 横向子导航：4 个页签由 ShellPageHost 动态生成（占位容器，勿删） -->
            <StackPanel
                x:Name="TagSubNavPanel"
                Orientation="Horizontal"
                Spacing="2"
                Margin="0,0,0,6" />

            <!-- 子页面板容器：4 个面板全部常驻，显隐由 ShellPageHost 统一管 -->
            <Grid x:Name="TagSubPageHost" Grid.Row="1">

                <!-- ══════════ 页 1：快速编辑（本阶段只读预览） ══════════ -->
                <ScrollViewer
                    x:Name="QuickEditPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10,8">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords"
                                Text="从右侧文件列表选中一个文件即可在这里预览它的标签。修改、保存和撤销快照在下一阶段开放。" />
                        </Border>

                        <!-- 当前文件：封面 + 标题 + 路径 -->
                        <Grid x:Name="QuickEditFileCard" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="56"
                                Height="56"
                                CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <Image x:Name="QuickEditCover" Stretch="UniformToFill" />
                                    <FontIcon
                                        x:Name="QuickEditNoCoverIcon"
                                        Glyph="&#xE8B9;"
                                        FontSize="24"
                                        Opacity="0.35"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="QuickEditTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="QuickEditPath" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- 只读字段（阶段 6 换成可编辑 + 保存 + 撤销快照） -->
                        <TextBox x:Name="QuickTitleBox" Header="标题" IsReadOnly="True" />
                        <TextBox x:Name="QuickArtistBox" Header="艺术家" IsReadOnly="True" />
                        <TextBox x:Name="QuickAlbumBox" Header="专辑" IsReadOnly="True" />
                        <TextBox x:Name="QuickAlbumArtistBox" Header="专辑艺术家" IsReadOnly="True" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QuickYearBox" Header="年份" Grid.Column="0" IsReadOnly="True" />
                            <TextBox x:Name="QuickTrackBox" Header="曲目号" Grid.Column="1" IsReadOnly="True" />
                        </Grid>
                        <TextBox x:Name="QuickGenreBox" Header="流派" IsReadOnly="True" />
                        <TextBox x:Name="QuickCommentBox" Header="注释" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" IsReadOnly="True" />
                        <TextBox x:Name="QuickLyricsBox" Header="歌词" AcceptsReturn="True" TextWrapping="Wrap" Height="150" IsReadOnly="True" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 2：批量工具（阶段 7 接入，占位） ══════════ -->
                <Grid x:Name="BatchToolsPanel">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="300">
                        <FontIcon Glyph="&#xE8D2;" FontSize="36" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="批量工具"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="文件名 ↔ 标签互相填充、正则替换、大小写、自动编号、复制粘贴、移除标签 —— 下一阶段开放。"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ══════════ 页 3：排序编号（阶段 8 接入，占位） ══════════ -->
                <Grid x:Name="SortNumberPanel">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="300">
                        <FontIcon Glyph="&#xE8CB;" FontSize="36" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="排序编号"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="按多个字段依次排序，再把排好的结果写入曲目号（自动编号）或加入播放队列 / 播放列表。"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ══════════ 页 4：在线补全（后续阶段接入，占位） ══════════ -->
                <Grid x:Name="OnlineFillPanel">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="300">
                        <FontIcon Glyph="&#xE774;" FontSize="36" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="在线补全"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="从 MusicBrainz / iTunes / Cover Art Archive / LRClib 搜索并补全标签、封面与歌词；匹配结果先预览、确认后才写入。"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 右列：文件列表 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工具条 -->
            <Grid ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button CornerRadius="16" x:Name="AddFilesButton" Content="添加文件…" Click="AddFilesButton_Click" />
                <Button CornerRadius="16" x:Name="AddFolderButton" Grid.Column="1" Content="添加文件夹…" Click="AddFolderButton_Click" />
                <Button CornerRadius="16" x:Name="RemoveSelectedButton" Grid.Column="2" Content="移除所选" Click="RemoveSelectedButton_Click" />
                <Button CornerRadius="16" x:Name="ClearListButton" Grid.Column="3" Content="清空" Click="ClearListButton_Click" />
                <TextBlock
                    x:Name="FileCountText"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.65"
                    Text="0 个文件" />
            </Grid>

            <!-- 列表头：列宽与行模板严格一致（默认值两边同步；运行期拖拽在代码里同步）。
                 外层 TagHeaderHost 负责裁剪：列太多内容宽于视口时，表头靠代码位移 +
                 Clip 跟随列表的横向滚动（表头在 ListView 外面，不会自己滚） -->
            <Grid x:Name="TagHeaderHost" Grid.Row="1" Margin="0,0,0,4">
                <Grid x:Name="TagListHeaderGrid" Padding="10,0" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" MinWidth="100" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="#" />
                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="标题" />
                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="艺术家" />
                    <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="专辑" />
                    <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="年份" />
                    <TextBlock Grid.Column="5" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="曲目" />
                    <TextBlock Grid.Column="6" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="流派" />
                    <TextBlock Grid.Column="7" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="时长" />
                    <TextBlock Grid.Column="8" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="文件名" />
                    <TextBlock Grid.Column="9" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="格式" />
                    <TextBlock Grid.Column="10" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="位深" />
                    <TextBlock Grid.Column="11" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="采样率" />
                    <TextBlock Grid.Column="12" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="码率" />
                    <TextBlock Grid.Column="13" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" Text="大小" />
                </Grid>
            </Grid>

            <!-- 文件表格（多选；虚拟化由 ItemsStackPanel 默认行为保留，勿外包 ScrollViewer）。
                 列太多时内容宽于视口 → 横向滚动条出现在列表底部，表头由代码同步位移；
                 列边界可拖拽调宽（表头右侧 6px 透明把手，代码生成）。 -->
            <ListView
                x:Name="TagFileListView"
                Grid.Row="2"
                SelectionMode="Extended"
                SelectionChanged="TagFileListView_SelectionChanged"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TagFileItem">
                        <Grid Padding="10,0" ColumnSpacing="8" VerticalAlignment="Center" MinWidth="1246" Loaded="TagFileRow_Loaded">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" MinWidth="100" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind IndexLabel}" />
                            <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Title}" />
                            <TextBlock Grid.Column="2" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Artist}" />
                            <TextBlock Grid.Column="3" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Album}" />
                            <TextBlock Grid.Column="4" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind YearText}" />
                            <TextBlock Grid.Column="5" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind TrackText}" />
                            <TextBlock Grid.Column="6" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Genre}" />
                            <TextBlock Grid.Column="7" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind DurationText}" />
                            <TextBlock Grid.Column="8" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind FileName}" />
                            <TextBlock Grid.Column="9" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind FormatName}" />
                            <TextBlock Grid.Column="10" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind BitDepthText}" />
                            <TextBlock Grid.Column="11" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind SampleRateText}" />
                            <TextBlock Grid.Column="12" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind BitrateText}" />
                            <TextBlock Grid.Column="13" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind FileSizeText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空列表提示（叠在表格上方，不挡操作） -->
            <TextBlock
                x:Name="TagListEmptyHint"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0.55"
                TextWrapping="WrapWholeWords"
                TextAlignment="Center"
                MaxWidth="320"
                Text="列表还是空的。点上方「添加文件…」或「添加文件夹…」把要整理标签的歌曲加进来。" />

            <!-- 底部状态条 -->
            <Border Grid.Row="3" Padding="0,8,0,0">
                <TextBlock
                    x:Name="TagStatusText"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="WrapWholeWords" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
