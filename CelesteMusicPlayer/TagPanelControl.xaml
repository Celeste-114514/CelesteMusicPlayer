<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CelesteMusicPlayer.TagPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CelesteMusicPlayer"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:dgprim="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d">

    <!-- 标签板块（2026-10-13 阶段 5a 骨架）：mp3tag 式「左标签面板 + 右文件列表」。
         左列：横向子导航（ShellPageHost 生成，4 页）+ 当前子页面板；
         右列：工具条 + 列表头 + 文件表格 + 状态条。
         快速编辑页：字段可编辑 + 保存 + 改动前快照整体回滚（阶段 6 落地）；
         批量工具 / 排序编号 / 在线补全分别在阶段 7 / 8 与后续在线阶段接入。
         取色铁律：ShellPageHost 的强调色由外部注入（构造函数传 DspAccentBrush），
         界面里其它颜色一律 ThemeResource，不自己读系统强调色。 -->

    <UserControl.Resources>
        <!-- 文件表格（2026-10-13 第四轮换 DataGrid）：原生列宽/拖拽/格内编辑，
             替掉四轮反馈 bug 不断的自绘 15 列表格。列宽只在这一处定义
             （旧自绘表格要 XAML 表头+行模板+cs 数组三处同步的时代结束）。
             单元格内边距沿用旧口径：左 10px、右 6px（全列文字右留 6px，
             不贴列边界竖线——2026-10-13 用户实测反馈定稿）；
             表头沿用旧的小号半透明样式；列间竖线用 DataGrid 原生网格线。 -->
        <SolidColorBrush x:Key="TagGridLineBrush" Color="#40808080" />
        <Style x:Key="TagGridCellStyle" TargetType="dg:DataGridCell">
            <Setter Property="Padding" Value="10,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="TagGridHeaderStyle" TargetType="dgprim:DataGridColumnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0,6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左列：子导航 + 子页面板 ==================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 横向子导航：4 个页签由 ShellPageHost 动态生成（占位容器，勿删） -->
            <StackPanel
                x:Name="TagSubNavPanel"
                Orientation="Horizontal"
                Spacing="2"
                Margin="0,0,0,6" />

            <!-- 子页面板容器：4 个面板全部常驻，显隐由 ShellPageHost 统一管 -->
            <Grid x:Name="TagSubPageHost" Grid.Row="1">

                <!-- ══════════ 页 1：快速编辑（可编辑 + 保存 + 快照回滚） ══════════ -->
                <ScrollViewer
                    x:Name="QuickEditPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10,8">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords"
                                Text="从右侧文件列表选中文件即可在这里编辑标签。也可以直接在右侧表格里单击单元格修改（回车或点别处即保存）。保存前会自动备份原标签，任何一步失败都会把已改的文件整体还原；多选时只填想改的字段，留空的不动。" />
                        </Border>

                        <!-- 保存 / 还原（2026-10-13 用户要求移到顶部：不用滚到最底就能保存） -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="QuickSaveButton" Grid.Column="0" Content="保存" Click="QuickSaveButton_Click" />
                            <Button x:Name="QuickRevertButton" Grid.Column="1" Content="还原" Click="QuickRevertButton_Click" />
                        </Grid>
                        <TextBlock
                            x:Name="QuickEditModeHint"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            Text="「还原」= 放弃还没保存的改动，恢复成磁盘上的当前值。" />

                        <!-- 当前文件：封面（放大到 240，约旧版 4~5 倍）+ 标题 + 路径 -->
                        <Grid x:Name="QuickEditFileCard">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                Width="240"
                                Height="240"
                                CornerRadius="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <Image x:Name="QuickEditCover" Stretch="UniformToFill" />
                                    <FontIcon
                                        x:Name="QuickEditNoCoverIcon"
                                        Glyph="&#xE8B9;"
                                        FontSize="96"
                                        Opacity="0.35"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,8,0,0">
                                <TextBlock x:Name="QuickEditTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="QuickEditPath" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- 可编辑字段（阶段 6：保存前快照，失败整体还原） -->
                        <TextBox x:Name="QuickTitleBox" Header="标题" />
                        <TextBox x:Name="QuickArtistBox" Header="艺术家" />
                        <TextBox x:Name="QuickAlbumBox" Header="专辑" />
                        <TextBox x:Name="QuickAlbumArtistBox" Header="专辑艺术家" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QuickYearBox" Header="年份" Grid.Column="0" />
                            <TextBox x:Name="QuickTrackBox" Header="曲目号" Grid.Column="1" />
                        </Grid>
                        <TextBox x:Name="QuickGenreBox" Header="流派" />
                        <TextBox x:Name="QuickCommentBox" Header="注释" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                        <TextBox x:Name="QuickLyricsBox" Header="歌词" AcceptsReturn="True" TextWrapping="Wrap" Height="150" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 2：批量工具（阶段 7） ══════════
                     六个功能区 + 统一状态条。所有操作的共同安全底线：
                     改动前快照 → 逐个执行 → 任何一步失败就把已改的文件整体还原，
                     绝不留在半改状态。作用范围 = 右侧列表选中项；一个都没选 = 整个列表。 -->
                <ScrollViewer
                    x:Name="BatchToolsPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <!-- 作用范围提示 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10,8">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords"
                                Text="作用范围 = 右侧文件列表里选中的文件；一个都没选时作用于整个列表。每个工具执行前都会自动备份原标签，任何一步失败都会把已改的文件整体还原。" />
                        </Border>

                        <!-- ① 文件名 → 标签 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="① 文件名 → 标签" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="按「艺术家 - 标题」解析文件名（也认「标题 - 艺术家」）。默认只填当前为空的标题/艺术家，已有内容不动；勾选下面的框才会覆盖。" />
                                <CheckBox x:Name="BatchFileNameOverwriteCheck" Content="同时覆盖已有的标题/艺术家" />
                                <Button x:Name="BatchFileNameFillButton" Content="从文件名填充" HorizontalAlignment="Left" Click="BatchFileNameFillButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ② 标签 → 文件名（重命名） -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="② 标签 → 文件名（重命名）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="用标签重命名文件。目标文件名已被占用、或标题为空时，跳过该文件（不改）。扩展名保持原样。" />
                                <ComboBox x:Name="BatchRenamePatternCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="艺术家 - 标题" Tag="ArtistTitle" IsSelected="True" />
                                    <ComboBoxItem Content="曲目. 艺术家 - 标题" Tag="TrackArtistTitle" />
                                    <ComboBoxItem Content="标题" Tag="Title" />
                                </ComboBox>
                                <Button x:Name="BatchRenameButton" Content="重命名所选文件" HorizontalAlignment="Left" Click="BatchRenameButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ③ 文本替换 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="③ 文本替换" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="在选中文件的指定字段里查找并替换文字。勾选正则后按正则表达式匹配（替换串里可用 $1 引用捕获组）。" />
                                <ComboBox x:Name="BatchReplaceFieldCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="标题" Tag="Title" IsSelected="True" />
                                    <ComboBoxItem Content="艺术家" Tag="Artist" />
                                    <ComboBoxItem Content="专辑" Tag="Album" />
                                    <ComboBoxItem Content="专辑艺术家" Tag="AlbumArtist" />
                                    <ComboBoxItem Content="流派" Tag="Genre" />
                                    <ComboBoxItem Content="注释" Tag="Comment" />
                                </ComboBox>
                                <TextBox x:Name="BatchReplaceFindBox" Header="查找" PlaceholderText="要替换掉的文字" />
                                <TextBox x:Name="BatchReplaceWithBox" Header="替换为" PlaceholderText="留空 = 删除查到的文字" />
                                <CheckBox x:Name="BatchReplaceRegexCheck" Content="用正则表达式" />
                                <Button x:Name="BatchReplaceButton" Content="替换" HorizontalAlignment="Left" Click="BatchReplaceButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ④ 大小写 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="④ 大小写整理" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="把选中文件指定字段统一成一种大小写风格，治「全大写 / 全小写」的杂乱命名。" />
                                <ComboBox x:Name="BatchCaseFieldCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="标题" Tag="Title" IsSelected="True" />
                                    <ComboBoxItem Content="艺术家" Tag="Artist" />
                                    <ComboBoxItem Content="专辑" Tag="Album" />
                                    <ComboBoxItem Content="专辑艺术家" Tag="AlbumArtist" />
                                    <ComboBoxItem Content="流派" Tag="Genre" />
                                    <ComboBoxItem Content="注释" Tag="Comment" />
                                </ComboBox>
                                <ComboBox x:Name="BatchCaseModeCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="每词首字母大写（Hello World）" Tag="Title" IsSelected="True" />
                                    <ComboBoxItem Content="全大写（HELLO WORLD）" Tag="Upper" />
                                    <ComboBoxItem Content="全小写（hello world）" Tag="Lower" />
                                </ComboBox>
                                <Button x:Name="BatchCaseButton" Content="整理大小写" HorizontalAlignment="Left" Click="BatchCaseButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ⑤ 自动编号 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⑤ 自动编号（曲目号）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="按列表从上到下的顺序写曲目号：第一个文件 = 起始值，之后每个加一步长。文件格式里曲目号只能存纯数字，补零位数在这里不生效（存不进文件）。" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BatchNumberStartBox" Grid.Column="0" Header="起始值" Text="1" />
                                    <TextBox x:Name="BatchNumberStepBox" Grid.Column="1" Header="步长" Text="1" />
                                </Grid>
                                <Button x:Name="BatchNumberButton" Content="写入曲目号" HorizontalAlignment="Left" Click="BatchNumberButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ⑥ 移除标签 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⑥ 移除标签" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="清空文字标签 = 标题/艺术家/专辑/年份/曲目/流派/注释/歌词全部清空，内嵌封面保留。两个操作执行前都会备份，失败整体还原。" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BatchClearTagsButton" Content="清空文字标签（留封面）" Click="BatchClearTagsButton_Click" />
                                    <Button x:Name="BatchRemoveCoverButton" Content="移除内嵌封面" Click="BatchRemoveCoverButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 批量工具自己的状态条（右侧底部那条同时也在用） -->
                        <TextBlock
                            x:Name="BatchStatusText"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 3：排序编号（阶段 8 接入，占位） ══════════ -->
                <Grid x:Name="SortNumberPanel">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="300">
                        <FontIcon Glyph="&#xE8CB;" FontSize="36" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="排序编号"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="按多个字段依次排序，再把排好的结果写入曲目号（自动编号）或加入播放队列 / 播放列表。"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ══════════ 页 4：在线补全（后续阶段接入，占位） ══════════ -->
                <Grid x:Name="OnlineFillPanel">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="300">
                        <FontIcon Glyph="&#xE774;" FontSize="36" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="在线补全"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="从 MusicBrainz / iTunes / Cover Art Archive / LRClib 搜索并补全标签、封面与歌词；匹配结果先预览、确认后才写入。"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 右列：文件列表 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工具条 -->
            <Grid ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button CornerRadius="16" x:Name="AddFilesButton" Content="添加文件…" Click="AddFilesButton_Click" />
                <Button CornerRadius="16" x:Name="AddFolderButton" Grid.Column="1" Content="添加文件夹…" Click="AddFolderButton_Click" />
                <Button CornerRadius="16" x:Name="RemoveSelectedButton" Grid.Column="2" Content="移除所选" Click="RemoveSelectedButton_Click" />
                <Button CornerRadius="16" x:Name="ClearListButton" Grid.Column="3" Content="清空" Click="ClearListButton_Click" />
                <TextBlock
                    x:Name="FileCountText"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.65"
                    Text="0 个文件" />
            </Grid>

            <!-- 文件表格（2026-10-13 第四轮换 DataGrid）：列宽 / 列头 / 横向滚动 / 行选中
                 全部用原生能力，四轮反馈 bug 不断的自绘表头 + 拖拽把手整块删除。
                 列宽只在这一处定义（旧自绘表格要 XAML 表头 + 行模板 + cs 数组三处同步）。
                 单元格内边距沿用旧口径：左 10px、右 6px（全列文字右留 6px，不贴列
                 边界竖线——2026-10-13 用户实测反馈定稿）；列间竖线用原生网格线。
                 格内编辑 = mp3tag 口径：单击行选中整行，再击可编辑格进编辑，回车 /
                 点别处提交并立即写盘，Esc 放弃。可编辑列（标题/艺术家/专辑/年份/曲目/
                 流派）显示态 TextBlock、编辑态无边框 TextBox；编辑框 OneWay 绑定只负责
                 显示初值，落盘值在 CellEditEnding 里从编辑框直读（不依赖绑定回写时序，
                 Esc 取消也不会把半成品写进行模型）。末尾星号列吸收剩余宽度，真实列
                 永不被挤压。 -->
            <dg:DataGrid
                x:Name="TagFileGrid"
                Grid.Row="2"
                ItemsSource="{x:Bind _files, Mode=OneWay}"
                AutoGenerateColumns="False"
                SelectionMode="Extended"
                RowHeight="34"
                ColumnHeaderHeight="32"
                HeadersVisibility="Column"
                GridLinesVisibility="Vertical"
                VerticalGridLinesBrush="{StaticResource TagGridLineBrush}"
                HorizontalScrollBarVisibility="Auto"
                CanUserSortColumns="False"
                CanUserReorderColumns="False"
                CellStyle="{StaticResource TagGridCellStyle}"
                ColumnHeaderStyle="{StaticResource TagGridHeaderStyle}"
                SelectionChanged="TagFileGrid_SelectionChanged"
                CellEditEnding="TagFileGrid_CellEditEnding"
                CellEditEnded="TagFileGrid_CellEditEnded"
                LoadingRow="TagFileGrid_LoadingRow"
                UnloadingRow="TagFileGrid_UnloadingRow">
                <dg:DataGrid.Columns>
                    <!-- # 序号列（只读；行模型 INPC，Renumber 后可见行实时更新） -->
                    <dg:DataGridTemplateColumn Tag="Index" Header="#" Width="36" MinWidth="28">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind IndexLabel, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <!-- 可编辑列：显示态 TextBlock + 编辑态无边框 TextBox（回车 / 点别处提交即写盘） -->
                    <dg:DataGridTemplateColumn Tag="Title" Header="标题" Width="100" MinWidth="100">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Title, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Text="{x:Bind Title, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Artist" Header="艺术家" Width="130" MinWidth="60">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Artist, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Text="{x:Bind Artist, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Album" Header="专辑" Width="130" MinWidth="60">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Album, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Text="{x:Bind Album, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Year" Header="年份" Width="52" MinWidth="36">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind YearText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" TextAlignment="Right" Text="{x:Bind YearEdit, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Track" Header="曲目" Width="44" MinWidth="32">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind TrackText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" TextAlignment="Right" Text="{x:Bind TrackEdit, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Genre" Header="流派" Width="84" MinWidth="48">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Genre, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                        <dg:DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBox FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Text="{x:Bind Genre, Mode=OneWay}" GotFocus="TagCellEditBox_GotFocus" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellEditingTemplate>
                    </dg:DataGridTemplateColumn>

                    <!-- 只读列：时长 / 文件名 / 文件派生规格（右留 6px，不贴列边界竖线） -->
                    <dg:DataGridTemplateColumn Tag="Duration" Header="时长" Width="60" MinWidth="44">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind DurationText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="FileName" Header="文件名" Width="150" MinWidth="80">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind FileName, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Format" Header="格式" Width="64" MinWidth="44">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind FormatName, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="BitDepth" Header="位深" Width="52" MinWidth="36">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind BitDepthText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="SampleRate" Header="采样率" Width="76" MinWidth="48">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind SampleRateText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="Bitrate" Header="码率" Width="68" MinWidth="48">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind BitrateText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <dg:DataGridTemplateColumn Tag="FileSize" Header="大小" Width="76" MinWidth="48">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <TextBlock FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind FileSizeText, Mode=OneWay}" />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>

                    <!-- 末尾星号填充列：吸收视口剩余宽度，真实列永不被挤压（不可见、不可拖宽） -->
                    <dg:DataGridTemplateColumn Tag="Filler" Width="*" MinWidth="0" CanUserResize="False">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TagFileItem">
                                <Grid />
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <!-- 空列表提示（叠在表格上方，不挡操作） -->
            <TextBlock
                x:Name="TagListEmptyHint"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0.55"
                TextWrapping="WrapWholeWords"
                TextAlignment="Center"
                MaxWidth="320"
                Text="列表还是空的。点上方「添加文件…」或「添加文件夹…」把要整理标签的歌曲加进来。" />

            <!-- 底部状态条 -->
            <Border Grid.Row="3" Padding="0,8,0,0">
                <TextBlock
                    x:Name="TagStatusText"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="WrapWholeWords" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
