<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CelesteMusicPlayer.TagPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CelesteMusicPlayer"
    mc:Ignorable="d">

    <!-- 标签板块（2026-10-13 阶段 5a 骨架）：mp3tag 式「左标签面板 + 右文件列表」。
         左列：横向子导航（ShellPageHost 生成，4 页）+ 当前子页面板；
         右列：工具条 + 列表头 + 文件表格 + 状态条。
         快速编辑页：字段可编辑 + 保存 + 改动前快照整体回滚（阶段 6 落地）；
         批量工具 / 排序编号 / 在线补全分别在阶段 7 / 8 与后续在线阶段接入。
         取色铁律：ShellPageHost 的强调色由外部注入（构造函数传 DspAccentBrush），
         界面里其它颜色一律 ThemeResource，不自己读系统强调色。 -->

    <UserControl.Resources>
        <!-- 表格可编辑单元格（mp3tag 式两击编辑）：长得像文字，**第一次单击只选中行，
             第二次单击同一格才进编辑**。AllowFocusOnInteraction=False 让点击不自动
             聚焦，何时进编辑完全由代码决定（TagCellBox_PointerPressed 武装/放行）。
             无边框透明底；编辑长字段时 GotFocus 里临时开换行「展开」，失焦收回。 -->
        <Style x:Key="TagCellBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左列：子导航 + 子页面板 ==================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 横向子导航：4 个页签由 ShellPageHost 动态生成（占位容器，勿删） -->
            <StackPanel
                x:Name="TagSubNavPanel"
                Orientation="Horizontal"
                Spacing="2"
                Margin="0,0,0,6" />

            <!-- 子页面板容器：4 个面板全部常驻，显隐由 ShellPageHost 统一管 -->
            <Grid x:Name="TagSubPageHost" Grid.Row="1">

                <!-- ══════════ 页 1：快速编辑（可编辑 + 保存 + 快照回滚） ══════════ -->
                <ScrollViewer
                    x:Name="QuickEditPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10,8">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords"
                                Text="从右侧文件列表选中文件即可在这里编辑标签。也可以直接在右侧表格里单击单元格修改（回车或点别处即保存）。保存前会自动备份原标签，任何一步失败都会把已改的文件整体还原；多选时只填想改的字段，留空的不动。" />
                        </Border>

                        <!-- 保存 / 还原（2026-10-13 用户要求移到顶部：不用滚到最底就能保存） -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="QuickSaveButton" Grid.Column="0" Content="保存" Click="QuickSaveButton_Click" />
                            <Button x:Name="QuickRevertButton" Grid.Column="1" Content="还原" Click="QuickRevertButton_Click" />
                        </Grid>
                        <TextBlock
                            x:Name="QuickEditModeHint"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            Text="「还原」= 放弃还没保存的改动，恢复成磁盘上的当前值。" />

                        <!-- 当前文件：封面（放大到 240，约旧版 4~5 倍）+ 标题 + 路径 -->
                        <Grid x:Name="QuickEditFileCard">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                Width="240"
                                Height="240"
                                CornerRadius="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <Image x:Name="QuickEditCover" Stretch="UniformToFill" />
                                    <FontIcon
                                        x:Name="QuickEditNoCoverIcon"
                                        Glyph="&#xE8B9;"
                                        FontSize="96"
                                        Opacity="0.35"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,8,0,0">
                                <TextBlock x:Name="QuickEditTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="QuickEditPath" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- 可编辑字段（阶段 6：保存前快照，失败整体还原） -->
                        <TextBox x:Name="QuickTitleBox" Header="标题" />
                        <TextBox x:Name="QuickArtistBox" Header="艺术家" />
                        <TextBox x:Name="QuickAlbumBox" Header="专辑" />
                        <TextBox x:Name="QuickAlbumArtistBox" Header="专辑艺术家" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QuickYearBox" Header="年份" Grid.Column="0" />
                            <TextBox x:Name="QuickTrackBox" Header="曲目号" Grid.Column="1" />
                        </Grid>
                        <TextBox x:Name="QuickGenreBox" Header="流派" />
                        <TextBox x:Name="QuickCommentBox" Header="注释" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                        <TextBox x:Name="QuickLyricsBox" Header="歌词" AcceptsReturn="True" TextWrapping="Wrap" Height="150" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 2：批量工具（阶段 7） ══════════
                     六个功能区 + 统一状态条。所有操作的共同安全底线：
                     改动前快照 → 逐个执行 → 任何一步失败就把已改的文件整体还原，
                     绝不留在半改状态。作用范围 = 右侧列表选中项；一个都没选 = 整个列表。 -->
                <ScrollViewer
                    x:Name="BatchToolsPanel"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0">
                    <StackPanel Spacing="10">
                        <!-- 作用范围提示 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10,8">
                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords"
                                Text="作用范围 = 右侧文件列表里选中的文件；一个都没选时作用于整个列表。每个工具执行前都会自动备份原标签，任何一步失败都会把已改的文件整体还原。" />
                        </Border>

                        <!-- ① 文件名 → 标签 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="① 文件名 → 标签" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="按「艺术家 - 标题」解析文件名（也认「标题 - 艺术家」）。默认只填当前为空的标题/艺术家，已有内容不动；勾选下面的框才会覆盖。" />
                                <CheckBox x:Name="BatchFileNameOverwriteCheck" Content="同时覆盖已有的标题/艺术家" />
                                <Button x:Name="BatchFileNameFillButton" Content="从文件名填充" HorizontalAlignment="Left" Click="BatchFileNameFillButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ② 标签 → 文件名（重命名） -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="② 标签 → 文件名（重命名）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="用标签重命名文件。目标文件名已被占用、或标题为空时，跳过该文件（不改）。扩展名保持原样。" />
                                <ComboBox x:Name="BatchRenamePatternCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="艺术家 - 标题" Tag="ArtistTitle" IsSelected="True" />
                                    <ComboBoxItem Content="曲目. 艺术家 - 标题" Tag="TrackArtistTitle" />
                                    <ComboBoxItem Content="标题" Tag="Title" />
                                </ComboBox>
                                <Button x:Name="BatchRenameButton" Content="重命名所选文件" HorizontalAlignment="Left" Click="BatchRenameButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ③ 文本替换 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="③ 文本替换" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="在选中文件的指定字段里查找并替换文字。勾选正则后按正则表达式匹配（替换串里可用 $1 引用捕获组）。" />
                                <ComboBox x:Name="BatchReplaceFieldCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="标题" Tag="Title" IsSelected="True" />
                                    <ComboBoxItem Content="艺术家" Tag="Artist" />
                                    <ComboBoxItem Content="专辑" Tag="Album" />
                                    <ComboBoxItem Content="专辑艺术家" Tag="AlbumArtist" />
                                    <ComboBoxItem Content="流派" Tag="Genre" />
                                    <ComboBoxItem Content="注释" Tag="Comment" />
                                </ComboBox>
                                <TextBox x:Name="BatchReplaceFindBox" Header="查找" PlaceholderText="要替换掉的文字" />
                                <TextBox x:Name="BatchReplaceWithBox" Header="替换为" PlaceholderText="留空 = 删除查到的文字" />
                                <CheckBox x:Name="BatchReplaceRegexCheck" Content="用正则表达式" />
                                <Button x:Name="BatchReplaceButton" Content="替换" HorizontalAlignment="Left" Click="BatchReplaceButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ④ 大小写 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="④ 大小写整理" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="把选中文件指定字段统一成一种大小写风格，治「全大写 / 全小写」的杂乱命名。" />
                                <ComboBox x:Name="BatchCaseFieldCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="标题" Tag="Title" IsSelected="True" />
                                    <ComboBoxItem Content="艺术家" Tag="Artist" />
                                    <ComboBoxItem Content="专辑" Tag="Album" />
                                    <ComboBoxItem Content="专辑艺术家" Tag="AlbumArtist" />
                                    <ComboBoxItem Content="流派" Tag="Genre" />
                                    <ComboBoxItem Content="注释" Tag="Comment" />
                                </ComboBox>
                                <ComboBox x:Name="BatchCaseModeCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="每词首字母大写（Hello World）" Tag="Title" IsSelected="True" />
                                    <ComboBoxItem Content="全大写（HELLO WORLD）" Tag="Upper" />
                                    <ComboBoxItem Content="全小写（hello world）" Tag="Lower" />
                                </ComboBox>
                                <Button x:Name="BatchCaseButton" Content="整理大小写" HorizontalAlignment="Left" Click="BatchCaseButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ⑤ 自动编号 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⑤ 自动编号（曲目号）" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="按列表从上到下的顺序写曲目号：第一个文件 = 起始值，之后每个加一步长。文件格式里曲目号只能存纯数字，补零位数在这里不生效（存不进文件）。" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BatchNumberStartBox" Grid.Column="0" Header="起始值" Text="1" />
                                    <TextBox x:Name="BatchNumberStepBox" Grid.Column="1" Header="步长" Text="1" />
                                </Grid>
                                <Button x:Name="BatchNumberButton" Content="写入曲目号" HorizontalAlignment="Left" Click="BatchNumberButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- ⑥ 移除标签 -->
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⑥ 移除标签" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock
                                    FontSize="11"
                                    Opacity="0.6"
                                    TextWrapping="WrapWholeWords"
                                    Text="清空文字标签 = 标题/艺术家/专辑/年份/曲目/流派/注释/歌词全部清空，内嵌封面保留。两个操作执行前都会备份，失败整体还原。" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BatchClearTagsButton" Content="清空文字标签（留封面）" Click="BatchClearTagsButton_Click" />
                                    <Button x:Name="BatchRemoveCoverButton" Content="移除内嵌封面" Click="BatchRemoveCoverButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 批量工具自己的状态条（右侧底部那条同时也在用） -->
                        <TextBlock
                            x:Name="BatchStatusText"
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ══════════ 页 3：排序编号（阶段 8 接入，占位） ══════════ -->
                <Grid x:Name="SortNumberPanel">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="300">
                        <FontIcon Glyph="&#xE8CB;" FontSize="36" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="排序编号"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="按多个字段依次排序，再把排好的结果写入曲目号（自动编号）或加入播放队列 / 播放列表。"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ══════════ 页 4：在线补全（后续阶段接入，占位） ══════════ -->
                <Grid x:Name="OnlineFillPanel">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="300">
                        <FontIcon Glyph="&#xE774;" FontSize="36" Opacity="0.35" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="在线补全"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="从 MusicBrainz / iTunes / Cover Art Archive / LRClib 搜索并补全标签、封面与歌词；匹配结果先预览、确认后才写入。"
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="WrapWholeWords"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 右列：文件列表 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工具条 -->
            <Grid ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button CornerRadius="16" x:Name="AddFilesButton" Content="添加文件…" Click="AddFilesButton_Click" />
                <Button CornerRadius="16" x:Name="AddFolderButton" Grid.Column="1" Content="添加文件夹…" Click="AddFolderButton_Click" />
                <Button CornerRadius="16" x:Name="RemoveSelectedButton" Grid.Column="2" Content="移除所选" Click="RemoveSelectedButton_Click" />
                <Button CornerRadius="16" x:Name="ClearListButton" Grid.Column="3" Content="清空" Click="ClearListButton_Click" />
                <TextBlock
                    x:Name="FileCountText"
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.65"
                    Text="0 个文件" />
            </Grid>

            <!-- 列表头：列宽与行模板严格一致（默认值两边同步；运行期拖拽在代码里同步）。
                 外层 TagHeaderHost 负责裁剪：列太多内容宽于视口时，表头靠代码位移 +
                 Clip 跟随列表的横向滚动（表头在 ListView 外面，不会自己滚）。
                 15 列 = 14 个真实列（全部定宽）+ 末尾 1 个不可见星号填充列：
                 星号列吸收视口剩余宽度，真实列永不被挤压 → 拖任一边界都是
                 「线右侧一起动、左侧不动」，不会出现被星号列吞掉宽度的怪事。 -->
            <Grid x:Name="TagHeaderHost" Grid.Row="1" Margin="0,0,0,4">
                <Grid x:Name="TagListHeaderGrid" Padding="10,0" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>
                    <!-- 每列文字右留 6px：不贴列边界竖线（2026-10-13 用户实测反馈，
                         此前只给末列加 10px 是误读，已回退为全列统一 6px） -->
                    <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="#" />
                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="标题" />
                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="艺术家" />
                    <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="专辑" />
                    <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="年份" />
                    <TextBlock Grid.Column="5" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="曲目" />
                    <TextBlock Grid.Column="6" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="流派" />
                    <TextBlock Grid.Column="7" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="时长" />
                    <TextBlock Grid.Column="8" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="文件名" />
                    <TextBlock Grid.Column="9" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="格式" />
                    <TextBlock Grid.Column="10" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="位深" />
                    <TextBlock Grid.Column="11" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="采样率" />
                    <TextBlock Grid.Column="12" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" Text="码率" />
                    <TextBlock Grid.Column="13" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" TextAlignment="Right" Text="大小" />
                </Grid>
            </Grid>

            <!-- 文件表格（多选；虚拟化由 ItemsStackPanel 默认行为保留，勿外包 ScrollViewer）。
                 列太多时内容宽于视口 → 横向滚动条出现在列表底部，表头由代码同步位移；
                 列边界可拖拽调宽：表头每根列边界有 1px 可见竖线 + 悬停高亮把手，
                 行内同样画淡竖线，拖拽时「线右侧一起动、左侧不动」。
                 可编辑列（标题/艺术家/专辑/年份/曲目/流派）是常驻文本框：mp3tag 式
                 两击编辑（首击选中行、再击同一格进编辑），回车或点别处提交并写盘；
                 长字段编辑时自动换行展开。
                 不可编辑列（#/时长/文件名/格式/位深/采样率/码率/大小）保持只读文字。 -->
            <ListView
                x:Name="TagFileListView"
                Grid.Row="2"
                SelectionMode="Extended"
                SelectionChanged="TagFileListView_SelectionChanged"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TagFileItem">
                        <Grid Padding="10,0" ColumnSpacing="8" VerticalAlignment="Center" MinWidth="1254" Loaded="TagFileRow_Loaded">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <!-- 序号列：OneWay + 行模型 INPC，Renumber 后可见行实时更新（旧实现 OneTime，序号永远停在 0） -->
                            <TextBlock Grid.Column="0" FontSize="12" Opacity="0.6" Margin="0,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind IndexLabel, Mode=OneWay}" />
                            <!-- 可编辑列：mp3tag 式两击编辑——第一次单击只选中行，第二次单击同一格才进编辑
                                 （AllowFocusOnInteraction=False + TagCellBox_PointerPressed 武装/放行）；
                                 回车或点别处提交并写盘；长字段编辑时自动换行展开 -->
                            <TextBox Grid.Column="1" Style="{StaticResource TagCellBox}" FontSize="13" Opacity="1" Margin="0,0,6,0" Text="{x:Bind Title}" PointerPressed="TagCellBox_PointerPressed" GotFocus="TagCellBox_GotFocus" LostFocus="TagCellBox_LostFocus" KeyDown="TagCellBox_KeyDown" />
                            <TextBox Grid.Column="2" Style="{StaticResource TagCellBox}" Margin="0,0,6,0" Text="{x:Bind Artist}" PointerPressed="TagCellBox_PointerPressed" GotFocus="TagCellBox_GotFocus" LostFocus="TagCellBox_LostFocus" KeyDown="TagCellBox_KeyDown" />
                            <TextBox Grid.Column="3" Style="{StaticResource TagCellBox}" Margin="0,0,6,0" Text="{x:Bind Album}" PointerPressed="TagCellBox_PointerPressed" GotFocus="TagCellBox_GotFocus" LostFocus="TagCellBox_LostFocus" KeyDown="TagCellBox_KeyDown" />
                            <TextBox Grid.Column="4" Style="{StaticResource TagCellBox}" Margin="0,0,6,0" TextAlignment="Right" Text="{x:Bind YearText}" PointerPressed="TagCellBox_PointerPressed" GotFocus="TagCellBox_GotFocus" LostFocus="TagCellBox_LostFocus" KeyDown="TagCellBox_KeyDown" />
                            <TextBox Grid.Column="5" Style="{StaticResource TagCellBox}" Margin="0,0,6,0" TextAlignment="Right" Text="{x:Bind TrackText}" PointerPressed="TagCellBox_PointerPressed" GotFocus="TagCellBox_GotFocus" LostFocus="TagCellBox_LostFocus" KeyDown="TagCellBox_KeyDown" />
                            <TextBox Grid.Column="6" Style="{StaticResource TagCellBox}" Margin="0,0,6,0" Text="{x:Bind Genre}" PointerPressed="TagCellBox_PointerPressed" GotFocus="TagCellBox_GotFocus" LostFocus="TagCellBox_LostFocus" KeyDown="TagCellBox_KeyDown" />
                            <!-- 只读列：时长 / 文件名 / 文件派生规格（右留 6px，不贴列边界竖线） -->
                            <TextBlock Grid.Column="7" FontSize="12" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind DurationText}" />
                            <TextBlock Grid.Column="8" FontSize="12" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind FileName}" />
                            <TextBlock Grid.Column="9" FontSize="12" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind FormatName}" />
                            <TextBlock Grid.Column="10" FontSize="12" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind BitDepthText}" />
                            <TextBlock Grid.Column="11" FontSize="12" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind SampleRateText}" />
                            <TextBlock Grid.Column="12" FontSize="12" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind BitrateText}" />
                            <TextBlock Grid.Column="13" FontSize="12" Opacity="0.75" Margin="0,0,6,0" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{x:Bind FileSizeText}" />
                            <!-- 列间竖线：贴在每列右边界（与表头把手同一根线），不挡命中测试 -->
                            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="4" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="6" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="7" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="8" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="9" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="10" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="11" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="12" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Rectangle Grid.Column="13" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="0.25" IsHitTestVisible="False" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空列表提示（叠在表格上方，不挡操作） -->
            <TextBlock
                x:Name="TagListEmptyHint"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0.55"
                TextWrapping="WrapWholeWords"
                TextAlignment="Center"
                MaxWidth="320"
                Text="列表还是空的。点上方「添加文件…」或「添加文件夹…」把要整理标签的歌曲加进来。" />

            <!-- 底部状态条 -->
            <Border Grid.Row="3" Padding="0,8,0,0">
                <TextBlock
                    x:Name="TagStatusText"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="WrapWholeWords" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
