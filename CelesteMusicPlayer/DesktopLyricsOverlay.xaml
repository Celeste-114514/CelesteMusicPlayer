<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.DesktopLyricsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        桌面歌词 —— 主流桌面歌词软件风格（MusicPlayer2 思路 + 网易云 / QQ / Spotify 视觉）
            - 屏幕顶部居中的半透深色圆角卡，整窗漂浮
            - 当前行：32pt SemiBold + 未唱白半透 + 已唱主题色蓝（卡拉 OK 从左往右揭示）
            - 下一行：16pt 白半透（提示，可关）
            - 当前行文本超过容器宽度时，按卡拉 OK 进度做横向滚动
              （MusicPlayer2 精髓：让"唱到哪"的分割点保持容器中点，保证视觉重心稳定）
            - 顶部居中横排小圆按钮：双行切换 / 卡拉 OK 切换 / 锁定 / 关闭
              锁定后整窗鼠标穿透，工具栏收起，露单"开锁"按钮
            - 双击歌词 = 切换锁定；右键 = 锁定时解锁
            - 字体：思源/微软雅黑 UI 系（自动回落），无衬线大字
    -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerCaptureLost="RootGrid_PointerCaptureLost"
          DoubleTapped="RootGrid_DoubleTapped"
          RightTapped="RootGrid_RightTapped">

        <!-- 歌词卡：顶部居中 -->
        <Border x:Name="LyricsCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,48,0,0"
                CornerRadius="14"
                Background="#B3000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1">
            <StackPanel x:Name="LinesRoot" Margin="26,16" Spacing="8">
                <!-- 当前行：固定宽度的可视区 + 自由宽度的承载 Grid + RenderTransform 平移实现横向滚动 -->
                <Grid x:Name="CurrentLineClip"
                      Width="660"
                      Height="48"
                      HorizontalAlignment="Center"
                      SizeChanged="CurrentLineClip_SizeChanged">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="CurrentLineClipGeometry" Rect="0,0,660,48"/>
                    </Grid.Clip>
                    <Grid x:Name="CurrentLineHost" HorizontalAlignment="Center" SizeChanged="CurrentLineHost_SizeChanged">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="CurrentLineTranslate"/>
                        </Grid.RenderTransform>
                        <!-- 底层：未唱 = 白色半透 -->
                        <TextBlock x:Name="CurrentLineUnsungText"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="#B3FFFFFF"
                                   HorizontalAlignment="Left"
                                   TextAlignment="Left"
                                   TextWrapping="NoWrap"
                                   Text=""/>
                        <!-- 顶层：已唱 = 主题色，被 Clip 矩形裁到 splitX -->
                        <TextBlock x:Name="CurrentLineSungText"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="#4FA8F5"
                                   HorizontalAlignment="Left"
                                   TextAlignment="Left"
                                   TextWrapping="NoWrap"
                                   Text=""/>
                    </Grid>
                </Grid>

                <!-- 下一行（提示），与当前行中心线对齐 -->
                <TextBlock x:Name="NextLineText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="16"
                           Foreground="#80FFFFFF"
                           TextWrapping="NoWrap"
                           Text=""/>
            </StackPanel>
        </Border>

        <!-- 工具栏：歌词卡顶部上方居中横排小圆按钮（常驻显示） -->
        <Border x:Name="Toolbar"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Padding="6,4"
                CornerRadius="14"
                Background="#D6000000"
                BorderBrush="#28FFFFFF"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="DoubleLineToggleButton"
                        Click="DoubleLineToggleButton_Click"
                        Width="26" Height="26"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="双行 / 单行切换">
                    <FontIcon x:Name="DoubleLineToggleIcon"
                              FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE75C;"
                              FontSize="13"
                              Foreground="#CCFFFFFF"/>
                </Button>
                <Button x:Name="KaraokeToggleButton"
                        Click="KaraokeToggleButton_Click"
                        Width="26" Height="26"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="卡拉 OK 效果开 / 关">
                    <FontIcon x:Name="KaraokeToggleIcon"
                              FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE7C3;"
                              FontSize="13"
                              Foreground="#4FA8F5"/>
                </Button>
                <Button x:Name="LockToggleButton"
                        Click="LockToggleButton_Click"
                        Width="26" Height="26"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="锁定 / 解锁（双击歌词也能切换）">
                    <FontIcon x:Name="LockToggleIcon"
                              FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE785;"
                              FontSize="13"
                              Foreground="#CCFFFFFF"/>
                </Button>
                <Button x:Name="CloseButton"
                        Click="CloseButton_Click"
                        Width="26" Height="26"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="关闭桌面歌词">
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE711;"
                              FontSize="13"
                              Foreground="#CCFFFFFF"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- 锁定态专属：单按钮"开锁" -->
        <Button x:Name="LockedUnlockButton"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Click="LockedUnlockButton_Click"
                Visibility="Collapsed"
                Width="26" Height="26"
                Padding="0"
                Background="#D6000000"
                BorderBrush="#28FFFFFF"
                BorderThickness="1"
                CornerRadius="13"
                ToolTipService.ToolTip="解锁（右键歌词也能解锁）">
            <FontIcon FontFamily="Segoe Fluent Icons"
                      Glyph="&#xE72E;"
                      FontSize="13"
                      Foreground="#CCFFFFFF"/>
        </Button>
    </Grid>
</Window>
