<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CelesteMusicPlayer.DesktopLyricsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        桌面歌词（WinUI3 窗口版）。
        视觉参考 deskbox / Spotify floating widget / Apple Music 桌面歌词：
        - 整窗铺 Desktop Acrylic backdrop（半透模糊），看上去是悬在桌面上
        - 中央一个半透黑圆角"歌词卡"装文字 —— 跨深浅壁纸都看得清
        - 工具栏也是歌词卡一部分，不用额外画
    -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerPressed="RootGrid_PointerPressed"
          PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased"
          PointerCaptureLost="RootGrid_PointerCaptureLost"
          DoubleTapped="RootGrid_DoubleTapped"
          RightTapped="RootGrid_RightTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 中央歌词卡：半透黑圆角矩形。文字+工具栏全装在这里 -->
        <Border x:Name="LyricsCard"
                Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="20"
                Background="#A6000000"
                BorderThickness="1"
                BorderBrush="#3FFFFFFF"
                Padding="28,14,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- 上一行 -->
                    <RowDefinition Height="Auto" />   <!-- 当前行 -->
                    <RowDefinition Height="Auto" />   <!-- 下一行 -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />  <!-- 工具栏 -->
                </Grid.ColumnDefinitions>

                <!-- 上一行（双行模式显示） -->
                <TextBlock x:Name="PrevLineText"
                           Grid.Row="0" Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Text=""
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#CCFFFFFF"
                           FontSize="20"
                           MaxWidth="780"
                           Margin="0,0,0,4" />

                <!-- 当前行：高亮 + 字号放大 -->
                <TextBlock x:Name="CurrentLineText"
                           Grid.Row="1" Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text=""
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#FFFFFFFF"
                           FontSize="34"
                           FontWeight="SemiBold"
                           MaxWidth="880"
                           Margin="0,2" />

                <!-- 下一行（双行模式显示） -->
                <TextBlock x:Name="NextLineText"
                           Grid.Row="2" Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Text=""
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#CCFFFFFF"
                           FontSize="20"
                           MaxWidth="780"
                           Margin="0,4,0,0" />

                <!-- 工具栏：锁 / 关。垂直对齐到当前行；半透按钮 -->
                <StackPanel x:Name="TopBar"
                            Grid.Row="1" Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="14,0,0,0">
                    <Button x:Name="LockToggleButton"
                            Click="LockToggleButton_Click"
                            Width="34" Height="34"
                            Padding="0"
                            Background="#66000000"
                            BorderBrush="#3FFFFFFF"
                            BorderThickness="1"
                            CornerRadius="17"
                            ToolTipService.ToolTip="锁定 / 解锁">
                        <FontIcon x:Name="LockToggleIcon"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE785;"
                                  FontSize="16"
                                  Foreground="White" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Width="34" Height="34"
                            Padding="0"
                            Background="#66000000"
                            BorderBrush="#3FFFFFFF"
                            BorderThickness="1"
                            CornerRadius="17"
                            ToolTipService.ToolTip="关闭桌面歌词">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE711;"
                                  FontSize="14"
                                  Foreground="White" />
                    </Button>
                </StackPanel>

                <!-- 锁定态专用：右上角一个小小的"开锁"按钮（歌词卡还是可见） -->
                <Button x:Name="LockedUnlockButton"
                        Grid.Row="1" Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="LockedUnlockButton_Click"
                        Visibility="Collapsed"
                        Width="34" Height="34"
                        Padding="0"
                        Margin="14,0,0,0"
                        Background="#66000000"
                        BorderBrush="#3FFFFFFF"
                        BorderThickness="1"
                        CornerRadius="17"
                        ToolTipService.ToolTip="解锁">
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE72E;"
                              FontSize="16"
                              Foreground="White" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
