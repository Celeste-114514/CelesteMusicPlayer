<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CelesteTokenSelfTest</RootNamespace>
    <AssemblyName>CelesteTokenSelfTest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只链接令牌那一个文件。它不依赖 WinUI，可在纯 net9.0 下跑。 -->
    <Compile Include="..\..\CelesteMusicPlayer\CelesteTheme.cs" Link="CelesteTheme.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
  </ItemGroup>
</Project>
