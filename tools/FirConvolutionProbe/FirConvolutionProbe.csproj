<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RollForward>Major</RollForward>
    <AssemblyName>FirConvolutionProbe</AssemblyName>
    <RootNamespace>FirConvolutionProbe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- x86 的 float/double 混用要 unsafe 指针给内核传 buffer -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CelesteMusicPlayer">
      <HintPath>..\..\CelesteMusicPlayer\bin\x64\Release\net10.0-windows10.0.19041.0\win-x64\CelesteMusicPlayer.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CopyRuntimeDeps" AfterTargets="Build">
    <ItemGroup>
      <_Dep Include="..\..\CelesteMusicPlayer\bin\x64\Release\net10.0-windows10.0.19041.0\win-x64\Microsoft.WindowsAppRuntime.*" />
      <_Dep Include="..\..\CelesteMusicPlayer\bin\x64\Release\net10.0-windows10.0.19041.0\win-x64\Microsoft.Windows.SDK.NET.dll" />
      <_Dep Include="..\..\CelesteMusicPlayer\bin\x64\Release\net10.0-windows10.0.19041.0\win-x64\e_sqlite3.dll" />
      <_Dep Include="..\..\CelesteMusicPlayer\bin\x64\Release\net10.0-windows10.0.19041.0\win-x64\System.Security.Cryptography.ProtectedData.dll" />
      <_Dep Include="..\..\CelesteMusicPlayer\bin\x64\Release\net10.0-windows10.0.19041.0\win-x64\celeste_dsp_core.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_Dep)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
