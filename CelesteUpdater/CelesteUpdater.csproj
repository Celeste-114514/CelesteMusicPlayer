<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe 而非 Exe：更新助手在后台静默运行，不弹控制台窗口 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CelesteUpdater</AssemblyName>
    <RootNamespace>CelesteUpdater</RootNamespace>
    <AssemblyVersion>26.9.19.1</AssemblyVersion>
    <FileVersion>26.9.19.1</FileVersion>
    <!-- 纯进程/文件操作，不需要 WinUI / XAML，构建轻量、稳定 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <!-- 主程序以 CelesteSelfContainedDistribute=true 自包含发布时，本工程必须同步自包含，
       否则自包含主程序引用框架依赖的 WinExe 会报 NETSDK1150、整个自包含构建失败。
       该属性由命令行全局传入，ProjectReference 构建时会传播到本工程。 -->
  <PropertyGroup Condition="'$(CelesteSelfContainedDistribute)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
</Project>
